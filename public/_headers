# 정적 자산의 브라우저 캐시.
#
# ── 왜 이 파일이 필요한가 ──────────────────────────────────
# Workers static assets 의 기본 응답 헤더는
# `Cache-Control: public, max-age=0, must-revalidate` 입니다. 그래서 Vite 가
# **내용해시를 붙여 둔** 파일들까지 브라우저 캐시에서 곧바로 쓰이지 못하고,
# 페이지를 옮길 때마다 조건부 요청을 한 번씩 더 보냅니다. 이 사이트는 MPA 라
# 그 왕복이 이동할 때마다 쌓입니다.
#
# ── 여기 적은 경로만 걸립니다 ──────────────────────────────
# 커스텀 헤더는 **Worker 가 만든 응답에는 적용되지 않습니다.** 이 사이트는
# `wrangler.jsonc` 의 `run_worker_first` 가 `/*` 를 잡고 아래 목록만 빼 두었는데,
# 그 목록이 정확히 여기 적은 것들입니다:
#
#   !/_astro/*  !/fonts/*  !/brand/*  !/og/*  !/product/*  !/favicon.ico
#
# 즉 HTML 은 Worker 를 지나므로 지금 정책(`max-age=0` + ETag)이 그대로 남고,
# 손대는 범위가 저절로 이 목록으로 한정됩니다. 그 둘이 어긋나면 여기 규칙이
# 조용히 아무 데도 안 걸리게 되므로, `run_worker_first` 를 고칠 때 이 파일도
# 함께 보세요.
#
# ── 영구 캐시는 이름에 해시가 있는 것에만 ─────────────────
# 나머지는 이름이 고정돼 있어 배포하면 **같은 주소의 내용이 바뀝니다.**
# 거기에 `immutable` 을 걸면 바뀐 파일이 사람에게 영영 안 갑니다.

# 파일 이름에 내용해시가 들어갑니다(`style.DKIokdll.css`). 내용이 바뀌면
# 주소가 바뀌므로 영구 캐시가 안전합니다. JS·CSS·최적화된 이미지 변형이
# 전부 여기 있어 얻는 것이 가장 큽니다.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 글꼴은 해시가 없고, 사이트 문안이 바뀔 때마다 서브셋이 다시 만들어집니다.
# 오래 잡아 두면 새 글자가 빠진 옛 파일을 계속 쓰게 되고, 그게 정확히
# `1c2a1fe` 가 고쳤던 "푸터가 다른 서체로 떨어지는" 증상입니다.
# 한 시간이면 한 번 방문 안의 이동은 전부 덮으면서 배포 뒤 어긋남은 짧습니다.
/fonts/*
  Cache-Control: public, max-age=3600

# 로고·파비콘·제품 썸네일. 거의 바뀌지 않고, 조금 낡아도 해가 없습니다.
/brand/*
  Cache-Control: public, max-age=86400
/product/*
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400

# 공유 그림은 빌드마다 다시 만들어집니다. 이것을 받아 가는 것은 사람이
# 아니라 대체로 크롤러·메신저 미리보기라, 하루면 충분합니다.
/og/*
  Cache-Control: public, max-age=86400
