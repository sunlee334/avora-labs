# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_KAKAO_CHANNEL_URL=https://pf.kakao.com/
# 광고 픽셀/웹 분석 ID (판매 개시 전 설치, 사업기획서 7-5). 비워두면 미설치.
NEXT_PUBLIC_ANALYTICS_ID=

# ---- Auth ----
# 주문 소유 토큰 서명용 시크릿(16자 이상). 운영에서는 반드시 무작위 값으로 교체.
AUTH_SECRET=dev-only-paros-auth-secret-0123456789

# ---- Database (libsql) ----
# 로컬: file: 경로. 운영: Turso URL(libsql://...) + 토큰
DATABASE_URL=file:./data/paros.db
DATABASE_AUTH_TOKEN=

# ---- Toss Payments (결제위젯 v2) ----
# 아래는 토스페이먼츠 개발자 문서에 공개된 테스트 키. 실제 계약 후 상점 키로 교체.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# ---- Ops alerts ----
# 결제·재고 이상, cron 실패 등 사람이 봐야 하는 알림을 보낼 Slack/Discord 호환 웹훅 URL ({"text": ...} POST).
# 비워두면 로그(JSON 한 줄, level=alert)만 남는다. 운영: `wrangler secret put OPS_ALERT_WEBHOOK_URL --env production`
OPS_ALERT_WEBHOOK_URL=

# ---- Cron ----
# worker.ts 의 scheduled 핸들러가 /api/internal/cron 을 부를 때 쓰는 Bearer 시크릿 (필수).
# 운영: `wrangler secret put CRON_SECRET --env production`. 없으면 cron 의 토스 대사 작업이 돌지 않는다.
CRON_SECRET=change-me-random-32-chars

# ---- Uploads (리뷰 사진) ----
UPLOAD_DIR=./data/uploads

# ---- Admin seed (pnpm db:seed 시 생성) ----
# 12자 이상 필수. 값이 없으면 시드가 관리자 계정을 만들지 않고 실패한다 (알려진 기본 비밀번호 금지).
ADMIN_EMAIL=admin@avoralabs.co
ADMIN_PASSWORD=change-me-before-launch-2026
