{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avora-labs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",

  // 정식 주소는 avoralabs.co 하나입니다.
  //
  // www 도 여기 함께 적는 이유: 적지 않으면 www 는 아예 응답하지 않습니다.
  // 붙여만 두고, 실제 301 은 Cloudflare 대시보드의 Redirect Rule 이 합니다
  // (Rules → Redirect Rules). 그 규칙은 요청 처리 순서상 Worker 보다 **먼저**
  // 돌기 때문에, 정적 파일 요청까지 빠짐없이 apex 로 넘겨 줍니다.
  // Worker 안에서 처리하면 안 됩니다 — /ko/ 같은 정적 경로는 run_worker_first
  // 목록에 없어서 Worker 가 호출조차 되지 않기 때문입니다.
  "routes": [
    { "pattern": "avoralabs.co", "custom_domain": true },
    { "pattern": "www.avoralabs.co", "custom_domain": true }
  ],

  // workers.dev 주소를 끕니다.
  // 같은 내용을 두 주소가 서빙하면 검색엔진이 색인을 나눠 갖고, canonical 이
  // 가리키지 않는 쪽이 먼저 잡히기도 합니다.
  "workers_dev": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /api/* 와 /admin* 만 Worker 가 먼저 받습니다.
    // 나머지 경로는 정적 에셋이 우선이라 Worker 가 호출되지 않고(= 과금되지 않고),
    // 매칭되는 파일이 없을 때만 Worker 로 넘어옵니다.
    //
    // /admin 이 여기 있는 이유: 관리 화면도 정적 파일이라 이 목록에 없으면
    // Cloudflare 가 Worker 를 거치지 않고 그냥 내보냅니다. 그러면 인증 코드가
    // 아예 실행되지 않습니다.
    // 페이지 경로는 전부 Worker 가 먼저 받습니다. www → apex 301 을 Worker 가
    // 처리해야 하기 때문입니다(원래는 Cloudflare Redirect Rule 이 할 일).
    //
    // 해시가 붙은 정적 자산은 제외합니다. 사람이 그 주소로 **이동하지 않으므로**
    // www 로 들어올 일이 없고, 제외해야 이미지·글꼴·CSS 요청이 Worker 를 거치지
    // 않아 예전과 같은 비용·지연으로 나갑니다.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/fonts/*",
      "!/brand/*",
      "!/og/*",
      "!/product/*",
      "!/favicon.ico"
    ],
    "not_found_handling": "none"
  },

  // 관리 화면 인증. Cloudflare Access 가 사람을 확인하고, Worker 가 그 서명을
  // 한 번 더 검증합니다(worker/admin.ts).
  //
  // 둘 다 비밀값이 아닙니다 — 팀 도메인은 로그인 페이지 주소이고, AUD 는
  // 애플리케이션 식별자입니다. 그래서 저장소에 그대로 둡니다.
  // 반대로 둘 중 하나라도 비면 관리 화면은 열린 채가 아니라 **잠깁니다.**
  //
  // ⚠️ 팀 이름을 바꾸면 여기도 함께 바꿔야 합니다. Worker 가 이 값을 JWT 의
  //    issuer 로 검증하므로, 어긋나면 로그인에 성공해도 통과하지 못합니다.
  //
  // ⚠️ Access 애플리케이션의 Destinations 에 `/admin` 과 `/api/admin` 이
  //    **둘 다** 있어야 합니다. Cloudflare 는 Access 가 덮는 경로에만
  //    Cf-Access-Jwt-Assertion 헤더를 붙이므로, 하나만 걸면 로그인은 되는데
  //    화면이 부르는 API 가 전부 401 이 됩니다.
  "vars": {
    // 구글 로그인. Client ID 는 공개값입니다 — OAuth 진행 중 브라우저 주소창에
    // 그대로 나타납니다. 짝이 되는 GOOGLE_CLIENT_SECRET 은 `wrangler secret put`
    // 으로만 넣습니다. 둘 중 하나라도 없으면 구글 버튼이 나오지 않습니다.
    "GOOGLE_CLIENT_ID": "1074249602401-u9s1hgmhknqa2ireu8u682t7mpkgvah0.apps.googleusercontent.com",

    // 카카오 로그인. REST API 키도 공개값입니다 — 인가 요청의 client_id 로
    // 브라우저 주소창에 그대로 나타납니다.
    // Client Secret 을 콘솔에서 "사용함" 으로 켜면 KAKAO_CLIENT_SECRET 을
    // `wrangler secret put` 으로 반드시 함께 넣어야 합니다. 콘솔에서만 켜고
    // 값을 넣지 않으면 토큰 발급이 전부 실패합니다.
    "KAKAO_REST_API_KEY": "471993744ef641f96c59d7f70db37a97",

    "ACCESS_TEAM_DOMAIN": "https://avoralabs.cloudflareaccess.com",
    "ACCESS_POLICY_AUD": "ccfcc41b65327c106b50761011b64b90000cf6b5862c7674fda16ece0b353b1f",

    // 관리 화면에 들어올 수 있는 사람. 쉼표로 구분합니다.
    //
    // Access 정책(대시보드)이 1차 문이고 이것이 2차 문입니다. 정책은 저장소
    // 밖에 있어 누가 넓혀도 diff 에 남지 않지만, 이 줄은 남습니다.
    // 비우면 아무도 못 들어옵니다 — 전부 허용이 아니라 전부 차단입니다.
    //
    // 사람이 늘면 여기에 이메일을 추가하고 배포하세요. 대시보드 정책도
    // 함께 넓혀야 합니다 — 둘 다 통과해야 들어옵니다.
    "ADMIN_ALLOWED_EMAILS": "sunlee334@gmail.com,hello.avoralabs@gmail.com,soohong10@gmail.com",

    // 에러 추적. DSN 은 **설계상 공개값** 입니다 — 브라우저 번들에 그대로
    // 실려 나가므로 숨길 방법이 없고, 숨겨야 하는 값도 아닙니다. 이걸 안다고
    // 남의 이벤트를 읽을 수는 없습니다(읽는 쪽은 계정 인증입니다).
    //
    // 비우면 전송을 통째로 건너뜁니다. 로컬과 테스트에서 이벤트가 쌓이지
    // 않게 하는 스위치이기도 합니다.
    "SENTRY_DSN": "https://4cad7b354a2d66d13cacd6c496489185@o4512008388935680.ingest.us.sentry.io/4512008410562560",
    "SENTRY_ENVIRONMENT": "production"
  },

  "observability": {
    "enabled": true
  },

  // 어느 배포에서 터졌는지 알기 위해서입니다. Sentry 의 release 로 들어가,
  // "어제 배포부터 늘었다" 를 볼 수 있게 합니다.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  // 주문 저장소. 배송지·연락처가 여기 들어가므로 개인정보 보관 정책이 필요합니다.
  // 최초 1회: wrangler d1 create avora-orders  → 나온 database_id 를 아래에 넣고
  //           wrangler d1 migrations apply avora-orders --remote
  /*
   * 공개 쓰기 엔드포인트의 속도 제한.
   *
   * 로그인 없이 행을 만들 수 있는 자리가 넷입니다 — 주문·후기·문의·출시 알림.
   * 그중 출시 알림이 가장 아픕니다: 그 명단의 값어치는 "진짜 사람" 하나이고,
   * 그 숫자가 펀딩 초반 달성률을 좌우합니다. 아무 방어가 없을 때 로컬에서
   * 초당 245건이 들어갔습니다.
   *
   * period 는 10 또는 60 만 됩니다. colo 단위로 세고 최종 일관성이라 정확한
   * 회계가 아니라 **홍수를 막는 문턱** 입니다 — 그 용도에는 충분합니다.
   */
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avora-orders",
      "database_id": "1c29eb05-7776-4b48-a1e1-b07113ab4325",
      "migrations_dir": "migrations"
    }
  ]

  // 관리 화면을 열 때 추가할 것 (Cloudflare Zero Trust → Access → Applications):
  //   vars: { "ACCESS_TEAM_DOMAIN": "https://<팀이름>.cloudflareaccess.com",
  //           "ACCESS_POLICY_AUD": "<애플리케이션 Audience 태그>" }
  // 둘 중 하나라도 없으면 관리 화면은 잠긴 채로 있습니다(열린 채가 아니라).
  //
  // 새 주문 알림을 켤 때 (둘 다 선택, 설정한 채널로만 나갑니다):
  //   웹훅 — Slack/Discord 에서 Incoming Webhook URL 을 만들고
  //     npx wrangler secret put NOTIFY_WEBHOOK_URL
  //     URL 자체가 발송 권한이라 vars 가 아니라 secret 으로 넣습니다.
  //   이메일 — Cloudflare Email Routing 이 필요하며 도메인이 먼저 있어야 합니다.
  //     보내는 주소는 등록된 도메인, 받는 주소는 인증된 주소여야 합니다.
  //     "send_email": [{ "name": "SEND_EMAIL", "destination_address": "<받는주소>" }]
  //     vars: { "NOTIFY_EMAIL_FROM": "orders@<도메인>", "NOTIFY_EMAIL_TO": "<받는주소>" }
  //     ⚠ 도메인 등록 전에 바인딩을 걸면 배포가 깨지므로 주석으로 둡니다.
  //
  // 결제를 켤 때 추가할 것:
  //   wrangler secret put TOSS_SECRET_KEY
  //   vars: { "PAYMENT_PROVIDER": "tosspayments" }
  // 시크릿은 이 파일에 적지 마세요. wrangler secret 으로만 넣습니다.
}
