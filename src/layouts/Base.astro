---
/**
 * 모든 페이지의 껍데기. SEO·hreflang·구조화 데이터가 전부 여기를 지납니다.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {
  ORIGIN,
  LOCALE_TAGS,
  DEFAULT_LOCALE,
  BUSINESS,
  WEB_ANALYTICS_TOKEN,
  SITE_VERIFICATION,
  type Locale,
} from '../config/site';
import { dict, alternates, localePath } from '../i18n';
// 모바일 브라우저의 주소창 색입니다. 브랜드 색이므로 토큰에서 읽습니다 —
// 여기 값을 베껴 적으면 팔레트가 바뀔 때 이 한 줄만 옛 색으로 남습니다.
import tokens from '../../tokens/design-tokens.json';

interface Props {
  locale: Locale;
  /** 언어 접두어를 뺀 경로. 홈은 '' , 제품은 'product' */
  path?: string;
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** JSON-LD 객체 배열 — 페이지마다 필요한 스키마를 넘깁니다 */
  jsonLd?: unknown[];
  /**
   * 이 경로가 **실제로 존재하는** 언어. 생략하면 5개 언어 전부로 봅니다.
   *
   * ── 왜 필요한가 ────────────────────────────────────────────
   * 지금까지 모든 페이지는 5개 언어에 다 있었습니다(`[lang]` 라우트가 언어마다
   * 하나씩 만드니까요). 그래서 alternates 를 무조건 5개 내는 것이 맞았습니다.
   *
   * 글은 다릅니다. 한국어로만 쓴 글에 5개 언어 hreflang 을 붙이면
   * `/en/support/posts/...` 를 가리키게 되고, 검색엔진이 크롤링해서 404 를
   * 받습니다. 사이트 전체 신뢰도가 떨어집니다.
   *
   * ⚠️ **x-default 도 함께 다뤄야 합니다.** 그것은 아래 langs 배열 바깥에
   *    따로 있고 DEFAULT_LOCALE('en') 을 무조건 가리킵니다. 배열만 줄이면
   *    한국어 전용 글의 x-default 가 여전히 /en/ 404 를 가리킵니다.
   */
  locales?: readonly Locale[];
}

const {
  locale,
  path = '',
  title,
  description,
  ogImage = '/og/home.jpg',
  ogImageAlt = '',
  noindex = false,
  jsonLd = [],
  locales,
} = Astro.props;

const t = dict(locale);
const canonical = new URL(localePath(locale, path), ORIGIN).href;
const ogImageUrl = new URL(ogImage, ORIGIN).href;

/*
 * 넘어온 언어만, 없으면 5개 전부. 순서는 alternates() 가 정한 대로 둡니다.
 *
 * 지금 보고 있는 언어는 무조건 넣습니다. 호출부가 빠뜨리면 canonical 은
 * 이 언어를 가리키는데 hreflang 목록에는 없는 상태가 되고, 검색엔진에는
 * "이 페이지는 어느 언어판도 아니다" 로 읽힙니다. 조용한 오류라 여기서
 * 막습니다.
 */
const wanted = locales ? [...new Set([locale, ...locales])] : null;
const langs = wanted
  ? alternates(path).filter((entry) => wanted.includes(entry.locale))
  : alternates(path);

// 기본 언어판이 없으면 x-default 를 아예 내보내지 않습니다.
// 없는 주소를 "여기가 기본입니다" 라고 알리는 것보다 침묵이 낫습니다.
const xDefault = !wanted || wanted.includes(DEFAULT_LOCALE)
  ? new URL(localePath(DEFAULT_LOCALE, path), ORIGIN).href
  : null;
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* 언어별 대안 URL. locales 를 넘기지 않으면 5개 언어 전부 + x-default */}
    {
      langs.map(({ locale: l, path: p }) => (
        <link rel="alternate" hreflang={LOCALE_TAGS[l]} href={new URL(p, ORIGIN).href} />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    {/* SNS 공유 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.brandName} />
    <meta property="og:locale" content={LOCALE_TAGS[locale].replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt || description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/*
      검색엔진 사이트 소유권 확인.

      ── 왜 모든 페이지에 나가는가 ──────────────────────────────
      네이버는 확인 시점에 어느 주소를 볼지 우리가 정하지 않고, 확인이 끝난
      뒤에도 주기적으로 다시 봅니다. 홈에만 두면 그 재확인이 다른 주소에
      닿았을 때 소유권이 풀립니다. 레이아웃에 두면 5개 언어 42개 페이지에
      전부 실립니다.

      값이 없으면 태그 자체가 나가지 않습니다 — 빈 content 는 확인에 실패할
      뿐 아니라 "뭔가 하려다 만 상태" 라는 신호가 됩니다.

      구글은 여기 없습니다. 도메인 속성을 DNS TXT 로 확인하므로 코드가 아니라
      Cloudflare DNS 쪽 일입니다.
    */}
    {
      SITE_VERIFICATION.naver && (
        <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    {/*
      브라우저 상단바 색. 사이트가 아니라 **브라우저 크롬** 을 칠하는 값이라
      본문 대비 규칙이 걸리지 않습니다. 그래서 화면 어디에도 글자색으로는 쓸 수
      없는 Mist Blue(오프 화이트 위 1.62:1)를 여기서는 쓸 수 있습니다.

      브랜딩 문서가 값까지 지정한 Core Color 는 Mist Blue 하나뿐이고, 패키지도
      그 색입니다. 페이지를 열 때 가장 먼저 보이는 면을 브랜드 색으로 두어
      웹과 제품의 첫인상을 맞춥니다.
    */}
    <meta name="theme-color" content={tokens.color.brand.surfaceAlt.value} />

    {/*
      폰트는 언어별 서브셋입니다. 이 페이지 언어에 실제로 쓰이는 글자만 담겨 있어
      한국어 129KB, 영어 39KB 로 끝납니다. Google Fonts 를 쓰던 초기 구현에서는
      외부 호스트에서 210KB 를 받아 모바일 LCP 가 7.5초였습니다.
    */}
    <link rel="stylesheet" href={`/fonts/${locale}/fonts.css`} />
    <link rel="preload" href={`/fonts/${locale}/body.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/${locale}/display.woff2`} as="font" type="font/woff2" crossorigin />

    {
      jsonLd.map((schema) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      ))
    }

    {/*
      Cloudflare Web Analytics.

      ── 왜 지금 넣는가 ─────────────────────────────────────────
      계측은 소급되지 않습니다. 2027년 1월까지 알림 신청 500명을 모으는 것이
      목표인데, 지금 심지 않으면 그 넉 달이 통째로 빈 채로 지나갑니다.

      ── 왜 쿠키 동의 배너가 없는가 ─────────────────────────────
      이 도구는 쿠키도 로컬 저장소도 쓰지 않고 개인을 식별하지 않습니다.
      그래서 사전 동의 대상이 아닙니다. 쿠키를 쓰는 도구로 바꾸는 순간
      배너와 개인정보처리방침이 함께 필요해집니다 — 도구를 바꿀 때
      이 주석을 먼저 보세요.

      ── 왜 조건부인가 ──────────────────────────────────────────
      토큰이 없으면 스크립트 자체가 나가지 않습니다. 처리방침에는
      "측정 도구를 씁니다" 라고 적혀 있는데 실제로는 아무것도 수집하지 않는
      상태가 되지 않도록, 켜짐 여부를 한 값이 정하게 두었습니다.

      is:inline 인 이유: Astro 가 번들에 넣으면 외부 스크립트가 아니게 되어
      beacon 이 자기 토큰을 읽지 못합니다.
    */}
    {
      WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN, spa: false })}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <Nav locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // ── 스크롤 등장 ──────────────────────────────────────────
      // IntersectionObserver 만 씁니다. 시안 01 의 모션은 fade-up 과 밑줄뿐이라
      // 애니메이션 라이브러리가 필요 없습니다.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      function revealAll() {
        document.querySelectorAll('.rise').forEach((el) => el.classList.add('is-in'));
      }

      if (reduced.matches) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('.rise').forEach((el) => io.observe(el));

        // ── 스무스 스크롤 ────────────────────────────────────
        // LCP 이후에 불러옵니다. 라이브러리가 늦게 와도 페이지는 이미 읽을 수 있습니다.
        const loadLenis = async () => {
          try {
            const { default: Lenis } = await import('lenis');
            const lenis = new Lenis({ duration: 1.05, smoothWheel: true });
            const raf = (time: number) => {
              lenis.raf(time);
              requestAnimationFrame(raf);
            };
            requestAnimationFrame(raf);
          } catch {
            // 스무스 스크롤은 있으면 좋은 것이지 필수가 아닙니다. 실패해도 기본 스크롤로 동작합니다.
          }
        };
        if ('requestIdleCallback' in window) {
          (window as any).requestIdleCallback(loadLenis, { timeout: 2500 });
        } else {
          window.addEventListener('load', () => setTimeout(loadLenis, 400));
        }
      }

      // 사용자가 도중에 모션 최소화를 켜면 즉시 반영합니다.
      reduced.addEventListener('change', (e) => {
        if (e.matches) revealAll();
      });
    </script>
  </body>
</html>
