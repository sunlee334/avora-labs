---
/**
 * 모든 페이지의 껍데기. SEO·hreflang·구조화 데이터가 전부 여기를 지납니다.
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import Footer from '../components/Footer.astro';
import {
  ORIGIN,
  LOCALE_TAGS,
  OG_LOCALES,
  DEFAULT_LOCALE,
  X_DEFAULT_LOCALE,
  INDEXED_LOCALES,
  BUSINESS,
  WEB_ANALYTICS_TOKEN,
  SITE_VERIFICATION,
  type Locale,
} from '../config/site';
import { dict, alternates, localePath } from '../i18n';
// 모바일 브라우저의 주소창 색입니다. 브랜드 색이므로 토큰에서 읽습니다 —
// 여기 값을 베껴 적으면 팔레트가 바뀔 때 이 한 줄만 옛 색으로 남습니다.
import tokens from '../../tokens/design-tokens.json';
import { PRELOAD } from '../config/fonts';
import { GA_MEASUREMENT_ID, ANALYTICS_HOST } from '../config/analytics';

interface Props {
  locale: Locale;
  /** 언어 접두어를 뺀 경로. 홈은 '' , 제품은 'product' */
  path?: string;
  title: string;
  description: string;
  /**
   * 어느 공유 그림을 쓸지. **경로가 아니라 이름** 입니다.
   *
   * 그림은 언어마다 다릅니다(`/og/home.ko.jpg`). 경로를 그대로 받으면
   * 페이지마다 언어를 붙여야 하고, 한 곳만 잊어도 그 언어의 공유 그림이
   * 조용히 남의 언어로 나갑니다. 이름만 받고 언어는 여기서 붙입니다.
   */
  ogImage?: 'home' | 'product';
  ogImageAlt?: string;
  noindex?: boolean;
  /** JSON-LD 객체 배열 — 페이지마다 필요한 스키마를 넘깁니다 */
  jsonLd?: unknown[];
  /**
   * 이 경로가 **실제로 존재하는** 언어. 생략하면 5개 언어 전부로 봅니다.
   *
   * ── 왜 필요한가 ────────────────────────────────────────────
   * 지금까지 모든 페이지는 5개 언어에 다 있었습니다(`[lang]` 라우트가 언어마다
   * 하나씩 만드니까요). 그래서 alternates 를 무조건 5개 내는 것이 맞았습니다.
   *
   * 글은 다릅니다. 한국어로만 쓴 글에 5개 언어 hreflang 을 붙이면
   * `/en/support/posts/...` 를 가리키게 되고, 검색엔진이 크롤링해서 404 를
   * 받습니다. 사이트 전체 신뢰도가 떨어집니다.
   *
   * ⚠️ **x-default 도 함께 다뤄야 합니다.** 그것은 아래 langs 배열 바깥에
   *    따로 있고 X_DEFAULT_LOCALE('ko') 을 가리킵니다. 배열만 줄이면
   *    그 언어가 빠진 글의 x-default 가 없는 주소를 가리킵니다.
   */
  locales?: readonly Locale[];
}

const {
  locale,
  path = '',
  title,
  description,
  ogImage = 'home',
  ogImageAlt = '',
  noindex = false,
  jsonLd = [],
  locales,
} = Astro.props;

const t = dict(locale);
const canonical = new URL(localePath(locale, path), ORIGIN).href;
const ogImageUrl = new URL(`/og/${ogImage}.${locale}.jpg`, ORIGIN).href;

/*
 * 넘어온 언어만, 없으면 5개 전부. 순서는 alternates() 가 정한 대로 둡니다.
 *
 * 지금 보고 있는 언어는 무조건 넣습니다. 호출부가 빠뜨리면 canonical 은
 * 이 언어를 가리키는데 hreflang 목록에는 없는 상태가 되고, 검색엔진에는
 * "이 페이지는 어느 언어판도 아니다" 로 읽힙니다. 조용한 오류라 여기서
 * 막습니다.
 */
const wanted = locales ? [...new Set([locale, ...locales])] : null;
const langs = wanted
  ? alternates(path).filter((entry) => wanted.includes(entry.locale))
  : alternates(path);

// 기본 언어판이 없으면 x-default 를 아예 내보내지 않습니다.
// 없는 주소를 "여기가 기본입니다" 라고 알리는 것보다 침묵이 낫습니다.
const xDefault = !wanted || wanted.includes(X_DEFAULT_LOCALE)
  ? new URL(localePath(X_DEFAULT_LOCALE, path), ORIGIN).href
  : null;
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      스크롤 등장 애니메이션의 **시작 상태를 켜는** 표식입니다.

      `.rise` 는 `opacity: 0` 으로 시작하고 아래 IntersectionObserver 가
      `is-in` 을 붙여야 나타납니다. 그런데 스크립트가 없으면 그 붙이는 일이
      영영 일어나지 않습니다 — 실측하면 `/brand` 는 본문 세 덩어리가 전부
      `.rise` 라 **화면 가운데가 통째로 백지** 였고, 홈도 히어로를 뺀 일곱
      덩어리가 보이지 않았습니다.

      그래서 감추는 쪽을 이 표식 뒤에 둡니다. 스크립트가 돌지 않으면 표식이
      없고, 표식이 없으면 아무것도 감춰지지 않습니다.

      `<head>` 안에서 동기적으로 실행되므로 첫 그림 전에 붙습니다 — 켜져
      있을 때 내용이 한 번 번쩍이는 일은 없습니다.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/*
      색인은 두 가지가 함께 정합니다 — 화면이 스스로 끄는 경우(noindex prop,
      예: 한국어판만 내보내는 /panel)와, 언어가 아직 색인 대상이 아닌 경우
      (INDEXED_LOCALES). 둘 중 하나라도 걸리면 내보내지 않습니다.

      `follow` 는 남깁니다 — 색인하지 말라는 것이지 링크를 따라가지 말라는
      것은 아닙니다. 이 페이지들이 가리키는 한국어판은 계속 발견돼야 합니다.
    */}
    {(noindex || !INDEXED_LOCALES.includes(locale)) && (
      <meta name="robots" content="noindex, follow" />
    )}

    {/* 언어별 대안 URL. locales 를 넘기지 않으면 5개 언어 전부 + x-default */}
    {
      langs.map(({ locale: l, path: p }) => (
        <link rel="alternate" hreflang={LOCALE_TAGS[l]} href={new URL(p, ORIGIN).href} />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    {/* SNS 공유 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.brandName} />
    {/* hreflang 태그를 그대로 쓰면 안 됩니다 — site.ts 의 OG_LOCALES 주석 참조. */}
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt || description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/*
      검색엔진 사이트 소유권 확인.

      ── 왜 모든 페이지에 나가는가 ──────────────────────────────
      네이버는 확인 시점에 어느 주소를 볼지 우리가 정하지 않고, 확인이 끝난
      뒤에도 주기적으로 다시 봅니다. 홈에만 두면 그 재확인이 다른 주소에
      닿았을 때 소유권이 풀립니다. 레이아웃에 두면 5개 언어 42개 페이지에
      전부 실립니다.

      값이 없으면 태그 자체가 나가지 않습니다 — 빈 content 는 확인에 실패할
      뿐 아니라 "뭔가 하려다 만 상태" 라는 신호가 됩니다.

      구글은 여기 없습니다. 도메인 속성을 DNS TXT 로 확인하므로 코드가 아니라
      Cloudflare DNS 쪽 일입니다.
    */}
    {
      SITE_VERIFICATION.naver && (
        <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    {/*
      브라우저 상단바 색. 사이트가 아니라 **브라우저 크롬** 을 칠하는 값이라
      본문 대비 규칙이 걸리지 않습니다. 그래서 화면 어디에도 글자색으로는 쓸 수
      없는 Mist Blue(오프 화이트 위 1.62:1)를 여기서는 쓸 수 있습니다.

      브랜딩 문서가 값까지 지정한 Core Color 는 Mist Blue 하나뿐이고, 패키지도
      그 색입니다. 페이지를 열 때 가장 먼저 보이는 면을 브랜드 색으로 두어
      웹과 제품의 첫인상을 맞춥니다.
    */}
    <meta name="theme-color" content={tokens.color.palette.aegean.value} />

    {/*
      폰트는 언어별 서브셋입니다. 이 페이지 언어에 실제로 쓰이는 글자만 담겨 있어
      한 언어가 받는 양이 수십 KB 로 끝납니다. Google Fonts 를 쓰던 초기 구현에서는
      외부 호스트에서 210KB 를 받아 모바일 LCP 가 7.5초였습니다.

      제목은 문자마다 짝이 다릅니다(라틴 Space Grotesk / 한글·태국어 IBM Plex /
      한자 Noto Sans SC). 그래서 preload 목록도 언어마다 다릅니다 —
      `src/config/fonts.ts` 를 보세요.
    */}
    <link rel="stylesheet" href={`/fonts/${locale}/fonts.css`} />
    {
      PRELOAD[locale].map((file) => (
        <link rel="preload" href={`/fonts/${locale}/${file}`} as="font" type="font/woff2" crossorigin />
      ))
    }

    {
      jsonLd.map((schema) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      ))
    }

    {/*
      Cloudflare Web Analytics — **대비책입니다. 평소에는 나가지 않습니다.**

      ── 지금은 엣지가 대신 넣고 있습니다 ───────────────────────
      이 도메인은 Cloudflare 프록시를 지나서, 대시보드에서 사이트를 추가한
      것만으로 엣지가 비콘을 자동 주입합니다(2026-08-30~). 그래서 아래 블록은
      토큰이 비어 있어 아무것도 내보내지 않는데도 사이트는 측정되고 있습니다.

      **자동 주입과 이 블록을 동시에 켜면 비콘이 둘이 되어 방문 수가 두 배로
      잡힙니다.** 언제 갈아타는지는 config/site.ts 의 WEB_ANALYTICS_TOKEN
      주석에 적어 두었습니다.

      ── 왜 쿠키 동의 배너가 없는가 ─────────────────────────────
      이 도구는 쿠키도 로컬 저장소도 쓰지 않고 개인을 식별하지 않습니다.
      그래서 사전 동의 대상이 아닙니다. 자동이든 수동이든 같은 도구라
      처리방침 문구도 같습니다. 쿠키를 쓰는 도구로 바꾸는 순간 배너와
      처리방침이 함께 필요해집니다 — 도구를 바꿀 때 이 주석을 먼저 보세요.

      is:inline 인 이유: Astro 가 번들에 넣으면 외부 스크립트가 아니게 되어
      beacon 이 자기 토큰을 읽지 못합니다.
    */}
    {/*
      Google Analytics 4.

      ── 왜 인라인 한 덩어리인가 ────────────────────────────────
      `<script src>` 를 그냥 놓으면 로컬·프리뷰·테스트에서도 요청이 나갑니다.
      그래서 **주소를 먼저 보고** 운영 도메인일 때만 gtag 를 불러옵니다.
      판정이 브라우저에 있으므로 빌드 종류와 무관하게 새지 않습니다.

      `is:inline` 인 이유: Astro 가 번들에 넣으면 `gtag` 가 모듈 스코프에
      갇혀 다른 스크립트에서 부를 수 없게 됩니다.

      ── 받는 것은 `load` 뒤로 미룹니다 ─────────────────────────
      `gtag/js` 는 실측 **170KB**(br)이고 `cache-control: private, max-age=900`
      이라 15분마다 다시 받습니다. 이 자리가 메인 CSS 보다 앞이라, 그대로 두면
      페이지가 자기 스타일시트와 대역폭을 두고 다투게 됩니다.

      **큐는 지금 만들고, 스크립트만 나중에 받습니다.** `dataLayer` 와 `gtag`
      스텁을 즉시 정의해 두면 그 사이에 들어온 호출이 배열에 쌓이고, 나중에
      도착한 gtag.js 가 그것을 그대로 비웁니다 — 측정이 빠지지 않습니다.

      lenis 를 미루는 방식과 같습니다(아래 body 스크립트). 다만 상한을 1초로
      짧게 둡니다 — 오래 미루면 금방 떠나는 방문이 집계에서 샙니다.

      ⚠️ 이 태그는 쿠키(`_ga`)를 심습니다. 처리방침의 쿠키 조항
         (`legal.privacy.cookies`)과 **항상 같이 나가야 합니다.** 태그만 먼저
         나가면 그 시점부터 법정 기재사항 누락 상태가 됩니다.
    */}
    <script is:inline define:vars={{ id: GA_MEASUREMENT_ID, host: ANALYTICS_HOST }}>
      if (location.hostname === host) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', id);

        var fetchGtag = function () {
          if (document.querySelector('script[data-gtag]')) return;
          var s = document.createElement('script');
          s.async = true;
          s.setAttribute('data-gtag', '');
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(s);
        };

        var afterLoad = function () {
          if (window.requestIdleCallback) {
            window.requestIdleCallback(fetchGtag, { timeout: 1000 });
          } else {
            setTimeout(fetchGtag, 200);
          }
        };

        // 이미 끝난 뒤에 이 코드가 도는 경우(bfcache 복원 등)를 위해 상태를 봅니다.
        if (document.readyState === 'complete') afterLoad();
        else window.addEventListener('load', afterLoad, { once: true });
      }
    </script>

    {
      WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN, spa: false })}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    {/* 공지 배너는 헤더 위입니다 — 설정이 꺼져 있으면 아무것도 그리지 않습니다. */}
    <NoticeBanner locale={locale} />
    {/*
      `langs` 를 내려보냅니다 — 위에서 hreflang 을 만든 **바로 그 배열**입니다.

      전에는 전환기가 `LOCALES` 5개를 스스로 돌았습니다. 그래서 한국어·영어로만
      쓴 글에서 언어를 바꾸면 빌드되지 않은 주소로 가 404 를 만났습니다.
      hreflang 은 맞고 화면 링크만 틀린 상태였는데, 같은 배열을 쓰면 그 둘이
      갈라질 수 없습니다.
    */}
    <Nav locale={locale} path={path} langs={langs} />
    {/*
      건너뛰기 링크의 착지점.

      `tabindex="-1"` 이 없으면 링크를 눌러도 포커스가 <body> 에 남습니다 —
      주소는 #main 으로 바뀌지만 다음 Tab 은 다시 헤더부터 시작합니다.
      키보드 사용자에게는 건너뛴 것이 아닙니다.

      `scroll-margin-top` 은 스티키 헤더 때문입니다. 없으면 착지한 h1 이
      헤더 뒤에 가립니다 — `#story` 가 같은 이유로 이미 갖고 있습니다.
    */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // ── 스크롤 등장 ──────────────────────────────────────────
      // IntersectionObserver 만 씁니다. 시안 01 의 모션은 fade-up 과 밑줄뿐이라
      // 애니메이션 라이브러리가 필요 없습니다.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      function revealAll() {
        document.querySelectorAll('.rise').forEach((el) => el.classList.add('is-in'));
      }

      if (reduced.matches) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('.rise').forEach((el) => io.observe(el));

        // ── 스무스 스크롤 ────────────────────────────────────
        // LCP 이후에 불러옵니다. 라이브러리가 늦게 와도 페이지는 이미 읽을 수 있습니다.
        const loadLenis = async () => {
          try {
            const { default: Lenis } = await import('lenis');
            const lenis = new Lenis({ duration: 1.05, smoothWheel: true });
            const raf = (time: number) => {
              lenis.raf(time);
              requestAnimationFrame(raf);
            };
            requestAnimationFrame(raf);
          } catch {
            // 스무스 스크롤은 있으면 좋은 것이지 필수가 아닙니다. 실패해도 기본 스크롤로 동작합니다.
          }
        };
        if ('requestIdleCallback' in window) {
          (window as any).requestIdleCallback(loadLenis, { timeout: 2500 });
        } else {
          window.addEventListener('load', () => setTimeout(loadLenis, 400));
        }
      }

      // 사용자가 도중에 모션 최소화를 켜면 즉시 반영합니다.
      reduced.addEventListener('change', (e) => {
        if (e.matches) revealAll();
      });
    </script>
  </body>
</html>
