---
/**
 * 제품 상세 — Daily Sunscreen
 *
 * 선크림은 "믿을 수 있는가"가 구매 장벽이라, 스펙 표와 FAQ 가 이 페이지의 핵심입니다.
 * 확정되지 않은 스펙은 숨기지 않고 "확정 예정"으로 노출합니다 — 빈칸을 감추는 것보다
 * 정직하고, 나중에 값만 채우면 됩니다.
 */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import productImage from '../../assets/images/product-daily-sunscreen.jpg';
import waterImage from '../../assets/images/water-droplets.jpg';
import { LOCALES, BUSINESS, type Locale } from '../../config/site';
import { dict, localePath } from '../../i18n';
import { breadcrumb, productSchema } from '../../lib/jsonld';
import productData from '../../data/product.json';
import LaunchNotify from '../../components/LaunchNotify.astro';
import { SELLS_DIRECTLY, EXTERNAL_STORE_URL, CAN_ORDER, PRICE, CURRENCY } from '../../config/runtime';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const p = t.product;

/*
 * 제품 정보 고시.
 *
 * 「전자상거래 등에서의 상품 등의 정보제공에 관한 고시」가 화장품에 요구하는
 * 항목입니다. 값은 product.json 이, 이름표는 번역 파일이 정합니다.
 *
 * **확정되지 않은 항목을 감추지 않습니다.** 법이 요구하는 목록이므로, 무엇이
 * 아직 없는지가 보이는 편이 빈 표보다 낫습니다. 감추면 그 항목이 있어야 한다는
 * 사실 자체를 잊게 됩니다.
 *
 * 사용방법과 소비자상담 전화는 이미 사이트가 갖고 있는 값을 그대로 씁니다 —
 * 같은 사실을 두 곳에 적어 두면 한쪽만 낡습니다.
 */
const d = productData.disclosure;
const usageText = p.howto.steps.map((step) => `${step.title} — ${step.body}`).join(' / ');
const sellerText =
  d.sellerName && d.sellerNumber
    ? `${d.sellerName} (등록번호 ${d.sellerNumber})`
    : (d.sellerName ?? null);

const disclosureRows: Array<{ key: string; label: string; value: string | null }> = [
  { key: 'volume', label: p.disclosure.labels.volume, value: d.volume },
  { key: 'features', label: p.disclosure.labels.features, value: d.features },
  { key: 'expiry', label: p.disclosure.labels.expiry, value: d.expiry },
  { key: 'usage', label: p.disclosure.labels.usage, value: usageText },
  { key: 'ingredients', label: p.disclosure.labels.ingredients, value: d.ingredients },
  { key: 'functionalReview', label: p.disclosure.labels.functionalReview, value: d.functionalReview },
  { key: 'cautions', label: p.disclosure.labels.cautions, value: d.cautions },
  { key: 'manufacturer', label: p.disclosure.labels.manufacturer, value: d.manufacturer },
  { key: 'seller', label: p.disclosure.labels.seller, value: sellerText },
  { key: 'countryOfOrigin', label: p.disclosure.labels.countryOfOrigin, value: d.countryOfOrigin },
  { key: 'customerService', label: p.disclosure.labels.customerService, value: BUSINESS.phone || null },
];

/**
 * 자사 결제를 여는 판단은 payment-config.json 과 product.json 이 내립니다.
 * 여기서는 결과만 읽습니다 — 결제를 켤 때 고칠 곳은 이 파일이 아니라 설정입니다.
 */
const sellsDirectly = SELLS_DIRECTLY;
const externalUrl = EXTERNAL_STORE_URL;

const priceLabel =
  PRICE != null
    ? new Intl.NumberFormat(locale, {
        style: 'currency',
        currency: CURRENCY,
        maximumFractionDigits: 0,
      }).format(PRICE)
    : null;

/*
 * 스펙.
 *
 * 기획안이 값을 정해 준 항목이라도 **아직 확정은 아닙니다.** 공장 처방
 * 선정은 2026년 9~10월이고, 기능성화장품은 심사·보고 절차가 남아 있습니다.
 * 심사 전에 차단지수를 확정 사실로 적으면 표시·광고 문제가 됩니다.
 * 그래서 정해진 값은 보여주되 `target` 인 것은 "목표" 를 달아 둡니다.
 *
 * 제형은 값 자체를 비웠습니다(null → "확정 예정"). 기획안 4장이 로션·밀크로
 * 적어 두긴 했지만 같은 장의 각주가 처방 선정 전이라고 못박고 있고, 실제로
 * 이 사이트는 한때 홈에서 "워터리 젤", 스펙표에서 "로션·밀크" 라고 **동시에**
 * 말하고 있었습니다. 고르기 전에는 고르는 중이라고 적는 편이 맞습니다.
 */
const specRows = [
  { key: p.spec.labels.protection, value: productData.spec.protection, target: true },
  { key: p.spec.labels.texture, value: null, target: true },
  { key: p.spec.labels.waterResistant, value: p.spec.values.waterResistant, target: true },
  { key: p.spec.labels.volume, value: productData.spec.volume, target: false },
  { key: p.spec.labels.scent, value: p.spec.values.scent, target: false },
  { key: p.spec.labels.tone, value: p.spec.values.tone, target: false },
  { key: p.spec.labels.area, value: p.spec.values.area, target: false },
  { key: p.spec.labels.category, value: p.spec.values.category, target: false },
];
---

<Base
  locale={locale}
  path="product"
  title={p.meta.title}
  description={p.meta.description}
  ogImage="product"
  ogImageAlt={p.meta.ogAlt}
  jsonLd={[
    productSchema(locale, productData.name, p.meta.description),
    breadcrumb([
      { name: BUSINESS.brandName, path: localePath(locale) },
      { name: productData.name, path: localePath(locale, 'product') },
    ]),
  ]}
>
  {/* 제품 히어로 */}
  <section class="section wrap">
    <div class="product-hero">
      <div class="product-hero__media rise">
        <Picture
          src={productImage}
          alt={p.hero.imageAlt}
          formats={['avif', 'webp']}
          widths={[390, 780, 1200]}
          sizes="(min-width: 900px) 50vw, 100vw"
          quality={72}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="rise">
        <p class="kicker">{productData.spf}</p>
        <h1 class="display display--tight">{productData.name}</h1>
        {
          /* 언제 나오는지 말하지 않으면 "확정 예정" 이 불확실로 읽힙니다. */
          !CAN_ORDER && (
            <p class="product-hero__window">{p.hero.launchWindow}</p>
          )
        }
        <p class="body" style="margin-top: 18px">{p.hero.headline}</p>

        {priceLabel && <p class="product-hero__price">{priceLabel}</p>}

        {
          sellsDirectly ? (
            <button class="cta" type="button" data-add-to-cart data-product-id={productData.id}>
              {p.hero.ctaCart}
            </button>
          ) : externalUrl ? (
            <a class="cta" href={externalUrl} rel="noopener">
              {p.hero.ctaExternal}
            </a>
          ) : (
            /*
             * 팔 수 없는 동안에도 할 일은 있어야 합니다.
             *
             * 예전에는 여기에 눌리지 않는 회색 글자("가격 확정 예정")가
             * 있었습니다. 제품이 2027년 상반기에 나오는데, 그때까지 관심이
             * 생긴 사람이 남길 수 있는 것이 아무것도 없었습니다.
             */
            <LaunchNotify
              locale={locale}
              source="product"
              heading={p.hero.notify.heading}
              body={p.hero.notify.body}
            />
          )
        }
      </div>
    </div>
  </section>

  {/* 네 감각 — LIGHT · COMFORT · PROTECTION · RESET */}
  <section class="rise">
    <div class="principles">
      {
        p.principles.items.map((item) => (
          <div>
            <p class="principles__term">{item.term}</p>
            <p class="principles__label">{item.label}</p>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/*
    통과 기준.

    아직 제품이 없습니다. 이럴 때 신뢰를 만드는 것은 완성된 사양이 아니라
    **무엇을 양보하지 않는가** 입니다. 기획안은 눈 시림과 백탁 두 가지를
    "미달하면 단가가 낮아도 채택하지 않는다" 고 못 박았습니다.
  */}
  <section class="section wrap rise">
    <p class="kicker">{p.standards.kicker}</p>
    <p class="display display--tight standards__lead">{p.standards.lead}</p>
    <p class="body" style="margin-top: 18px">{p.standards.body}</p>
  </section>

  {/* 스펙 */}
  <section class="section wrap rise">
    <p class="kicker">{p.spec.kicker}</p>
    <div class="spec">
      {
        specRows.map((row) => (
          <div class="spec__row">
            <p class="spec__key">{row.key}</p>
            <p class={`spec__value${row.value ? '' : ' spec__value--pending'}`}>
              {row.value ?? p.spec.values.pending}
              {row.value && row.target && (
                <span class="spec__target">{p.spec.values.target}</span>
              )}
            </p>
          </div>
        ))
      }
    </div>
    <p class="spec__note">{p.spec.note}</p>
  </section>

  {/* 움직이는 사람의 하루 — 사용법이 곧 브랜드 서사입니다 */}
  <section class="section section--alt wrap rise">
    <p class="kicker">{p.howto.kicker}</p>
    <p class="body" style="margin-top: 10px">{p.howto.lead}</p>
    <ol class="day" aria-label={p.howto.kicker}>
      {p.howto.day.map((label) => <li>{label}</li>)}
    </ol>
    <ol class="steps">
      {
        p.howto.steps.map((step) => (
          <li>
            <strong>{step.title}</strong>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/*
    물방울 이미지.

    alt 는 캡션이 아닙니다. 예전에는 alt="WATER" 하나였는데, 그건 화면에
    보이는 라벨이지 **그림이 뜨지 않은 사람에게 남는 설명** 이 아닙니다.
    라벨은 figcaption 으로 내리고 alt 에는 사진의 내용을 적습니다.
  */}
  <figure class="figure rise">
    <Picture
      src={waterImage}
      alt={p.figures.water.alt}
      formats={['avif', 'webp']}
      widths={[390, 780]}
      sizes="100vw"
      quality={52}
      loading="lazy"
      decoding="async"
    />
    <figcaption>WATER</figcaption>
  </figure>

  {/*
    FAQ.

    ⚠️ 이 페이지는 **FAQPage 구조화 데이터를 내지 않습니다.** 질문은 화면에
       그대로 두되 스키마는 고객센터 한 곳으로 모았습니다 — 같은 주제로 두
       페이지가 FAQPage 를 내면 검색에서 서로 갉아먹고 답변엔진은 어느 쪽을
       인용할지 모릅니다.

       사람은 사던 자리에서 읽고, 검색엔진은 한 곳만 봅니다.
       같은 배열(`product.faq.items`)을 고객센터가 import 하므로 문구가
       갈라질 일은 없습니다.

    details 로 접지 않는 것은 그대로입니다 — 접으면 답변엔진이 본문으로
    보지 않을 수 있습니다.
  */}
  <section class="section wrap rise" id="faq">
    {/*
      kicker 를 h2 로 올립니다.

      이 페이지의 heading 은 h1 하나와 FAQ 질문의 h2 들뿐이었습니다. 그래서
      문서 개요가 "제품 이름 아래에 질문들" 로 왜곡돼 있었습니다. 이 줄을
      h2 로 올리면 h1 → h2(섹션) → h3(질문) 이 되어 개요가 바로 섭니다.

      질문을 h3 으로 낮추는 것이 아니라 이쪽을 올리는 이유: h3 으로 낮추면
      h1 → h3 건너뜀이 되어 axe heading-order 위반입니다.
    */}
    <h2 class="kicker">{p.faq.kicker}</h2>
    <div class="faq">
      {
        p.faq.items.map((item, index) => (
          <div id={`product-${index + 1}`}>
            {/* 고객센터의 통합 FAQ 와 같은 태그를 씁니다 — 같은 질문이
                두 곳에서 다르게 보이지 않도록. id 도 같은 규칙입니다. */}
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))
      }
    </div>

    <p style="margin-top: 20px">
      {/* 나머지 질문은 고객센터에 모여 있습니다. */}
      <a class="tapLink" href={localePath(locale, 'support')}>{t.nav.support}</a>
    </p>

    <p style="margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px">
      <a class="cta cta--ghost" href={localePath(locale, 'reviews')}>{t.nav.reviews}</a>
      <a class="cta cta--ghost" href={localePath(locale)}>{p.backToStory}</a>
    </p>
  </section>

  <section class="section section--alt wrap rise" id="disclosure">
    <p class="kicker">{p.disclosure.kicker}</p>

    {/*
      접어 둡니다.

      열한 줄 중 아홉 줄이 "확정 예정" 입니다. 펼쳐 두면 한 화면 가득한
      "확정 예정" 의 벽이 되는데, 그건 정직한 표시이지만 브랜드에는 도움이
      되지 않습니다. 법적으로는 **접근할 수 있으면** 됩니다.

      접어도 되는 이유는 내용이 서버가 내려준 HTML 에 그대로 있기 때문입니다
      (열 때 채우는 방식이 아닙니다). 크롤러와 스크린리더는 그걸 읽습니다.
      다만 접힌 내용의 **가중치** 는 펼친 것보다 낮게 다뤄질 수 있어, 답변
      엔진이 인용하는 FAQ 는 접지 않습니다 — tests/e2e/product-seo.spec.ts
      가 그 경계를 지킵니다.

      요약 줄에 무엇이 들어 있는지 적어, 열지 않고도 여기가 무엇인지 압니다.
    */}
    <details class="disclosure">
      <summary>
        <span class="disclosure__label">{p.disclosure.columns.item}</span>
        <span class="disclosure__count">{disclosureRows.length}</span>
      </summary>

      <p class="spec__note disclosure__note">{p.disclosure.note}</p>

      {/*
        375px 에서 2열은 들어가지만 값이 길면 줄바꿈이 심해집니다. 좁은
        화면에서는 항목 이름 아래 값을 쌓습니다 — 가로 스크롤을 쓰면
        오른쪽 열(값)이 화면 밖에 남는데, 그게 이 표의 내용입니다.

        `<table>` 마크업은 유지합니다. 스크린리더가 표로 읽고, 법적 표시라
        구조가 남아 있어야 합니다.
      */}
      <table class="dataTable dataTable--stack">
        <thead>
          <tr>
            <th scope="col">{p.disclosure.columns.item}</th>
            <th scope="col">{p.disclosure.columns.value}</th>
          </tr>
        </thead>
        <tbody>
          {
            disclosureRows.map((row) => (
              <tr data-disclosure={row.key}>
                <th scope="row">{row.label}</th>
                <td>
                  {row.value ?? (
                    <span class="spec__value--pending">{p.disclosure.pending}</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </details>
  </section>

  {
    sellsDirectly && (
      <div class="toast" role="status" aria-live="polite" data-toast>
        <span>{p.hero.added}</span>
        <a href={localePath(locale, 'cart')}>{p.hero.viewCart}</a>
      </div>
    )
  }
</Base>

<script>
  import { add } from '../../lib/cart';
  import { mountLaunchNotify } from '../../lib/launch-notify';

  // 팔 수 없는 동안에만 화면에 있습니다. 없으면 조용히 넘어갑니다.
  mountLaunchNotify();

  const button = document.querySelector<HTMLButtonElement>('[data-add-to-cart]');
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  let timer: number | undefined;

  button?.addEventListener('click', () => {
    add(button.dataset.productId!, 1);
    if (!toast) return;
    toast.dataset.open = 'true';
    window.clearTimeout(timer);
    // 담은 직후 장바구니로 갈 사람에게는 링크가 남아 있어야 하니 넉넉히 둡니다.
    timer = window.setTimeout(() => {
      toast.dataset.open = 'false';
    }, 5000);
  });
</script>
