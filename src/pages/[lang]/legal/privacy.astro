---
/**
 * 개인정보처리방침.
 *
 * 수집 항목 표는 코드가 실제로 받는 것을 적었으므로 제가 채웠습니다.
 * 반면 고지 사항 전문은 사업자 정보와 법적 판단이 필요한 문서라 비워 둡니다 —
 * 그럴듯한 문구를 채워 넣으면 확인되지 않은 약속이 게시되는 셈입니다.
 * 문안이 확정되면 src/i18n/{언어}.json 의 legal.privacy 아래에 넣으면 됩니다.
 */
import Base from '../../../layouts/Base.astro';
import { BUSINESS, LOCALES, type Locale } from '../../../config/site';
import { dict, localePath } from '../../../i18n';
import { breadcrumb } from '../../../lib/jsonld';
import { ACCOUNTS_ENABLED, SELLS_DIRECTLY, CAN_ORDER } from '../../../config/runtime';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const page = t.legal.privacy;
const c = page.collect;

/*
 * 수집 항목은 **켜져 있는 기능만** 적습니다.
 *
 * 아직 하지 않는 수집을 적어 두면 그것도 틀린 고지입니다. 회원 기능이나
 * 자사 결제를 켜는 순간 이 표가 함께 늘어나므로, 따로 고치는 것을 잊을
 * 일이 없습니다.
 */
const rows = [
  ...c.rows,
  ...(ACCOUNTS_ENABLED ? c.accountRows : []),
  ...(SELLS_DIRECTLY ? c.reviewRows : []),

  /*
   * 문의는 **조건 없이** 적습니다.
   *
   * 다른 항목과 달리 문의를 끄는 플래그가 없습니다. 주문조회 화면
   * (`order/lookup.astro`)에는 ACCOUNTS_ENABLED 같은 게이트가 없어 어떤
   * 빌드에서도 존재하고, 거기에 문의 폼이 붙습니다. 조건을 달면 플래그가
   * 꺼진 빌드에서 **수집은 일어나는데 고지에는 없는** 상태가 됩니다 —
   * 이 파일이 위에서 금지한 바로 그것입니다.
   *
   * 나중에 INQUIRIES_ENABLED 같은 것이 생기면 여기도 함께 고쳐야 합니다.
   */
  ...c.inquiryRows,

  /*
   * 출시 알림은 **폼이 화면에 있을 때만** 적습니다.
   *
   * 이 폼은 팔 수 없을 때 구매 버튼 자리를 대신합니다(`product.astro`).
   * 팔기 시작하면 폼이 사라지므로 수집도 멈추고, 그러면 이 줄도 함께
   * 사라져야 합니다 — 하지 않는 수집을 적어 두는 것도 틀린 고지입니다.
   * 조건은 제품 페이지의 것과 같아야 하며, 한쪽만 고치면 어긋납니다.
   */
  ...(!CAN_ORDER ? c.notifyRows : []),

  /*
   * 검증단 지원은 **조건 없이** 적습니다.
   *
   * `/panel` 은 `getStaticPaths` 에 아무 게이트가 없어 어떤 빌드에서도
   * 존재합니다. 알림 폼처럼 `!CAN_ORDER` 로 감싸면, 판매를 켠 빌드에서
   * **수집은 일어나는데 고지에는 없는** 상태가 됩니다.
   *
   * 이 표에서 통째로 빠져 있던 것을 코드리뷰가 잡았습니다. 2026년 10월에
   * 러닝 크루로 링크를 뿌리는 순간부터 처리방침에 없는 항목을 대량으로
   * 수집하게 될 뻔했습니다.
   */
  ...c.panelRows,
];
---

<Base
  locale={locale}
  path="legal/privacy"
  title={page.meta.title}
  description={page.meta.description}
  jsonLd={[
    breadcrumb([
      { name: BUSINESS.brandName, path: localePath(locale) },
      { name: page.heading, path: localePath(locale, 'legal/privacy') },
    ]),
  ]}
>
  <section class="section wrap">
    <h1 class="display display--tight">{page.heading}</h1>

    <h2 class="kicker" style="margin-top: 40px">{c.heading}</h2>
    <p class="body">{c.intro}</p>

    {/* 가로로 스크롤되는 영역은 키보드로도 스크롤할 수 있어야 합니다.
        tabindex 가 없으면 마우스·터치 없이는 오른쪽 칸을 볼 방법이 없습니다. */}
    <div class="tableScroll" tabindex="0" role="group" aria-label={c.heading}>
      <table class="dataTable">
        <thead>
          <tr>
            <th scope="col">{c.columns.item}</th>
            <th scope="col">{c.columns.purpose}</th>
            <th scope="col">{c.columns.when}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <td>{row.item}</td>
                <td>{row.purpose}</td>
                <td>{row.when}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="body" style="margin-top: 24px">{c.notCollected}</p>
    {/* 후기에 이름이 어떻게 나가는지는 후기를 받을 때만 말이 됩니다. */}
    {SELLS_DIRECTLY && <p class="body" style="margin-top: 12px">{c.reviewMask}</p>}
    {!CAN_ORDER && (
      <p class="body" style="margin-top: 12px">{c.notifyNote}</p>
    )}
    <p class="body" style="margin-top: 14px">{c.retention}</p>

    {/*
      측정 도구는 "수집 항목" 표에 넣지 않았습니다. 표는 손님이 **직접 입력한**
      것을 다루는데, 이쪽은 입력 없이 화면을 여는 것만으로 생기는 일이라
      성격이 다릅니다. 표 안에 섞으면 "내가 언제 이걸 냈지" 가 됩니다.
    */}
    <h2 class="display display--tight" style="margin-top: 44px">
      {t.legal.privacy.analytics.heading}
    </h2>
    <p class="body" style="margin-top: 14px">{t.legal.privacy.analytics.body}</p>

    {/*
      쿠키는 위와 **다른 조항**입니다.

      위 도구(Cloudflare)는 쿠키를 만들지 않아 동의도 거부 절차도 없습니다.
      Google Analytics 는 쿠키를 심으므로 「개인정보 보호법」상 자동 수집 장치의
      설치·운영과 **거부 방법**이 법정 기재사항이 됩니다. 둘을 한 문단에 섞으면
      "쿠키를 안 쓴다" 와 "쿠키를 쓴다" 가 같은 자리에 놓여 어느 쪽도 참이
      아니게 됩니다.

      문단이 둘로 나뉘어 있어 빈 줄로 끊어 그립니다.
    */}
    <h2 class="display display--tight" style="margin-top: 44px">
      {t.legal.privacy.cookies.heading}
    </h2>
    {
      t.legal.privacy.cookies.body.split('\n\n').map((para) => (
        <p class="body" style="margin-top: 14px">{para}</p>
      ))
    }

    <p class="cart__notice" style="margin-top: 36px">{c.pending}</p>
  </section>
</Base>
