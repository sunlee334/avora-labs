---
/**
 * 개인정보처리방침.
 *
 * 수집 항목 표는 코드가 실제로 받는 것을 적었으므로 코드에서 만듭니다.
 *
 * 법정 기재사항(「개인정보 보호법」 제30조 1항)은 아래 절들이 채웁니다. 문구는
 * src/i18n/{언어}.json 의 legal.privacy 아래에 있습니다.
 *
 * **Google Analytics 를 붙인 순간 위탁과 국외 이전이 선택이 아니라 필수가
 * 됐습니다.** 데이터가 Google LLC(미국)로 나가기 때문입니다. 측정 도구를 빼면
 * 그 절도 함께 지워야 합니다 — 하지 않는 위탁을 적어 두는 것도 틀린 고지입니다.
 *
 * 보호책임자는 지금 대표자로 두었습니다. 따로 지정하시면 BUSINESS 가 아니라
 * 그 사람의 이름과 연락처로 바꾸세요.
 */
import Base from '../../../layouts/Base.astro';
import { BUSINESS, LOCALES, type Locale } from '../../../config/site';
import { dict, localePath } from '../../../i18n';
import { breadcrumb } from '../../../lib/jsonld';
import { ACCOUNTS_ENABLED, SELLS_DIRECTLY, CAN_ORDER } from '../../../config/runtime';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const page = t.legal.privacy;
const c = page.collect;

/*
 * 수집 항목은 **켜져 있는 기능만** 적습니다.
 *
 * 아직 하지 않는 수집을 적어 두면 그것도 틀린 고지입니다. 회원 기능이나
 * 자사 결제를 켜는 순간 이 표가 함께 늘어나므로, 따로 고치는 것을 잊을
 * 일이 없습니다.
 */
const rows = [
  ...c.rows,
  ...(ACCOUNTS_ENABLED ? c.accountRows : []),
  ...(SELLS_DIRECTLY ? c.reviewRows : []),

  /*
   * 문의는 **조건 없이** 적습니다.
   *
   * 다른 항목과 달리 문의를 끄는 플래그가 없습니다. 주문조회 화면
   * (`order/lookup.astro`)에는 ACCOUNTS_ENABLED 같은 게이트가 없어 어떤
   * 빌드에서도 존재하고, 거기에 문의 폼이 붙습니다. 조건을 달면 플래그가
   * 꺼진 빌드에서 **수집은 일어나는데 고지에는 없는** 상태가 됩니다 —
   * 이 파일이 위에서 금지한 바로 그것입니다.
   *
   * 나중에 INQUIRIES_ENABLED 같은 것이 생기면 여기도 함께 고쳐야 합니다.
   */
  ...c.inquiryRows,

  /*
   * 출시 알림은 **폼이 화면에 있을 때만** 적습니다.
   *
   * 이 폼은 팔 수 없을 때 구매 버튼 자리를 대신합니다(`product.astro`).
   * 팔기 시작하면 폼이 사라지므로 수집도 멈추고, 그러면 이 줄도 함께
   * 사라져야 합니다 — 하지 않는 수집을 적어 두는 것도 틀린 고지입니다.
   * 조건은 제품 페이지의 것과 같아야 하며, 한쪽만 고치면 어긋납니다.
   */
  ...(!CAN_ORDER ? c.notifyRows : []),

  /*
   * 검증단 지원은 **조건 없이** 적습니다.
   *
   * `/panel` 은 `getStaticPaths` 에 아무 게이트가 없어 어떤 빌드에서도
   * 존재합니다. 알림 폼처럼 `!CAN_ORDER` 로 감싸면, 판매를 켠 빌드에서
   * **수집은 일어나는데 고지에는 없는** 상태가 됩니다.
   *
   * 이 표에서 통째로 빠져 있던 것을 코드리뷰가 잡았습니다. 2026년 10월에
   * 러닝 크루로 링크를 뿌리는 순간부터 처리방침에 없는 항목을 대량으로
   * 수집하게 될 뻔했습니다.
   */
  ...c.panelRows,
];
---

<Base
  locale={locale}
  path="legal/privacy"
  title={page.meta.title}
  description={page.meta.description}
  jsonLd={[
    breadcrumb([
      { name: BUSINESS.brandName, path: localePath(locale) },
      { name: page.heading, path: localePath(locale, 'legal/privacy') },
    ]),
  ]}
>
  <section class="section wrap">
    <h1 class="display display--tight">{page.heading}</h1>

    <h2 class="kicker" style="margin-top: 40px">{c.heading}</h2>
    <p class="body">{c.intro}</p>

    {/* 가로로 스크롤되는 영역은 키보드로도 스크롤할 수 있어야 합니다.
        tabindex 가 없으면 마우스·터치 없이는 오른쪽 칸을 볼 방법이 없습니다. */}
    <div class="tableScroll" tabindex="0" role="group" aria-label={c.heading}>
      {/*
        `data-collect` 는 검사가 이 표를 다른 표와 구별하려고 붙잡는 표식입니다.
        법정 기재사항 절이 들어오면서 이 화면의 표가 넷이 됐는데, 그때 `.dataTable`
        하나만 보던 검사들이 어느 표를 보는지 알 수 없게 됐습니다.
      */}
      <table class="dataTable" data-collect>
        <thead>
          <tr>
            <th scope="col">{c.columns.item}</th>
            <th scope="col">{c.columns.purpose}</th>
            <th scope="col">{c.columns.when}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <td>{row.item}</td>
                <td>{row.purpose}</td>
                <td>{row.when}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="body" style="margin-top: 24px">{c.notCollected}</p>
    {/* 후기에 이름이 어떻게 나가는지는 후기를 받을 때만 말이 됩니다. */}
    {SELLS_DIRECTLY && <p class="body" style="margin-top: 12px">{c.reviewMask}</p>}
    {!CAN_ORDER && (
      <p class="body" style="margin-top: 12px">{c.notifyNote}</p>
    )}
    <p class="body" style="margin-top: 14px">{c.retention}</p>

    {/*
      측정 도구는 "수집 항목" 표에 넣지 않았습니다. 표는 손님이 **직접 입력한**
      것을 다루는데, 이쪽은 입력 없이 화면을 여는 것만으로 생기는 일이라
      성격이 다릅니다. 표 안에 섞으면 "내가 언제 이걸 냈지" 가 됩니다.
    */}
    <h2 class="display display--tight" style="margin-top: 44px">
      {t.legal.privacy.analytics.heading}
    </h2>
    <p class="body" style="margin-top: 14px">{t.legal.privacy.analytics.body}</p>

    {/*
      쿠키는 위와 **다른 조항**입니다.

      위 도구(Cloudflare)는 쿠키를 만들지 않아 동의도 거부 절차도 없습니다.
      Google Analytics 는 쿠키를 심으므로 「개인정보 보호법」상 자동 수집 장치의
      설치·운영과 **거부 방법**이 법정 기재사항이 됩니다. 둘을 한 문단에 섞으면
      "쿠키를 안 쓴다" 와 "쿠키를 쓴다" 가 같은 자리에 놓여 어느 쪽도 참이
      아니게 됩니다.

      문단이 둘로 나뉘어 있어 빈 줄로 끊어 그립니다.
    */}
    <h2 class="display display--tight" style="margin-top: 44px">
      {t.legal.privacy.cookies.heading}
    </h2>
    {
      t.legal.privacy.cookies.body.split('\n\n').map((para) => (
        <p class="body" style="margin-top: 14px">{para}</p>
      ))
    }

    {/*
      여기부터 법정 기재사항입니다(「개인정보 보호법」 제30조 1항).

      순서는 법이 정한 순서가 아니라 **읽는 사람에게 쓸모 있는 순서** 입니다 —
      내가 무엇을 할 수 있는가(권리) → 내 정보가 어디까지 가는가(위탁·국외
      이전) → 언제 사라지는가(파기) → 그동안 어떻게 지키는가(안전성) →
      누구에게 말하면 되는가(보호책임자) → 그래도 안 되면(구제) →
      이 문서가 바뀌면(변경).
    */}
    <h2 class="display display--tight" style="margin-top: 44px">{page.rights.heading}</h2>
    {
      page.rights.body.split('\n\n').map((para) => (
        <p class="body" style="margin-top: 14px">{para}</p>
      ))
    }

    <h2 class="display display--tight" style="margin-top: 44px">{page.entrust.heading}</h2>
    <p class="body" style="margin-top: 14px">{page.entrust.body}</p>
    <div class="tableScroll" tabindex="0" role="group" aria-label={page.entrust.heading}>
      <table class="dataTable dataTable--stack">
        <thead>
          <tr>
            <th scope="col">{page.entrust.columns.company}</th>
            <th scope="col">{page.entrust.columns.work}</th>
            <th scope="col">{page.entrust.columns.country}</th>
            <th scope="col">{page.entrust.columns.retention}</th>
          </tr>
        </thead>
        <tbody>
          {
            page.entrust.rows.map((row) => (
              <tr>
                <th scope="row">{row.company}</th>
                <td>{row.work}</td>
                <td>{row.country}</td>
                <td>{row.retention}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="body" style="margin-top: 14px">{page.entrust.note}</p>

    <h2 class="display display--tight" style="margin-top: 44px">{page.destroy.heading}</h2>
    {
      page.destroy.body.split('\n\n').map((para) => (
        <p class="body" style="margin-top: 14px">{para}</p>
      ))
    }

    <h2 class="display display--tight" style="margin-top: 44px">{page.safety.heading}</h2>
    {
      page.safety.body.split('\n\n').map((para) => (
        <p class="body" style="margin-top: 14px">{para}</p>
      ))
    }

    <h2 class="display display--tight" style="margin-top: 44px">{page.officer.heading}</h2>
    <p class="body" style="margin-top: 14px">{page.officer.body}</p>
    <table class="dataTable dataTable--stack" style="margin-top: 18px">
      <thead>
        <tr>
          <th scope="col">{page.officer.columns.role}</th>
          <th scope="col">{page.officer.columns.value}</th>
        </tr>
      </thead>
      <tbody>
        {
          /* 이름과 연락처를 문구에 박아 두면 바뀔 때 5개 언어를 다 고쳐야 합니다. */
          page.officer.rows.map((row) => (
            <tr>
              <th scope="row">{row.role}</th>
              <td>
                {row.value === '{email}' ? (
                  <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
                ) : (
                  row.value.replace('{representative}', BUSINESS.representative)
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2 class="display display--tight" style="margin-top: 44px">{page.remedy.heading}</h2>
    <p class="body" style="margin-top: 14px">{page.remedy.body}</p>
    <table class="dataTable dataTable--stack" style="margin-top: 18px">
      <thead>
        <tr>
          <th scope="col">{page.remedy.columns.org}</th>
          <th scope="col">{page.remedy.columns.contact}</th>
        </tr>
      </thead>
      <tbody>
        {
          page.remedy.rows.map((row) => (
            <tr>
              <th scope="row">{row.org}</th>
              <td>{row.contact}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2 class="display display--tight" style="margin-top: 44px">{page.changes.heading}</h2>
    {
      page.changes.body.split('\n\n').map((para) => (
        <p class="body" style="margin-top: 14px">{para}</p>
      ))
    }
  </section>
</Base>
