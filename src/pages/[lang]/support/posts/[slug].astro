---
/**
 * 글 하나.
 *
 * ── hreflang 이 없는 주소를 가리키면 안 됩니다 ──────────────
 * `Base.astro` 는 지금까지 5개 언어 hreflang 을 무조건 뿌렸습니다. 모든
 * 페이지가 5개 언어에 다 있었으니 맞았습니다. 글은 다릅니다 — 한국어로만
 * 쓴 글에 5개를 붙이면 검색엔진이 `/en/support/posts/...` 를 크롤링하고
 * 404 를 받습니다.
 *
 * 그래서 **같은 slug 를 가진 언어만** 넘깁니다. `@astrojs/sitemap` 도
 * 경로가 같은 것끼리 묶으므로, 페이지가 내는 신호와 사이트맵이 내는
 * 신호가 저절로 일치합니다.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { BUSINESS, LOCALES, type Locale } from '../../../../config/site';
import { dict, localePath, isLocale } from '../../../../i18n';
import { article, breadcrumb } from '../../../../lib/jsonld';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  /** slug 하나가 어느 언어에 있는지. hreflang 을 만드는 데 씁니다. */
  const bySlug = new Map<string, Locale[]>();
  for (const post of posts) {
    const [lang, slug] = post.id.split('/');
    if (!isLocale(lang)) continue; // 아래에서 오류로 잡습니다
    bySlug.set(slug, [...(bySlug.get(slug) ?? []), lang]);
  }

  return posts.map((post) => {
    const [lang, ...rest] = post.id.split('/');

    /*
     * 로케일 디렉터리 이름을 여기서 확인합니다.
     *
     * `dict()` 는 알 수 없는 언어를 기본 언어로 넘겨 줍니다 — 빌드 중에
     * 죽지 않게 하려는 설계입니다. 그 덕에 `src/content/posts/kr/`(오타)를
     * 만들면 `/kr/support/posts/...` 가 **조용히 생성되어 사이트맵에
     * 실립니다.** 여기서 세웁니다.
     */
    if (!isLocale(lang)) {
      throw new Error(
        `알 수 없는 언어 폴더입니다: src/content/posts/${lang}/ — ${LOCALES.join(' · ')} 중 하나여야 합니다.`,
      );
    }

    // [slug] 는 rest 파라미터가 아니라 슬래시를 담지 못합니다.
    if (rest.length !== 1) {
      throw new Error(`글은 평면 구조여야 합니다: src/content/posts/${post.id}.md`);
    }

    return {
      params: { lang, slug: rest[0] },
      // 위 두 검사(로케일·평면 구조)를 통과했으므로 키가 반드시 있습니다.
      props: { post, locales: bySlug.get(rest[0])! },
    };
  });
}

const { post, locales } = Astro.props;
const locale = Astro.params.lang as Locale;
const t = dict(locale);
const page = t.support.posts;
const { Content } = await render(post);

// Astro.params 대신 props 에서 유도합니다 — params 는 string | undefined 라
// 값이 없으면 `support/posts/undefined` 가 canonical·JSON-LD 에 조용히 실립니다.
const slug = post.id.split('/')[1];
const path = `support/posts/${slug}`;
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<Base
  locale={locale}
  path={path}
  locales={locales}
  title={`${post.data.title} — ${BUSINESS.brandName}`}
  description={post.data.summary}
  jsonLd={[
    article({
      headline: post.data.title,
      description: post.data.summary,
      path: localePath(locale, path),
      locale,
      publishedAt: isoDate(post.data.publishedAt),
      ...(post.data.updatedAt ? { updatedAt: isoDate(post.data.updatedAt) } : {}),
    }),
    breadcrumb([
      { name: BUSINESS.brandName, path: localePath(locale) },
      { name: t.support.heading, path: localePath(locale, 'support') },
      { name: page.heading, path: localePath(locale, 'support/posts') },
      { name: post.data.title, path: localePath(locale, path) },
    ]),
  ]}
>
  <article class="section wrap post">
    <p class="kicker">{page.categories[post.data.category]}</p>
    <h1 class="display display--tight">{post.data.title}</h1>

    <p class="post__meta">
      <time datetime={isoDate(post.data.publishedAt)}>{isoDate(post.data.publishedAt)}</time>
    </p>

    <div class="post__body">
      <Content />
    </div>

    <p class="postList__back">
      <a class="tapLink" href={localePath(locale, 'support/posts')}>{page.backToList}</a>
    </p>
  </article>
</Base>
