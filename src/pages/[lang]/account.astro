---
/**
 * 마이페이지 — 1단계.
 *
 * 주문 내역, 저장된 배송지, 이전 주문 가져오기.
 *
 * 회원 기능이 꺼져 있으면(기본값) 이 페이지 자체를 만들지 않습니다.
 * 눌러도 아무 일이 없는 로그인 버튼을 보여주는 것은 없는 것만 못합니다.
 *
 * 화면에 주문자 정보가 그려지므로 색인 대상이 아닙니다.
 */
import Base from '../../layouts/Base.astro';
import { LOCALES, type Locale } from '../../config/site';
import { dict, localePath } from '../../i18n';
import { ACCOUNTS_ENABLED } from '../../config/runtime';
import carriers from '../../config/carriers.json';

export function getStaticPaths() {
  if (!ACCOUNTS_ENABLED) return [];
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const a = t.account;
---

<Base
  locale={locale}
  path="account"
  title={a.meta.title}
  description={a.meta.description}
  noindex
>
  <section class="section wrap account" data-account data-locale={locale}>
    <h1 class="display display--tight">{a.heading}</h1>

    {/* 로그인 전 */}
    <div data-account-anon hidden>
      <h2 class="kicker" style="margin-top: 36px">{a.loginHeading}</h2>
      <p class="body">{a.loginBody}</p>
      {/*
        버튼은 서버가 켜 둔 제공자만큼만 그립니다(/api/auth/providers).
        키가 없는 제공자의 버튼을 미리 그려 두면, 눌러도 아무 일이 없는
        로그인 버튼이 됩니다 — 없는 것만 못합니다.
      */}
      <div class="providerButtons" data-login-buttons></div>
      <p class="cart__notice">{a.guestNote}</p>
    </div>

    {/* 로그인 후 */}
    <div data-account-signed hidden>
      <p class="body" style="margin-top: 20px">
        <span data-account-name></span>
        <button class="linkButton" type="button" data-logout>{a.logout}</button>
      </p>

      <h2 class="kicker" style="margin-top: 40px">{a.orders.heading}</h2>
      <p class="body" data-orders-state>{a.orders.loading}</p>
      <dl class="orderResult__facts" data-orders hidden></dl>

      <div class="sectionHead" style="margin-top: 40px">
        <h2 class="kicker">{a.address.heading}</h2>
        <button class="linkButton" type="button" data-address-edit>{a.address.edit}</button>
      </div>
      <p class="body" data-address-empty hidden>{a.address.empty}</p>
      <dl class="orderResult__facts" data-address hidden>
        <div><dt>{t.order.complete.recipient}</dt><dd data-addr-name></dd></div>
        <div><dt>{t.order.lookup.phone}</dt><dd data-addr-phone></dd></div>
        <div><dt>{t.order.complete.address}</dt><dd data-addr-line></dd></div>
      </dl>
      <p class="cart__notice" data-address-note hidden>{a.address.note}</p>

      {/* 저장 자체는 PUT /api/account/address 가 이미 하고 있었습니다 —
          부를 화면이 없었을 뿐입니다. */}
      <form class="addressForm" data-address-form hidden>
        <div class="field">
          <label for="ad-name">{a.address.recipientName}</label>
          <input id="ad-name" name="recipientName" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="ad-phone">{a.address.recipientPhone}</label>
          <input id="ad-phone" name="recipientPhone" type="tel" required inputmode="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="ad-postal">{a.address.postalCode}</label>
          <input id="ad-postal" name="postalCode" type="text" required inputmode="numeric" autocomplete="postal-code" />
        </div>
        <div class="field">
          <label for="ad-line1">{a.address.address1}</label>
          <input id="ad-line1" name="address1" type="text" required autocomplete="address-line1" />
        </div>
        <div class="field">
          <label for="ad-line2">
            {a.address.address2}
            <span class="field__optional">{a.address.address2Optional}</span>
          </label>
          <input id="ad-line2" name="address2" type="text" autocomplete="address-line2" />
        </div>
        <p class="checkout__error" data-address-error hidden></p>
        <div class="formActions">
          <button class="cta" type="submit" data-address-save>{a.address.save}</button>
          <button class="linkButton" type="button" data-address-cancel>{a.address.cancel}</button>
        </div>
      </form>

      <h2 class="kicker" style="margin-top: 40px">{a.profile.heading}</h2>
      <dl class="orderResult__facts">
        <div><dt>{a.profile.email}</dt><dd data-profile-email></dd></div>
        <div><dt>{a.profile.joined}</dt><dd data-profile-joined></dd></div>
      </dl>
      <p class="cart__notice">{a.profile.managedBy}</p>

      <h2 class="kicker" style="margin-top: 40px">{a.identities.heading}</h2>
      <p class="body">{a.identities.body}</p>
      <p class="body" data-identities-state>{a.identities.loading}</p>
      <ul class="identityList" data-identities hidden></ul>
      <div class="providerButtons" data-link-buttons></div>
      <p class="cart__notice" data-identities-note hidden>{a.identities.lastNote}</p>

      <h2 class="kicker" style="margin-top: 40px">{a.claim.heading}</h2>
      <p class="body">{a.claim.body}</p>
      <form class="checkout__form" data-claim style="margin-top: 20px">
        <label class="field">
          <span class="field__label">{a.claim.orderId}</span>
          <input class="field__input" type="text" name="orderId" required autocomplete="off" />
        </label>
        <label class="field">
          <span class="field__label">{a.claim.phone}</span>
          <input class="field__input" type="tel" name="phone" required inputmode="numeric" autocomplete="tel" />
        </label>
        <p class="field__error" data-claim-error hidden></p>
        <p class="body" data-claim-success hidden>{a.claim.success}</p>
        <button class="cta" type="submit" data-claim-submit>{a.claim.submit}</button>
      </form>
    </div>
  </section>

  <template
    data-account-labels
    data-label-notfound={a.claim.notFound}
    data-label-error={a.error}
    data-label-empty-orders={a.orders.empty}
    data-label-loading={a.orders.loading}
    data-label-success={a.claim.success}
    data-label-submit={a.claim.submit}
    data-path-lookup={localePath(locale, 'order/lookup')}
    data-label-login-with={a.loginWith}
    data-label-connect={a.identities.connect}
    data-label-disconnect={a.identities.disconnect}
    data-provider-names={JSON.stringify(a.providers)}
    data-msg-link-ok={a.identities.messages.ok}
    data-msg-link-already={a.identities.messages.already_linked}
    data-msg-link-taken={a.identities.messages.taken}
    data-msg-unlinked={a.identities.messages.unlinked}
    data-msg-link-failed={a.identities.messages.failed}
    data-carriers={JSON.stringify(carriers.carriers)}
    data-status-labels={JSON.stringify(a.status)}
    data-fulfillment-labels={JSON.stringify(t.legal.shipping.steps.labels)}
    data-label-quantity={a.orders.quantity}
    data-label-tracking={a.orders.trackingLink}
    data-label-no-tracking={a.orders.noTracking}
    data-label-no-email={a.profile.noEmail}
    data-label-addr-saved={a.address.saved}
    data-label-addr-failed={a.address.failed}
    data-label-addr-saving={a.address.saving}
    data-label-addr-save={a.address.save}
  ></template>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-account]');
  const labels = document.querySelector<HTMLTemplateElement>('[data-account-labels]');

  if (root && labels) {
    const L = labels.dataset;
    const locale = root.dataset.locale!;
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const anon = $('[data-account-anon]');
    const signed = $('[data-account-signed]');

    const providerNames = JSON.parse(L.providerNames ?? '{}') as Record<string, string>;
    const label = (provider: string) => providerNames[provider] ?? provider;
    const returnTo = encodeURIComponent(location.pathname);

    /**
     * 제공자 버튼 하나.
     *
     * 링크에 담기는 것은 제공자 이름뿐이고, 인가는 전부 서버가 합니다.
     * 여기서 만든 주소를 손대도 켜지지 않은 제공자로는 시작되지 않습니다.
     */
    function providerLink(kind: 'login' | 'link', provider: string, text: string): HTMLAnchorElement {
      const a = document.createElement('a');
      a.className = kind === 'login' ? 'cta' : 'cta cta--ghost';
      a.href = `/api/auth/${kind === 'login' ? 'login' : 'link'}?provider=${encodeURIComponent(provider)}&returnTo=${returnTo}`;
      a.textContent = text;
      return a;
    }

    /** 로그인 전 — 켜져 있는 제공자만큼 버튼을 그립니다. */
    async function drawLoginButtons() {
      const box = $('[data-login-buttons]');
      box.replaceChildren();
      try {
        const { providers } = await (await fetch('/api/auth/providers')).json();
        for (const provider of providers as string[]) {
          box.append(
            providerLink('login', provider, (L.labelLoginWith ?? '{provider}').replace('{provider}', label(provider))),
          );
        }
      } catch {
        /* 목록을 못 받아도 화면은 계속 보여줍니다 — 로그인만 불가합니다. */
      }
    }

    /** 연결 결과는 주소에 실려 돌아옵니다(?link=ok 등). */
    function linkMessage(): string | null {
      const value = new URLSearchParams(location.search).get('link');
      if (!value) return null;
      const map: Record<string, string | undefined> = {
        ok: L.msgLinkOk,
        already_linked: L.msgLinkAlready,
        taken: L.msgLinkTaken,
      };
      return map[value] ?? L.msgLinkFailed ?? null;
    }

    /** 로그인 후 — 붙어 있는 수단과 아직 붙일 수 있는 수단. */
    async function drawIdentities() {
      const state = $('[data-identities-state]');
      const list = $<HTMLUListElement>('[data-identities]');
      const linkBox = $('[data-link-buttons]');
      const note = $('[data-identities-note]');

      let body: { linked: Array<{ provider: string; email: string | null }>; available: string[]; canUnlink: boolean };
      try {
        const res = await fetch('/api/account/identities');
        if (!res.ok) throw new Error('failed');
        body = await res.json();
      } catch {
        state.textContent = L.msgLinkFailed ?? '';
        return;
      }

      const message = linkMessage();
      state.textContent = message ?? '';
      state.hidden = !message;

      list.replaceChildren();
      for (const identity of body.linked) {
        const li = document.createElement('li');
        const name = document.createElement('span');
        // 제공자가 준 이메일은 사람이 만든 값이라 textContent 로만 넣습니다.
        name.textContent = identity.email ? `${label(identity.provider)} · ${identity.email}` : label(identity.provider);
        li.append(name);

        if (body.canUnlink) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'linkButton';
          button.textContent = L.labelDisconnect ?? '';
          button.addEventListener('click', async () => {
            button.disabled = true;
            const res = await fetch('/api/account/identities/unlink', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ provider: identity.provider }),
            });
            state.hidden = false;
            state.textContent = res.ok ? (L.msgUnlinked ?? '') : (L.msgLinkFailed ?? '');
            await drawIdentities();
          });
          li.append(button);
        }
        list.append(li);
      }
      list.hidden = body.linked.length === 0;

      linkBox.replaceChildren();
      for (const provider of body.available) {
        linkBox.append(
          providerLink('link', provider, `${label(provider)} ${L.labelConnect ?? ''}`.trim()),
        );
      }

      // 마지막 하나뿐이면 왜 뗄 수 없는지 알려 줍니다.
      note.hidden = body.canUnlink;
    }

    const money = (v: number, currency: string) => {
      try {
        return new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 }).format(v);
      } catch {
        return `${v.toLocaleString(locale)} ${currency}`;
      }
    };

    const when = (iso: string | null) =>
      iso ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium' }).format(new Date(iso)) : '—';

    function row(term: string, value: string): HTMLElement {
      const box = document.createElement('div');
      const dt = document.createElement('dt');
      dt.textContent = term;
      const dd = document.createElement('dd');
      // 주문 데이터는 사람이 입력한 값이라 textContent 로만 넣습니다.
      dd.textContent = value;
      box.append(dt, dd);
      return box;
    }

    async function load() {
      const meRes = await fetch('/api/account/me');
      if (meRes.status === 401 || !meRes.ok) {
        anon.hidden = false;
        void drawLoginButtons();
        return;
      }

      const { user } = await meRes.json();
      signed.hidden = false;
      void drawIdentities();
      $('[data-account-name]').textContent = user.name ?? user.email ?? '';

      // 계정 정보 — 제공자가 관리하는 값이라 읽기 전용입니다.
      $('[data-profile-email]').textContent = user.email ?? (L.labelNoEmail ?? '');
      $('[data-profile-joined]').textContent = when(user.createdAt);

      // 저장된 배송지
      savedAddress = user.address ?? null;
      if (user.address) {
        $('[data-address]').hidden = false;
        $('[data-address-note]').hidden = false;
        $('[data-addr-name]').textContent = user.address.recipientName;
        $('[data-addr-phone]').textContent = user.address.recipientPhone ?? '';
        $('[data-addr-line]').textContent =
          `(${user.address.postalCode}) ${user.address.address1} ${user.address.address2 ?? ''}`.trim();
      } else {
        $('[data-address-empty]').hidden = false;
      }

      await loadOrders();
    }

    async function loadOrders() {
      const state = $('[data-orders-state]');
      const box = $('[data-orders]');
      state.textContent = L.labelLoading!;
      state.hidden = false;
      box.hidden = true;

      const res = await fetch('/api/account/orders');
      if (!res.ok) {
        state.textContent = L.labelError!;
        return;
      }
      const { orders } = await res.json();
      if (!orders.length) {
        state.textContent = L.labelEmptyOrders!;
        return;
      }

      box.replaceChildren(...orders.map(orderCard));
      state.hidden = true;
      box.hidden = false;
    }

    const carriers = JSON.parse(L.carriers ?? '{}') as Record<string, string>;
    const statusLabels = JSON.parse(L.statusLabels ?? '{}') as Record<string, string>;
    const fulfillmentLabels = JSON.parse(L.fulfillmentLabels ?? '{}') as Record<string, string>;

    /**
     * 주문 한 건.
     *
     * API 는 상태·배송단계·택배사·송장·상품까지 전부 돌려주는데 예전 화면은
     * 날짜·번호·금액 셋만 쓰고 나머지를 버렸습니다. 손님이 마이페이지에서
     * 가장 알고 싶은 것은 **지금 어디까지 왔는가** 입니다.
     */
    function orderCard(o: any): HTMLElement {
      const li = document.createElement('article');
      li.className = 'orderCard';
      li.dataset.order = o.id;

      const head = document.createElement('p');
      head.className = 'orderCard__head';
      head.textContent = `${when(o.createdAt)} · ${o.id}`;
      li.append(head);

      // 상품 줄 — 이름은 서버가 저장해 둔 값입니다.
      for (const item of o.items ?? []) {
        const line = document.createElement('p');
        line.className = 'orderCard__item';
        const qty = (L.labelQuantity ?? '{n}').replace('{n}', String(item.qty ?? 1));
        line.textContent = `${item.name ?? item.id} ${qty}`;
        li.append(line);
      }

      const amount = document.createElement('p');
      amount.className = 'orderCard__amount';
      amount.textContent = money(o.amount, o.currency);
      li.append(amount);

      const badges = document.createElement('p');
      badges.className = 'orderCard__badges';
      const status = document.createElement('span');
      status.className = 'reviews__badge';
      status.textContent = statusLabels[o.status] ?? o.status;
      badges.append(status);

      // 결제되지 않은 주문에 배송 단계를 붙이면 곧 보낼 것처럼 보입니다.
      if (o.status === 'paid') {
        const step = document.createElement('span');
        step.className = 'reviews__badge';
        step.textContent = fulfillmentLabels[o.fulfillment] ?? o.fulfillment;
        badges.append(step);
      }
      li.append(badges);

      /*
       * 배송 조회.
       *
       * 송장번호만 보여주면 손님이 번호를 복사해 택배사 사이트를 직접
       * 찾아가야 합니다. 아는 택배사면 바로 열리게 하고, 모르는 택배사면
       * 이름과 번호만 글자로 둡니다 — 틀린 곳으로 보내는 것보다 낫습니다.
       */
      if (o.status === 'paid' && o.carrier && o.trackingNumber) {
        const tracking = document.createElement('p');
        tracking.className = 'orderCard__tracking';
        const label = document.createElement('span');
        label.textContent = `${o.carrier} ${o.trackingNumber}`;
        tracking.append(label);

        const template = carriers[o.carrier];
        if (template) {
          const link = document.createElement('a');
          link.className = 'tapLink';
          link.href = template.replace('{tracking}', encodeURIComponent(o.trackingNumber));
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = L.labelTracking ?? '';
          tracking.append(link);
        }
        li.append(tracking);
      } else if (o.status === 'paid' && o.fulfillment !== 'delivered') {
        const note = document.createElement('p');
        note.className = 'orderCard__note';
        note.textContent = L.labelNoTracking ?? '';
        li.append(note);
      }

      return li;
    }

    /*
     * 배송지 수정.
     *
     * 저장은 PUT /api/account/address 가 이미 하고 있었습니다 — 부를 화면이
     * 없었을 뿐입니다. 이름과 이메일은 여기서 바꾸지 않습니다: 로그인할
     * 때마다 제공자가 준 값으로 덮어써서, 고쳐도 다음 로그인에 되돌아갑니다.
     */
    const addressForm = $<HTMLFormElement>('[data-address-form]');
    const addressList = $('[data-address]');
    const addressEmpty = $('[data-address-empty]');
    const addressNote = $('[data-address-note]');
    const addressError = $('[data-address-error]');
    const editButton = $<HTMLButtonElement>('[data-address-edit]');

    /** 저장된 값을 폼에 채워 둡니다 — 빈 칸부터 다시 쓰게 하지 않습니다. */
    let savedAddress: Record<string, string | null> | null = null;

    function showForm(show: boolean) {
      addressForm.hidden = !show;
      editButton.hidden = show;
      addressList.hidden = show || !savedAddress;
      addressEmpty.hidden = show || Boolean(savedAddress);
      addressNote.hidden = show || !savedAddress;
      addressError.hidden = true;
    }

    editButton.addEventListener('click', () => {
      const fields = addressForm.elements as unknown as Record<string, HTMLInputElement>;
      if (savedAddress) {
        fields.recipientName.value = savedAddress.recipientName ?? '';
        fields.recipientPhone.value = savedAddress.recipientPhone ?? '';
        fields.postalCode.value = savedAddress.postalCode ?? '';
        fields.address1.value = savedAddress.address1 ?? '';
        fields.address2.value = savedAddress.address2 ?? '';
      }
      showForm(true);
      fields.recipientName.focus();
    });

    $('[data-address-cancel]').addEventListener('click', () => showForm(false));

    addressForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      addressError.hidden = true;

      const data = new FormData(addressForm);
      const payload = {
        recipientName: String(data.get('recipientName') ?? '').trim(),
        recipientPhone: String(data.get('recipientPhone') ?? '').trim(),
        postalCode: String(data.get('postalCode') ?? '').trim(),
        address1: String(data.get('address1') ?? '').trim(),
        address2: String(data.get('address2') ?? '').trim() || undefined,
      };

      const save = $<HTMLButtonElement>('[data-address-save]');
      save.disabled = true;
      save.textContent = L.labelAddrSaving ?? '';

      try {
        const res = await fetch('/api/account/address', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('failed');
        showForm(false);
        await load();
      } catch {
        addressError.textContent = L.labelAddrFailed ?? '';
        addressError.hidden = false;
      } finally {
        save.disabled = false;
        save.textContent = L.labelAddrSave ?? '';
      }
    });

    $('[data-logout]').addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      location.reload();
    });

    $<HTMLFormElement>('[data-claim]').addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const error = $('[data-claim-error]');
      const success = $('[data-claim-success]');
      const submit = $<HTMLButtonElement>('[data-claim-submit]');
      error.hidden = true;
      success.hidden = true;
      submit.disabled = true;

      try {
        const data = new FormData(form);
        const res = await fetch('/api/account/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            orderId: String(data.get('orderId') ?? '').trim(),
            phone: String(data.get('phone') ?? '').trim(),
          }),
        });

        if (res.ok) {
          success.hidden = false;
          form.reset();
          await loadOrders();
        } else {
          error.textContent = res.status === 404 ? L.labelNotfound! : L.labelError!;
          error.hidden = false;
        }
      } catch {
        error.textContent = L.labelError!;
        error.hidden = false;
      } finally {
        submit.disabled = false;
      }
    });

    load();
  }
</script>
