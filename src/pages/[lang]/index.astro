              <strong class="journey__word">{step.word}</strong>
              <span class="journey__body">{step.body}</span>
              {/* 두 번째 줄 — 그 단계에서 실제로 무엇이 걸리는지. */}
              {step.note && <span class="journey__note">{step.note}</span>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/*
    THE JOURNEY 가 "제품이 놓이는 자리" 로 끝납니다. 그 자리를 글로만 두지
    않고 한 장으로 받습니다 — 운동이 끝난 뒤, 아직 물기가 남은 시간.

    뒷모습입니다. 얼굴이 크게 나오면 모델 사진이 되고, 그러면 "삶이 주인공"
    이라던 앞의 다섯 단계와 어긋납니다.
  */}
  <figure class="figure rise">
    <Picture
      src={surfImage}
      alt={h.journey.imageAlt}
      formats={['avif', 'webp']}
      widths={[390, 780, 1200]}
      sizes="100vw"
      quality={62}
      loading="lazy"
      decoding="async"
    />
    <figcaption>SURF</figcaption>
  </figure>

  {/*
    브랜드 브릿지.

    Origin·The Question·Philosophy 는 `/brand` 로 옮겼습니다. 완전히 끊으면
    홈에서 브랜드 맥락이 사라지므로 한 단락만 남깁니다.

    **문구는 새로 짓지 않았습니다.** Origin 의 선언 문장을 그대로 씁니다 —
    같은 문장이 `/brand` 첫머리에도 있고, 그게 두 화면을 잇는 고리입니다.
  */}
  {/*
    AVORA LABS — 회사.

    지금까지 이 사이트에는 **회사가 없었습니다.** 브랜드와 제품 이야기만 있고,
    누가 왜 이걸 하는지는 푸터의 사업자정보가 전부였습니다.

    ── 여기 있는 것과 없는 것 ─────────────────────────────────
    화면에 적은 두 문장은 **이미 공개된 값** 입니다 — Organization 구조화
    데이터의 slogan 과 제품 FAQ 가 같은 말을 하고 있습니다.

    창업 배경·대표자 사진·팀 규모 표현은 담당자에게 받아야 하는 것이라
    `src/config/company.ts` 에 자리만 두었습니다. **비어 있는 동안에는 그
    문단이 아예 나오지 않습니다.** 회색 플레이스홀더 상자를 놓지 않습니다.

    사진이 들어오면 `FOUNDER_PHOTO` 한 줄로 2열이 됩니다 —
    `.section--split` 의 auto-fit 이 자식 수를 보고 칸을 정합니다.

    인스타그램을 여기 둡니다. 푸터에만 있으면 "살아 있는 회사" 라는 신호가
    본문 어디에도 없습니다.
  */}
  <section class="section section--alt section--split wrap rise" data-section="company">
    <div class="split">
      <div>
        <p class="kicker">{h.company.kicker}</p>
        <h2 class="display display--tight">{h.company.lead}</h2>

        {/*
          세 블록 — 회사 · 만든 사람 · 규모.

          ⚠️ **[2] 와 [3] 은 담당자 원고를 기다리는 자리입니다.** 창업 배경과
          팀 규모는 지어낼 수 없고, 지시서도 그 둘을 확인 항목으로 남겼습니다.
          값이 없으면 이름표만 남기고 "기다리고 있습니다" 를 적습니다 —
          섹션을 통째로 숨기면 그 자리가 있어야 한다는 사실 자체를 잊습니다.

          설립 연도도 같은 이유로 비어 있습니다(`config/company.ts` 의
          `FOUNDED`). "2026년 서울" 은 지시서에 있지만 같은 문서가 그것을
          확인 항목으로 두었습니다.
        */}
        <div class="blocks">
          <div class="blocks__item">
            <h3 class="blocks__label">{h.company.blocks.company}</h3>
            <p class="body">{h.company.body}</p>
            <p class="body" style="margin-top: 12px">{h.company.etymology}</p>
          </div>

          <div class="blocks__item">
            <h3 class="blocks__label">{h.company.blocks.founder}</h3>
            {founderStory
              ? <p class="body">{founderStory}</p>
              : <p class="blocks__awaiting">{h.company.awaiting}</p>}
          </div>

          <div class="blocks__item">
            <h3 class="blocks__label">{h.company.blocks.scale}</h3>
            {teamSize
              ? <p class="body">{teamSize}</p>
              : <p class="blocks__awaiting">{h.company.awaiting}</p>}
          </div>
        </div>

        {
          SOCIAL.instagramUrl && (
            <p style="margin-top: 26px">
              {/* tapLink — 손가락으로 누를 수 있는 높이를 보장합니다(D 모바일 규칙). */}
              <a class="tapLink" href={SOCIAL.instagramUrl} rel="me noopener" target="_blank">
                {h.company.instagram}
                <span class="company__handle">{SOCIAL.instagramHandle}</span>
              </a>
            </p>
          )
        }
      </div>
      {
        founderPhoto && (
          <Picture
            src={founderPhoto}
            alt={FOUNDER_PHOTO_ALT[locale] ?? ''}
            formats={['avif', 'webp']}
            widths={[390, 780]}
            sizes="(max-width: 900px) 100vw, 50vw"
            quality={62}
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
  </section>

  {/*
    홈 FAQ — 셋만.

    제품 페이지에도 FAQ 가 있지만, **가장 먼저 떠오르는 의문은 홈에서** 답해야
    합니다. 홈에서 "기성 처방" 을 읽은 사람이 그 자리에서 갖는 질문이라,
    제품 페이지까지 가야 답이 있으면 대부분은 가기 전에 나갑니다.

    ── 접지 않습니다 ─────────────────────────────────────────
    셋뿐이고, 접으면 읽히지 않습니다. 답변엔진이 접힌 내용을 본문으로 보지
    않을 수 있다는 문제도 제품 페이지 FAQ 와 같습니다.

    ── 구조화 데이터는 여기서 내지 않습니다 ────────────────────
    이 사이트는 FAQPage 를 **고객센터 한 곳에서만** 냅니다. 같은 주제로 여러
    페이지가 FAQPage 를 내면 검색에서 서로 갉아먹고, 답변엔진은 어느 쪽을
    인용할지 모릅니다(제품 페이지 FAQ 주석 참조). 그 결정을 여기서 혼자
    뒤집지 않았습니다 — 담당자 확인 대기 항목입니다.
  */}
  <section class="section wrap wrap--narrow rise" data-section="home_faq">
    <p class="kicker">{h.faq.kicker}</p>
    <h2 class="display display--tight">{h.faq.heading}</h2>
    <dl class="homeFaq">
      {
        h.faq.items.map((item) => (
          <div>
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))
      }
    </dl>
    <p class="homeFaq__more">
      <a class="tapLink" href={localePath(locale, 'panel')}>{h.faq.panelLink}</a>
      <a class="tapLink" href={`${localePath(locale, 'product')}#faq`}>{h.faq.more}</a>
    </p>
  </section>

  {/*
    우리가 하지 않기로 한 것.

    ── 왜 FAQ 다음인가 ────────────────────────────────────────
    FAQ 는 손님이 묻는 것에 답하는 자리입니다. 여기는 **묻지 않은 것** 을
    먼저 말하는 자리라, 바로 뒤에 오는 편이 대비가 섭니다. 브랜드 브릿지
    앞이기도 해서, `/brand` 로 넘어가기 직전에 태도가 한 번 정리됩니다.

    ── 홈에만 둡니다 ──────────────────────────────────────────
    브랜드 페이지에 같은 목록을 또 두면 두 곳 다 약해집니다. `/brand` 의
    "어떻게 만드는가" 가 **하는 것** 을 말하고, 여기가 **하지 않는 것** 을
    말합니다. 둘은 같은 이야기의 앞뒤라 한 번씩만 있어야 합니다.

    ── 숫자 두 개를 지웠습니다 ────────────────────────────────
    지시서의 원문은 두 번째 항목에 "92%, 240분 같은 숫자는" 이라고 적어
    **하지 않을 일의 예시** 로 들었습니다. 뜻은 분명하지만, 그러면 그
    숫자가 홈 화면에 실제로 인쇄됩니다.

    이 사이트는 답변엔진이 읽는 것을 전제로 만들어졌습니다. 조각을 떼어
    인용하는 쪽에서 "92%" 는 **부정 예시라는 맥락 없이** 나갈 수 있고,
    그건 이 항목이 막으려던 바로 그 일입니다. 뜻을 그대로 두고 예시만
    "지속 시간이나 만족도 같은 숫자" 로 바꿨습니다.
  */}
  <section class="section section--alt wrap wrap--narrow rise" data-section="limits">
    <p class="kicker">{h.limits.kicker}</p>
    <h2 class="display display--tight">{h.limits.heading}</h2>
    <ul class="limits">
      {
        h.limits.items.map((item) => (
          <li>
            <strong class="limits__claim">{item.claim}</strong>
            <span class="limits__why">{item.why}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    읽을거리 — 최근 세 편.

    이 브랜드의 홈은 한 번 읽고 이메일을 남기면 끝이라, 다시 올 이유가
    타임라인의 일정뿐이었습니다. 글이 쌓이면 그게 두 번째 이유가 됩니다.

    **글이 없으면 섹션도 없습니다.** 지금은 두 편 다 초안이라 화면에
    나오지 않습니다.
  */}
  {latestPosts.length > 0 && (
    <section class="section wrap wrap--narrow rise" data-section="journal">
      <p class="kicker">{t.nav.journal}</p>
      <h2 class="display display--tight">{t.journal.heading}</h2>
      <PostList locale={locale} category="journal" posts={latestPosts} empty={t.journal.empty} />
      <p class="postList__back">
        <a class="tapLink" href={localePath(locale, BASE.journal)}>{t.journal.more}</a>
      </p>
    </section>
  )}

  <section class="section wrap wrap--narrow rise" data-section="brand_bridge">
    <p class="kicker">{h.origin.kicker}</p>
    <p class="display display--tight">
      {h.origin.statementBefore}<span class="mark">{h.origin.statementEmphasis}</span>{
        h.origin.statementAfter
      }
    </p>
    <p style="margin-top: 26px">
      <a
        class="btn btn--secondary"
        href={localePath(locale, 'brand')}
        data-brand-link
      >{t.brand.bridgeLink}</a>
    </p>
  </section>

  {/*
    하단 고정 CTA + 신청 시트.

    이 페이지는 12개 섹션입니다. 검증단 섹션(7번째)의 폼 아래로는 다섯
    섹션 동안 신청할 자리가 없었습니다 — 타임라인·첫 제품·여정·회사 소개·
    FAQ 를 다 읽고 마음이 움직인 사람이 할 수 있는 일이 다시 위로 올라가는
    것뿐이었습니다.

    폼과 같은 게이트를 씁니다. 팔기 시작하면 알림 신청 자체가 사라지므로
    바도 함께 사라져야 합니다.

    마크업 위치가 문서 끝인 이유: `position: fixed` 라 자리는 화면이
    정하지만, 탭 순서는 문서 순서가 정합니다. 본문을 다 지난 뒤에 오는
    것이 맞습니다.
  */}
  {
    !CAN_ORDER && (
      <StickyNotify
        locale={locale}
        heading={h.notify.hero.heading}
        body={h.notify.hero.body}
      />
    )
  }

</Base>

<script>
  import { mountLaunchNotify } from '../../lib/launch-notify';
  import { mountSectionView } from '../../lib/section-view';
  import { mountHeroCta } from '../../lib/hero-cta';
  import { mountStoryAnchor } from '../../lib/story-anchor';

  // 홈에는 폼이 셋입니다 — 첫 화면, 검증단 섹션, 그리고 하단 시트.
  // mountLaunchNotify 가 querySelectorAll 로 전부 연결합니다. 시트 안의
  // 폼도 문서에 이미 있으므로(열릴 때 만들어지지 않습니다) 여기서 함께
  // 걸립니다.
  mountLaunchNotify();

  // 어느 섹션까지 읽히는가. 계측이 꺼져 있으면 아무것도 하지 않습니다.
  mountSectionView();

  // 첫 화면의 버튼 → 폼. 없으면 링크가 그대로 동작합니다.
  mountHeroCta();

  // 밖에 공유된 #story 링크를 /brand 로 넘깁니다.
  mountStoryAnchor();
</script>
