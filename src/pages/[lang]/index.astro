---
/**
 * 홈 — 원페이지 스토리 스크롤 (시안 01 Minimal Editorial)
 *
 * 섹션 순서가 곧 서사입니다: 왜 이 브랜드인가 → 그래서 이 제품.
 * 순서를 바꾸면 스크롤이 전달하는 이야기가 무너집니다.
 */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import heroImage from '../../assets/images/hero-runner-sunrise.jpg';
import skinImage from '../../assets/images/skin-sweat.jpg';
import { BUSINESS, SOCIAL, LOCALES, type Locale } from '../../config/site';
import { FOUNDER_PHOTO, FOUNDER_PHOTO_ALT, FOUNDER_STORY } from '../../config/company';
import { dict, localePath } from '../../i18n';
import { organization, website, breadcrumb } from '../../lib/jsonld';
import LaunchNotify from '../../components/LaunchNotify.astro';
import StickyNotify from '../../components/StickyNotify.astro';
import CriteriaTable from '../../components/CriteriaTable.astro';
import { CAN_ORDER } from '../../config/runtime';
import { TIMELINE_DATES, stepStates } from '../../config/timeline';
import { compareRows } from '../../lib/spec';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const h = t.home;

/*
 * 타임라인 진행 상태는 **빌드 시각 기준**으로 정합니다.
 *
 * 손으로 적으면 시간이 지나며 반드시 어긋납니다 — 그게 이 화면이 모집 전에
 * "진행중" 이라고 말하고 있던 이유입니다. 배포할 때마다 다시 계산되므로,
 * 남는 어긋남은 "마지막 배포 이후 지난 시간" 만큼입니다.
 *
 * 날짜와 문구가 따로 있으므로 개수가 어긋나면 다른 단계의 날짜가 붙습니다.
 * 조용히 틀리느니 빌드를 멈춥니다.
 */
if (TIMELINE_DATES.length !== h.timeline.steps.length) {
  throw new Error(
    `타임라인 날짜 ${TIMELINE_DATES.length}개 ≠ ${locale} 문구 ${h.timeline.steps.length}개 ` +
      '— config/timeline.ts 와 i18n 의 home.timeline.steps 를 함께 고치세요.',
  );
}
const states = stepStates(new Date());

/*
 * 확정/미확정 판정은 `src/lib/spec.ts` 가 합니다 — 제품 페이지 스펙표와
 * 같은 출처입니다. 두 화면이 각자 판정하면 언젠가 한쪽만 고쳐집니다.
 */
const { settled, unsettled } = compareRows(t);

/*
 * 배점과 커트라인은 **`/panel` 과 같은 원본을 읽습니다.**
 *
 * 홈 카피가 "눈 시림 30점, 백탁 25점" 을 문장으로 말합니다. 숫자를 홈에 따로
 * 적어 두면 언젠가 한쪽만 고쳐지고, 그 순간 카피가 거짓말이 됩니다. 홈은
 * 짧은 이름과 확인 방법만 갖고, 숫자는 `/panel` 에서 그대로 가져옵니다.
 *
 * 두 목록이 어긋나면 **빌드를 멈춥니다.** 조용히 짧은 쪽만 그리면 표에서
 * 항목이 사라진 것을 아무도 모른 채 배포됩니다.
 */
/*
 * 회사 소개의 두 선택 블록.
 *
 * 담당자 원고가 오기 전까지 둘 다 비어 있고, 비어 있으면 화면에 나오지
 * 않습니다(`src/config/company.ts`).
 */
const founderStory = FOUNDER_STORY[locale] ?? null;

/*
 * 사진은 **파일이 생기는 순간 동작합니다.**
 *
 * Astro 의 이미지 최적화는 정적 import 를 요구해서 파일명을 변수로 넘길 수
 * 없습니다. `import.meta.glob` 이 그 사이를 메웁니다 — 맞는 파일이 없으면 빈
 * 객체라 빌드가 깨지지 않고, 담당자가 `founder.jpg` 를 넣고 설정 한 줄만
 * 바꾸면 코드를 고치지 않아도 2열이 됩니다.
 */
const founderPhotos = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/founder.{jpg,jpeg,png,webp}',
  { eager: true },
);
const founderPhoto = FOUNDER_PHOTO
  ? (founderPhotos[`../../assets/images/${FOUNDER_PHOTO}`]?.default ?? null)
  : null;

const scoring = t.panel.criteria;

/*
 * 두 목록을 **id 로** 잇습니다.
 *
 * 처음에는 개수만 보고 인덱스로 짝지었습니다. 그러면 어느 한쪽에서 행 순서만
 * 바꿔도 개수는 그대로라 통과하고, **재도포에 흡수 속도의 점수가 조용히
 * 붙습니다.** 라벨이 서로 달라서("눈 시림" vs "눈 시림 없음") 이름으로 맞출
 * 수도 없습니다. 그래서 눈에 보이지 않는 id 를 양쪽에 두고 그것으로 잇습니다.
 *
 * 짝을 못 찾으면 **빌드를 멈춥니다.** 조용히 잘못 붙은 점수는 화면을 봐도
 * 알 수 없습니다 — 아는 사람만 아는 오류가 됩니다.
 */
const byId = new Map(scoring.rows.map((row) => [row.id, row]));
const criteriaRows = h.panel.criteria.map((item) => {
  const row = byId.get(item.id);
  if (!row) {
    throw new Error(
      `[${locale}] 홈 평가 기준 "${item.id}" 에 맞는 /panel 배점이 없습니다 — ` +
        `한쪽 목록만 고쳤는지 확인하세요 (있는 id: ${[...byId.keys()].join(', ')}).`,
    );
  }
  return { term: item.term, how: item.body, score: row.score, cut: row.cut };
});
---

<Base
  locale={locale}
  path=""
  title={h.meta.title}
  description={h.meta.description}
  ogImageAlt={h.meta.ogAlt}
  jsonLd={[
    organization(),
    website(locale),
    breadcrumb([{ name: BUSINESS.brandName, path: localePath(locale) }]),
  ]}
>
  {/* Hero */}
  <section class="hero" data-section="hero">
    <div class="hero__media">
      {/*
        `sizes` 가 `100vw` 가 아닌 이유.

        이 사진은 가로 1600×1049(비율 1.53)인데, 휴대폰에서 히어로는 세로로
        깁니다(390×579, 비율 0.67). `object-fit: cover` 는 **높이를 채우려고**
        사진을 키우므로, 화면에 390px 만 보여도 브라우저가 그려야 하는 사진의
        실제 폭은 1600 × (579/1049) ≈ 883px 입니다. 화면 폭의 2.3배입니다.

        `100vw` 라고 적으면 브라우저는 390px 만 있으면 된다고 믿고 780w 를
        받아 2.3배로 늘려 그립니다. **첫 화면에서 가장 큰 이미지가 모든
        휴대폰에서 뭉개져 보입니다.**

        아래 값은 각 구간에서 필요한 배율입니다:
          390×579  → 1.53 × (579/390) = 2.27  →  240vw
          700×635  → 1.53 × (635/700) = 1.38  →  150vw
          970px 부터는 폭이 높이를 덮으므로 100vw 가 맞습니다.

        휴대폰이 780w(AVIF 11KB) 대신 1600w(32KB)를 받게 됩니다. 21KB 를 더
        쓰고 첫 화면을 선명하게 가져가는 쪽을 택했습니다.
      */}
      <Picture
        src={heroImage}
        alt={h.hero.imageAlt}
        formats={['avif', 'webp']}
        widths={[390, 780, 1200, 1600]}
        sizes="(max-width: 700px) 240vw, (max-width: 970px) 150vw, 100vw"
        quality={70}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="hero__veil"></div>
    <div class="hero__copy">
      <h1 class="hero__thin">For every movement.</h1>
      <p class="hero__bold">MOVE. SWEAT. REAPPLY.</p>
      {/*
        2차 메시지 — 왜 이 브랜드인가.

        기획안 2-2-4 의 위계는 1차(태그라인) → **2차 근거** → 3차 스펙입니다.
        그동안 이 문장은 홈 여덟 번째 섹션에만 있었습니다. 모바일에서 40%
        지점에 이탈하는 사람은 PAROS 가 왜 다른지 모른 채 떠났습니다.

        태그라인보다 작고 출시 예정 문구보다 큽니다 — 위계가 셋이라는 것이
        크기로도 읽혀야 합니다.
      */}
      <p class="hero__promise">{h.hero.promise}</p>

      {/*
        첫 화면의 행동 지점.

        ── 왜 필요한가 ──────────────────────────────────────────
        폼은 히어로 바로 아래에 있지만, 실측하면 **iPhone 14(390×844)에서
        제출 버튼이 884px** 입니다. 폴드가 844px 이므로 첫 화면에는 입력칸
        테두리 한 줄만 걸칩니다. 데스크톱에서는 폼이 폴드 위에 들어오지만
        세로로 긴 휴대폰에서는 그렇지 않았습니다.

        ── 왜 바텀시트가 아닌가 ────────────────────────────────
        지시서 B2 는 폼을 시트로 올리라고 했습니다. 그러면 첫 화면은
        깨끗해지지만 **탭이 하나 늘어납니다** — 버튼을 누르고, 그다음
        입력칸을 눌러야 합니다. 이 사이트의 유일한 목표가 이메일 한 줄을
        받는 것이라 그 한 번이 비쌉니다. 자바스크립트가 없으면 폼에 닿을
        수 없다는 것도 문제고, 시트 안의 문구는 답변엔진이 본문으로 보지
        않을 수 있습니다.

        여기서는 **이득만** 가져옵니다. 버튼은 첫 화면에 있고, 폼은 있던
        자리에 그대로 있습니다.

        ── 왜 링크인가 ─────────────────────────────────────────
        `<a href="#notify">` 는 자바스크립트가 없어도 그 자리로 데려갑니다.
        스크립트는 부드럽게 움직이고 입력칸에 초점을 잡아 주는 것까지만
        얹습니다(src/lib/hero-cta.ts).

        문구는 폼의 제출 버튼과 **같은 문자열**(notify.submit)을 씁니다.
        같은 약속이므로 둘이 갈라지면 안 되고, 새 문구를 만들면 5개 언어에
        검수받지 않은 줄이 다섯 개 생깁니다.

        **다만 이 화면에는 같은 이름을 가진 조작점이 셋입니다** — 이 링크와,
        폼이 둘(첫 화면·검증단 섹션)이라 제출 버튼도 둘입니다. 스크린리더는
        링크와 버튼을 역할로 가르지만, 두 제출 버튼끼리는 그것으로 갈리지
        않습니다. 음성으로 조작하는 사람에게는 후보가 셋으로 잡힙니다.

        지금은 그대로 둡니다. 문구를 새로 만들면 검수받지 않은 번역이 늘고,
        `aria-label` 로 덧붙이면 화면에 보이는 글자와 읽히는 이름이 달라져
        음성 조작이 오히려 어려워집니다(WCAG 2.5.3). 폼을 하나로 줄이는 것이
        올바른 해결이고, 그건 이 변경의 범위 밖입니다.
      */}
      {!CAN_ORDER && (
        <a class="btn hero__cta" href="#notify" data-hero-cta>
          {t.notify.submit}
        </a>
      )}
    </div>
  </section>

  {/*
    첫 화면의 신청 자리.

    ── 왜 사진 안이 아니라 바로 아래인가 ──────────────────────
    브랜드 첫인상을 깎아 폼을 밀어 넣지 않습니다. 사진과 헤드라인은 그대로
    두고 바로 아래에 놓아, 스크롤 한 번 안에 둘 다 들어오게 합니다.

    ── 왜 홈에도 두는가 ───────────────────────────────────────
    커뮤니티(러닝 크루·클라이밍짐)에서 링크를 타고 온 사람이 스토리를 끝까지
    다 읽을 확률보다, 첫 화면에서 이메일을 남길 확률이 높습니다.
    홈화면의 역할은 명단을 만드는 것이 아니라 **놓치지 않는** 것입니다.

    출시 시기를 먼저 밝히는 이유: "왜 지금 살 수 없는가" 에 답하지 않으면
    이메일 폼이 뜬금없습니다. 2027년 상반기라고 말하는 순간 설명되는
    요청이 됩니다.
  */}
  {
    !CAN_ORDER && (
      <section class="section section--attach wrap heroNotify" id="notify" data-section="hero_notify">
        <p class="product-hero__window">{t.product.hero.launchWindow}</p>
        <LaunchNotify
          locale={locale}
          source="home-hero"
          heading={h.notify.hero.heading}
          body={h.notify.hero.body}
        />
      </section>
    )
  }

  {/*
    ── 섹션 순서에 대하여 ─────────────────────────────────────
    기획안 2-2-4 의 메시지 위계는 1차(히어로 태그라인) → **2차 근거** →
    3차 스펙입니다. 예전에는 브랜드 서사(Origin·Question·Philosophy)가
    앞에 있고 근거(The Choice)가 여덟 번째였습니다. 모바일에서 40% 지점에
    이탈하는 방문자는 PAROS 가 왜 다른지 모른 채 떠났습니다.

    **서사를 지운 것이 아닙니다.** 잘 쓰인 글이지만 *이미 관심이 생긴
    사람이 읽는 것* 이라 뒤로 보냈습니다.

    Brand Promise(4가지 감각)는 제품 페이지로 옮겼습니다. 홈에 4개짜리와
    5개짜리 프레임워크가 연달아 나오면 어느 쪽도 기억에 남지 않습니다.
  */}

  {/*
    The Choice — 2차 근거

    기획안 2-2-4 의 메시지 위계는 1차 헤드라인(히어로의 FOR EVERY MOVEMENT)
    → **2차 근거** → 3차 스펙입니다. 그동안 이 사이트에는 1차와 3차만 있고
    가운데가 비어 있었습니다. 스펙만으로는 근거가 서지 않습니다 — 눈 시림·
    백탁·스웨트프루프는 이미 경쟁 브랜드가 수치까지 붙여 선점한 언어라,
    같은 말을 하면 뒤늦게 따라 하는 쪽으로 읽힙니다(기획안 1-4-5).

    그래서 근거를 제품이 아니라 **고르는 과정** 에 둡니다. 이 두 섹션이
    그 근거층이고, 스펙(First Product) 바로 위에 있어야 위계가 맞습니다.
  */}
  {/*
    차별점 선언.

    어두운 밴드를 여기에 둡니다. 원래 검증단 섹션에 두려 했는데, 거기에는
    신청 폼이 들어 있어 입력칸·동의 문구·안내가 전부 어두운 지반 위로 올라
    갑니다 — 실측으로 17개 요소가 1.75:1 이었습니다. 폼 하나를 위해 색을
    전부 뒤집는 것보다, **글만 있는 섹션** 에 밴드를 두는 편이 안전합니다.

    이 자리도 나쁘지 않습니다. 히어로 다음 첫 선언이라 무게가 필요합니다.
  */}
  {/*
    문제 제기.

    히어로가 "무엇인지" 를 말했고 다음 섹션이 "어떻게" 를 말합니다. 그 사이에
    **왜 이것이 있어야 하는가** 가 없으면 방법 선언이 허공에 뜹니다.

    짧게 둡니다 — 서사는 /brand 의 몫이고, 여기서 길어지면 바로 아래
    The Choice 가 밀립니다. 그리고 **어느 브랜드도 지목하지 않습니다.**
    카테고리 전체에 대한 서술로만 남깁니다(00-공통규칙 2-2).
  */}
  <section class="section wrap wrap--narrow rise" data-section="the_problem">
    <p class="kicker">{h.problem.kicker}</p>
    <h2 class="display display--tight">{h.problem.lead}</h2>
    <p class="body" style="margin-top: 26px">{h.problem.body}</p>
    <p class="body" style="margin-top: 18px">{h.problem.close}</p>
  </section>

  <section class="section section--lg section--dark wrap wrap--narrow rise" data-section="the_choice">
    <p class="kicker">{h.choice.kicker}</p>
    <h2 class="display display--tight">{h.choice.lead}</h2>
    <p class="body" style="margin-top: 26px">{h.choice.body}</p>
    <p class="body" style="margin-top: 18px">{h.choice.body2}</p>
    <p class="body" style="margin-top: 18px">{h.choice.body3}</p>
  </section>

  {/*
    Test Panel — 검증단

    id 를 두는 이유: 기획안 8-2-1 은 인스타그램 프로필 링크를 "자사몰 출시
    알림 신청 페이지" 로 고정하라고 합니다. 10월 검증단 모집이 시작되면 그
    링크를 이 자리로 바로 보낼 수 있어야 합니다.
  */}
  {/*
    평가 기준 — 검증단에서 떼어낸 독립 섹션.

    한 섹션은 하나의 역할만 갖습니다(J2). 앞 섹션이 "방법" 을 선언했고,
    여기가 그 **근거** 이고, 다음이 "누가 매기는가" 입니다. 셋이 한 덩어리로
    붙어 있으면 배점표가 검증단 모집의 부속물처럼 읽힙니다.

    배경은 교차용입니다 — 위가 어두운 면이고 아래 둘이 기본 지반이라,
    여기까지 기본 지반이면 같은 배경이 셋 이어집니다(Phase I 규칙).
  */}
  <section class="section section--alt wrap rise" data-section="criteria">
    <h2 class="kicker">{h.panel.criteriaHeading}</h2>
    {/*
      배점과 커트라인을 홈에도 적습니다.

      바로 위 The Choice 가 "여섯 가지 항목, 100점 만점. 눈 시림 30점,
      백탁 25점" 이라고 말합니다. 표에 숫자가 없으면 그 문장이 근거 없는
      주장이 됩니다 — 답변 엔진이 인용할 수 있는 형태로 같은 화면에 둡니다.

      `/panel` 의 배점표와 **같은 컴포넌트·같은 원본** 입니다. 좁은 화면에서
      행마다 카드로 쌓는 것도 그쪽에서 이미 풀어 둔 방식입니다.
    */}
    <CriteriaTable columns={scoring.columns} rows={criteriaRows} />
  </section>

  <section class="section section--lg wrap rise" id="panel" data-section="test_panel">
    <p class="kicker">{h.panel.kicker}</p>
    <h2 class="display display--tight">{h.panel.lead}</h2>
    <p class="body" style="margin-top: 26px">{h.panel.body}</p>


    <p class="body" style="margin-top: 24px">{h.panel.note}</p>

    {/*
      검증단 모집 페이지로 가는 길.

      **이 링크가 없으면 /panel 에 아무도 들어가지 못합니다.** 10월에 크루
      단톡방으로 뿌릴 주소는 그쪽이지만, 사이트를 둘러보다 관심이 생긴
      사람에게도 길이 있어야 합니다.

      알림 신청 폼보다 위에 둡니다 — 방금 검증단 이야기를 읽은 사람에게
      "지원하기" 가 "소식 받기" 보다 앞선 행동입니다.
    */}
    <p style="margin-top: 26px">
      <a class="cta" href={localePath(locale, 'panel')}>{h.panel.cta}</a>
    </p>

    {/*
      두 번째 신청 자리.

      폴드 아래도 열람 시간의 43% 를 받습니다(NN/g 2018). 검증단 이야기를 읽은 사람에게 다시 묻지 않는 것은 그냥 버리는 것입니다.

      ── 왜 First Product 가 아니라 여기인가 ────────────────────
      전에는 이 폼이 제품 섹션 안에 있었습니다. 옮긴 이유는 요청할 것이
      생겼기 때문입니다. 기획안 2-2-2 는 검증단을 "알림 신청자 명단의
      시작점" 으로 잡고 있습니다. 방금 검증단 이야기를 읽은 사람에게
      모집 소식을 받겠냐고 묻는 것이, 제품 스펙 옆에서 묻는 것보다
      맥락이 맞습니다.

      source 는 home-end 를 그대로 둡니다 — 자리는 바뀌었어도 "홈의 두 번째 폼" 이라는 역할은 같고, 값을 바꾸면 이전 신청 건과 끊깁니다.
    */}
    {
      !CAN_ORDER && (
        <LaunchNotify
          locale={locale}
          source="home-end"
          heading={h.notify.end.heading}
          body={h.notify.end.body}
        />
      )
    }
  </section>

  {/*
    타임라인.

    이 브랜드의 자산은 시간에 따라 쌓이는 집계입니다. 그런데 한 번 읽고
    이메일을 남기면 끝이라 다시 올 이유가 없었습니다. 무엇이 언제 일어나는지
    적어 두면, 12월 집계 공개를 기다릴 이유가 생깁니다.

    **숫자를 지어내지 않습니다.** 여기 있는 것은 일정뿐이고, 집계 결과는
    실제 데이터가 나온 뒤에 붙습니다(C4 의 집계판).
  */}
  {/*
    ⚠️ 진행 상태를 **손으로 적지 않습니다.**

    전에는 i18n 에 `state: "진행중"` 이 박혀 있고 강조도 `i === 0` 이었습니다.
    그래서 모집이 시작하지도 않은 2026년 9월에 화면이 "진행중" 이라고 말했고,
    `llms.txt` 가 적어 둔 "Recruiting opens in October 2026" 을 정면으로
    뒤집고 있었습니다. 답변엔진은 화면을 먼저 읽습니다.

    날짜는 `config/timeline.ts` 에 한 벌만 두고 여기서 오늘과 비교합니다.
    문구(`2026.10` · `Oct 2026`)는 언어마다 다르므로 i18n 에 남습니다.
  */}
  <section class="section wrap rise" data-section="timeline">
    <p class="kicker">{h.timeline.kicker}</p>
    <ol class="timeline">
      {
        h.timeline.steps.map((step, i) => {
          const state = states[i];
          return (
            <li class={state === 'active' ? 'timeline__now' : undefined}>
              {/*
                `when` 은 언어마다 표기가 갈립니다. 기계가 읽는 값은
                `datetime` 에 ISO 로 한 번만 적습니다.
              */}
              <time class="timeline__when" datetime={TIMELINE_DATES[i]}>{step.when}</time>
              <span class="timeline__what">{step.what}</span>
              {/*
                지나간 단계에는 배지를 그리지 않습니다 — "완료" 에 해당하는
                문구가 다섯 언어 어디에도 없고, 지어내면 검수받지 않은 줄이
                다섯 개 늘어납니다. 이유는 `config/timeline.ts` 에 있습니다.
              */}
              {state !== 'past' && (
                <span class="timeline__state">{h.timeline.states[state]}</span>
              )}
            </li>
          );
        })
      }
    </ol>
  </section>

  {/*
    First Product — 3차 스펙

    폼이 앞 섹션으로 옮겨가면서 여기는 제품 페이지로 가는 길 하나만
    남았습니다. 그래서 "제품 보기" 를 보조 형태(cta--ghost)로 내릴 이유가
    없어졌습니다 — 이 섹션에서 유일하게 할 수 있는 일입니다.
  */}
  <section class="section section--alt wrap rise" data-section="first_product">
    <p class="kicker">{h.product.kicker}</p>
    <h2 class="display display--tight">{h.product.name}</h2>
    <p class="body" style="margin-top: 14px">{h.product.table.why}</p>

    {/*
      확정된 것과 아직 아닌 것을 나란히 놓습니다. **정직성이 시각적으로
      드러나는 자리** 입니다.

      ⚠️ **오른쪽 열을 값으로 채우지 마세요. 비어 있는 것이 요점입니다.**
      적히는 것은 값이 아니라 *무엇을 기다리는지* 입니다.

      ── 어느 쪽에 놓을지는 여기서 정하지 않습니다 ──────────────
      `product.json` 의 `spec` 과 `$pending` 이 정합니다. 제품 페이지가 읽는
      것과 같은 출처라, 홈이 "SPF50+ 확정" 이라고 하고 제품 페이지가 "목표"
      라고 하는 일이 **구조적으로 생길 수 없습니다.** 한때 홈이 "워터리 젤",
      스펙표가 "로션·밀크" 라고 동시에 말한 적이 있습니다.

      기능성화장품은 심사·보고가 남아 있어 차단지수를 확정으로 적으면
      표시·광고 문제가 됩니다(00-공통규칙 2-2).
    */}
    <div class="compare">
      <div class="compare__col">
        <h3 class="compare__head">{h.product.table.confirmed}</h3>
        <dl class="compare__list">
          {settled.map((row) => (
            <div class="compare__row">
              <dt>{row.key}</dt>
              <dd class="compare__value">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="compare__col">
        <h3 class="compare__head">{h.product.table.pending}</h3>
        <dl class="compare__list">
          {unsettled.map((row) => (
            <div class="compare__row">
              <dt>{row.key}</dt>
              <dd class="compare__wait">{row.wait}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <p class="compare__note">{h.product.table.note}</p>

    <p style="margin-top: 30px">
      <a class="cta" href={localePath(locale, 'product')}>
        {h.product.cta}
      </a>
    </p>
  </section>
  {/*
    시각적 쉼표.

    ⚠️ **이 그림만 품질이 낮습니다.** 다른 사진과 같은 52 로 두면 780w AVIF 가
    103KB 로, 히어로(1600w, 33KB)의 세 배가 됩니다 — 홈에서 가장 무거운 자기
    도메인 자산이 LCP 도 아닌 장식 밴드인 상태였습니다.

    원인은 인코더가 아니라 원본입니다. 물방울 맺힌 피부 클로즈업이라 화면 전체가
    고주파 노이즈고, AVIF 가 그것을 성실히 담습니다. 그런데 **같은 노이즈가
    압축 아티팩트도 가립니다** — 40 으로 내려 60KB(-42%)가 됐고, 실제로 보이는
    크롭을 나란히 놓고 봐도 구분되지 않습니다.

    다른 사진에 이 값을 복사하지 마세요. 매끈한 면이 넓은 그림은 같은 값에서
    띠가 보입니다.
  */}
  <figure class="figure rise">
    <Picture
      src={skinImage}
      alt={h.break.imageAlt}
      formats={['avif', 'webp']}
      widths={[390, 780]}
      sizes="100vw"
      quality={40}
      loading="lazy"
      decoding="async"
    />
    <figcaption>SKIN</figcaption>
  </figure>

  {/* The Journey — 5단계 여정 */}
  <section class="section section--dark wrap rise" data-section="the_journey">
    <p class="kicker">{h.journey.kicker}</p>
    <h2 class="display display--tight">{h.journey.lead}</h2>
    <ol class="journey">
      {
        h.journey.steps.map((step, i) => (
          <li>
            <span class="journey__step">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <strong class="journey__word">{step.word}</strong>
              <span class="journey__body">{step.body}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/*
    브랜드 브릿지.

    Origin·The Question·Philosophy 는 `/brand` 로 옮겼습니다. 완전히 끊으면
    홈에서 브랜드 맥락이 사라지므로 한 단락만 남깁니다.

    **문구는 새로 짓지 않았습니다.** Origin 의 선언 문장을 그대로 씁니다 —
    같은 문장이 `/brand` 첫머리에도 있고, 그게 두 화면을 잇는 고리입니다.
  */}
  {/*
    AVORA LABS — 회사.

    지금까지 이 사이트에는 **회사가 없었습니다.** 브랜드와 제품 이야기만 있고,
    누가 왜 이걸 하는지는 푸터의 사업자정보가 전부였습니다.

    ── 여기 있는 것과 없는 것 ─────────────────────────────────
    화면에 적은 두 문장은 **이미 공개된 값** 입니다 — Organization 구조화
    데이터의 slogan 과 제품 FAQ 가 같은 말을 하고 있습니다.

    창업 배경·대표자 사진·팀 규모 표현은 담당자에게 받아야 하는 것이라
    `src/config/company.ts` 에 자리만 두었습니다. **비어 있는 동안에는 그
    문단이 아예 나오지 않습니다.** 회색 플레이스홀더 상자를 놓지 않습니다.

    사진이 들어오면 `FOUNDER_PHOTO` 한 줄로 2열이 됩니다 —
    `.section--split` 의 auto-fit 이 자식 수를 보고 칸을 정합니다.

    인스타그램을 여기 둡니다. 푸터에만 있으면 "살아 있는 회사" 라는 신호가
    본문 어디에도 없습니다.
  */}
  <section class="section section--alt section--split wrap rise" data-section="company">
    <div class="split">
      <div>
        <p class="kicker">{h.company.kicker}</p>
        <h2 class="display display--tight">{h.company.lead}</h2>
        <p class="body" style="margin-top: 26px">{h.company.body}</p>
        {founderStory && <p class="body" style="margin-top: 18px">{founderStory}</p>}
        {
          SOCIAL.instagramUrl && (
            <p style="margin-top: 26px">
              {/* tapLink — 손가락으로 누를 수 있는 높이를 보장합니다(D 모바일 규칙). */}
              <a class="tapLink" href={SOCIAL.instagramUrl} rel="me noopener" target="_blank">
                {h.company.instagram}
                <span class="company__handle">{SOCIAL.instagramHandle}</span>
              </a>
            </p>
          )
        }
      </div>
      {
        founderPhoto && (
          <Picture
            src={founderPhoto}
            alt={FOUNDER_PHOTO_ALT[locale] ?? ''}
            formats={['avif', 'webp']}
            widths={[390, 780]}
            sizes="(max-width: 900px) 100vw, 50vw"
            quality={62}
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
  </section>

  {/*
    홈 FAQ — 셋만.

    제품 페이지에도 FAQ 가 있지만, **가장 먼저 떠오르는 의문은 홈에서** 답해야
    합니다. 홈에서 "기성 처방" 을 읽은 사람이 그 자리에서 갖는 질문이라,
    제품 페이지까지 가야 답이 있으면 대부분은 가기 전에 나갑니다.

    ── 접지 않습니다 ─────────────────────────────────────────
    셋뿐이고, 접으면 읽히지 않습니다. 답변엔진이 접힌 내용을 본문으로 보지
    않을 수 있다는 문제도 제품 페이지 FAQ 와 같습니다.

    ── 구조화 데이터는 여기서 내지 않습니다 ────────────────────
    이 사이트는 FAQPage 를 **고객센터 한 곳에서만** 냅니다. 같은 주제로 여러
    페이지가 FAQPage 를 내면 검색에서 서로 갉아먹고, 답변엔진은 어느 쪽을
    인용할지 모릅니다(제품 페이지 FAQ 주석 참조). 그 결정을 여기서 혼자
    뒤집지 않았습니다 — 담당자 확인 대기 항목입니다.
  */}
  <section class="section wrap wrap--narrow rise" data-section="home_faq">
    <p class="kicker">{h.faq.kicker}</p>
    <h2 class="display display--tight">{h.faq.heading}</h2>
    <dl class="homeFaq">
      {
        h.faq.items.map((item) => (
          <div>
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))
      }
    </dl>
    <p class="homeFaq__more">
      <a class="tapLink" href={localePath(locale, 'panel')}>{h.faq.panelLink}</a>
      <a class="tapLink" href={`${localePath(locale, 'product')}#faq`}>{h.faq.more}</a>
    </p>
  </section>

  <section class="section wrap wrap--narrow rise" data-section="brand_bridge">
    <p class="kicker">{h.origin.kicker}</p>
    <p class="display display--tight">
      {h.origin.statementBefore}<span class="mark">{h.origin.statementEmphasis}</span>{
        h.origin.statementAfter
      }
    </p>
    <p style="margin-top: 26px">
      <a
        class="btn btn--secondary"
        href={localePath(locale, 'brand')}
        data-brand-link
      >{t.brand.bridgeLink}</a>
    </p>
  </section>

  {/*
    하단 고정 CTA + 신청 시트.

    이 페이지는 12개 섹션입니다. 검증단 섹션(7번째)의 폼 아래로는 다섯
    섹션 동안 신청할 자리가 없었습니다 — 타임라인·첫 제품·여정·회사 소개·
    FAQ 를 다 읽고 마음이 움직인 사람이 할 수 있는 일이 다시 위로 올라가는
    것뿐이었습니다.

    폼과 같은 게이트를 씁니다. 팔기 시작하면 알림 신청 자체가 사라지므로
    바도 함께 사라져야 합니다.

    마크업 위치가 문서 끝인 이유: `position: fixed` 라 자리는 화면이
    정하지만, 탭 순서는 문서 순서가 정합니다. 본문을 다 지난 뒤에 오는
    것이 맞습니다.
  */}
  {
    !CAN_ORDER && (
      <StickyNotify
        locale={locale}
        heading={h.notify.hero.heading}
        body={h.notify.hero.body}
      />
    )
  }

</Base>

<script>
  import { mountLaunchNotify } from '../../lib/launch-notify';
  import { mountSectionView } from '../../lib/section-view';
  import { mountHeroCta } from '../../lib/hero-cta';
  import { mountStoryAnchor } from '../../lib/story-anchor';

  // 홈에는 폼이 셋입니다 — 첫 화면, 검증단 섹션, 그리고 하단 시트.
  // mountLaunchNotify 가 querySelectorAll 로 전부 연결합니다. 시트 안의
  // 폼도 문서에 이미 있으므로(열릴 때 만들어지지 않습니다) 여기서 함께
  // 걸립니다.
  mountLaunchNotify();

  // 어느 섹션까지 읽히는가. 계측이 꺼져 있으면 아무것도 하지 않습니다.
  mountSectionView();

  // 첫 화면의 버튼 → 폼. 없으면 링크가 그대로 동작합니다.
  mountHeroCta();

  // 밖에 공유된 #story 링크를 /brand 로 넘깁니다.
  mountStoryAnchor();
</script>
