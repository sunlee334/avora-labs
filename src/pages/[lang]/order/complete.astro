---
/**
 * 주문 완료.
 *
 * PG 결제창이 성공으로 돌아오면 paymentKey 가 쿼리에 실려 옵니다.
 * 그 경우에만 승인을 호출하고, 없으면 주문이 접수된 상태만 보여줍니다.
 * 새로고침해도 중복 승인되지 않도록 서버가 이미 결제된 주문은 그대로 돌려줍니다.
 */
import Base from '../../../layouts/Base.astro';
import { LOCALES, type Locale } from '../../../config/site';
import { dict, localePath } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = dict(locale);
const o = t.order.complete;
---

<Base
  locale={locale}
  path="order/complete"
  title={o.meta.title}
  description={o.meta.description}
  noindex
>
  <section class="section wrap">
    <div class="orderResult" data-order-result
      data-locale={locale}
      data-home-href={localePath(locale)}
      data-cart-href={localePath(locale, 'cart')}
      data-lookup-href={localePath(locale, 'order/lookup')}>

      <p class="orderResult__pending" data-state-loading>{o.confirming}</p>

      <div data-state-ok hidden>
        <h1 class="display display--tight">{o.heading}</h1>
        <p class="body" style="margin-top: 16px">{o.body}</p>

        <dl class="orderResult__facts">
          <div><dt>{o.orderNumber}</dt><dd data-fact-id></dd></div>
          <div><dt>{t.order.statusLabel}</dt><dd data-fact-status></dd></div>
          <div data-fact-amount-row hidden><dt>{o.amount}</dt><dd data-fact-amount></dd></div>
          <div data-fact-recipient-row hidden><dt>{o.recipient}</dt><dd data-fact-recipient></dd></div>
          <div data-fact-address-row hidden><dt>{o.address}</dt><dd data-fact-address></dd></div>
        </dl>

        <div class="orderResult__actions">
          <a class="cta" href={localePath(locale)}>{o.home}</a>
          <a class="cta cta--ghost" href={localePath(locale, 'order/lookup')}>{o.lookup}</a>
        </div>
      </div>

      <div data-state-failed hidden>
        <h1 class="display display--tight">{t.order.failed.heading}</h1>
        <p class="body" style="margin-top: 16px" data-failed-message>{t.order.failed.body}</p>
        {/*
          결제사가 준 코드를 문의용으로 남깁니다.

          **PG 가 보낸 문장은 그대로 쓰지 않습니다.** 그 문장은 한국어 한 벌뿐이라
          태국어·베트남어 화면에서는 한국어가 튀어나옵니다. 손님에게 보이는 설명은
          위의 우리 문구가 하고, 여기에는 문의할 때 필요한 **코드만** 둡니다.
        */}
        <p class="cart__notice" style="margin-top: 12px" data-failed-code hidden></p>
        <div class="orderResult__actions">
          <a class="cta" href={localePath(locale, 'cart')}>{t.order.failed.retry}</a>
        </div>
      </div>
    </div>
  </section>

  <template data-order-labels
    data-label-pending={t.order.status.pending}
    data-label-paid={t.order.status.paid}
    data-label-failed={t.order.status.failed}
    data-label-cancelled={t.order.status.cancelled}
    data-label-code={t.order.failed.code}
  ></template>
</Base>

<script>
  import { clear } from '../../../lib/cart';

  const root = document.querySelector<HTMLElement>('[data-order-result]');
  const labels = document.querySelector<HTMLElement>('[data-order-labels]');
  if (root && labels) {
    const L = labels.dataset;
    const locale = root.dataset.locale!;
    const params = new URLSearchParams(location.search);
    const orderId = params.get('orderId');
    const paymentKey = params.get('paymentKey');
    const amount = params.get('amount');

    const loading = root.querySelector<HTMLElement>('[data-state-loading]')!;
    const okBox = root.querySelector<HTMLElement>('[data-state-ok]')!;
    const failBox = root.querySelector<HTMLElement>('[data-state-failed]')!;

    const statusLabel = (s: string) =>
      ({ pending: L.labelPending, paid: L.labelPaid, failed: L.labelFailed, cancelled: L.labelCancelled })[s] ?? s;

    const set = (sel: string, value: string) => {
      const el = root.querySelector<HTMLElement>(sel);
      if (el) el.textContent = value;
    };
    const show = (sel: string) => {
      const el = root.querySelector<HTMLElement>(sel);
      if (el) el.hidden = false;
    };

    function renderOrder(order: any) {
      set('[data-fact-id]', order.id);
      set('[data-fact-status]', statusLabel(order.status));
      if (typeof order.amount === 'number') {
        set(
          '[data-fact-amount]',
          new Intl.NumberFormat(locale, {
            style: 'currency',
            currency: order.currency,
            maximumFractionDigits: 0,
          }).format(order.amount),
        );
        show('[data-fact-amount-row]');
      }
      if (order.recipientName) {
        set('[data-fact-recipient]', order.recipientName);
        show('[data-fact-recipient-row]');
      }
      if (order.address1) {
        set('[data-fact-address]', `(${order.postalCode}) ${order.address1} ${order.address2 ?? ''}`.trim());
        show('[data-fact-address-row]');
      }
      loading.hidden = true;
      okBox.hidden = false;
      // 결제가 끝났으니 장바구니를 비웁니다.
      if (order.status === 'paid') clear();
    }

    function renderFailure(code?: string | null) {
      loading.hidden = true;
      failBox.hidden = false;
      if (!code) return;
      const line = root!.querySelector<HTMLElement>('[data-failed-code]');
      if (!line || !L.labelCode) return;
      /*
       * `replace` 의 **두 번째 인자가 문자열이면 `$` 가 치환 시퀀스** 입니다.
       * `code` 는 주소창에서 오므로 `?code=$\`` 같은 값이 들어올 수 있고,
       * 그러면 "오류 코드: 오류 코드: " 가 그려져 **정작 문의에 필요한 코드가
       * 사라집니다.** 함수로 넘기면 그 해석이 일어나지 않습니다.
       *
       * `textContent` 라 XSS 는 아니지만, 코드를 보여주려고 만든 줄이 코드를
       * 지우는 것은 그 자체로 결함입니다.
       */
      line.textContent = L.labelCode.replace('{code}', () => code);
      line.hidden = false;
    }

    (async () => {
      /*
       * 결제창이 실패로 돌려보낸 경우.
       *
       * 토스는 failUrl 에 `code`·`message`·`orderId` 를 붙입니다. 이때는
       * `paymentKey` 가 없으므로, 이 갈래가 없으면 아래의 "PG 연동 전" 경로로
       * 흘러 들어가 **실패한 결제가 접수 완료로 보입니다.**
       */
      const failCode = params.get('code');
      if (failCode) {
        renderFailure(failCode);
        return;
      }

      if (!orderId) {
        renderFailure();
        return;
      }

      // PG 를 거쳐 돌아온 경우에만 승인을 호출합니다.
      if (paymentKey) {
        try {
          const res = await fetch('/api/payments/confirm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ paymentKey, orderId, amount: amount ? Number(amount) : undefined }),
          });
          const payload = await res.json().catch(() => ({}));
          if (res.ok && payload.ok && payload.order) {
            renderOrder(payload.order);
          } else {
            // 워커는 ConfirmResult 를 그대로 돌려줍니다 — 코드는 error 안에 있습니다.
            renderFailure(payload.error?.code ?? payload.error);
          }
        } catch {
          renderFailure();
        }
        return;
      }

      // PG 연동 전에는 주문번호만 확인해 줍니다.
      // 서버 조회에는 연락처가 필요하므로 여기서는 접수 사실만 보여줍니다.
      renderOrder({
        id: orderId,
        status: 'pending',
        amount: amount ? Number(amount) : null,
        currency: 'KRW',
      });
    })();
  }
</script>
