---
/**
 * 주문 관리 화면.
 *
 * 브랜드 사이트와 달리 언어 접두어가 없습니다 — 내부 도구라 한국어 하나면 충분하고,
 * 5개 언어로 복제하면 관리 대상만 늘어납니다.
 *
 * ⚠️ 이 화면은 모든 주문의 배송지·연락처를 볼 수 있습니다.
 *    보호는 Cloudflare Access 가 하고, Worker 가 Access JWT 를 한 번 더 검증합니다.
 *    화면 자체는 데이터를 담고 있지 않은 껍데기이고, 실제 값은 인증된 API 로만 옵니다.
 */
import '../styles/tokens.css';
import { FULFILLMENTS } from '../../worker/orders';

const STATUS_LABEL: Record<string, string> = {
  pending: '결제 대기',
  paid: '결제 완료',
  failed: '결제 실패',
  cancelled: '취소됨',
};

const FULFILLMENT_LABEL: Record<string, string> = {
  unfulfilled: '미발송',
  preparing: '준비중',
  shipped: '발송',
  delivered: '배송완료',
  returned: '반품',
};
---

<!doctype html>
<html lang="ko-KR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>주문 관리 — AVORA LABS</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/fonts/ko/fonts.css" />
  </head>

  <body class="admin">
    <header class="bar">
      <h1>관리</h1>
      <nav class="tabs" aria-label="관리 영역">
        {/*
          탭이지만 role="tablist" 를 쓰지 않습니다. ARIA 탭 패턴은 화살표
          이동·roving tabindex 를 함께 구현해야 하고, 그러지 않으면 오히려
          기대를 어깁니다. 여기서는 버튼 두 개와 aria-current 로 충분합니다.
        */}
        <button type="button" data-tab="orders" aria-current="true">주문</button>
        <button type="button" data-tab="inquiries">
          문의<span class="tabs__count" data-inq-badge hidden></span>
        </button>
        <button type="button" data-tab="reviews">후기</button>
        <button type="button" data-tab="signups">
          출시 알림<span class="tabs__count" data-su-badge hidden></span>
        </button>
        <button type="button" data-tab="users">회원</button>
      </nav>
      <div class="bar__right">
        <span class="who" data-who></span>
        <button type="button" data-refresh>새로고침</button>
      </div>
    </header>

    <main>
      <div data-panel="orders">
      {/* dt·dd 는 dl 안에 있어야 합니다. div 로 감싸는 것까지는 허용되지만
          dl 자체가 없으면 스크린리더가 짝을 읽지 못합니다. */}
      <dl class="summary" data-summary aria-label="상태 요약"></dl>

      <form class="filters" data-filters>
        <label class="filters__search">
          <span class="sr-only">검색</span>
          <input
            type="search"
            name="search"
            placeholder="주문번호 · 수령인 · 연락처"
            enterkeyhint="search"
          />
        </label>

        <label>
          <span class="sr-only">결제 상태</span>
          <select name="status">
            <option value="">결제 상태 전체</option>
            {
              Object.entries(STATUS_LABEL).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))
            }
          </select>
        </label>

        <label>
          <span class="sr-only">배송 상태</span>
          <select name="fulfillment">
            <option value="">배송 상태 전체</option>
            {
              FULFILLMENTS.map((value) => (
                <option value={value}>{FULFILLMENT_LABEL[value]}</option>
              ))
            }
          </select>
        </label>

        <button type="submit">조회</button>
      </form>

      <p class="state" data-state>불러오는 중…</p>

      <div class="tableWrap" data-table-wrap hidden>
        <table>
          <thead>
            <tr>
              <th scope="col">주문번호</th>
              <th scope="col">주문일시</th>
              <th scope="col">수령인</th>
              <th scope="col" class="num">금액</th>
              <th scope="col">결제</th>
              <th scope="col">배송</th>
            </tr>
          </thead>
          <tbody data-rows></tbody>
        </table>
      </div>

      <nav class="pager" data-pager hidden aria-label="페이지">
        <button type="button" data-prev>이전</button>
        <span data-page-info></span>
        <button type="button" data-next>다음</button>
      </nav>
      </div>

      {/*
        문의 패널.

        주문 패널과 DOM 을 공유하지 않습니다 — 같은 [data-rows] 를 쓰면
        탭을 오갈 때 한쪽 데이터가 다른 쪽 표에 남습니다. 클래스는 그대로
        재사용하되 선택자만 갈랐습니다.
      */}
      <div data-panel="inquiries" hidden>
        <dl class="summary" data-inq-summary aria-label="문의 요약"></dl>

        <form class="filters" data-inq-filters>
          <label class="sr-only" for="inq-status">답변 여부</label>
          <select id="inq-status" name="status">
            <option value="">전체</option>
            <option value="open" selected>미답변</option>
            <option value="answered">답변 완료</option>
          </select>
          <button type="submit">보기</button>
        </form>

        <p class="state" data-inq-state>불러오는 중…</p>

        <div class="tableWrap" data-inq-table-wrap hidden>
          <table>
            <thead>
              <tr>
                <th scope="col">문의번호</th>
                <th scope="col">제목</th>
                <th scope="col">연락처</th>
                <th scope="col">받은 때</th>
                <th scope="col">상태</th>
              </tr>
            </thead>
            <tbody data-inq-rows></tbody>
          </table>
        </div>

        <nav class="pager" data-inq-pager hidden aria-label="문의 페이지">
          <button type="button" data-inq-prev>이전</button>
          <span data-inq-page-info></span>
          <button type="button" data-inq-next>다음</button>
        </nav>
      </div>

      {/*
        후기 탭.

        API 는 처음부터 있었는데(`GET/PATCH /api/admin/reviews`) 부를 화면이
        없었습니다. 그래서 후기를 숨기려면 API 를 직접 불러야 했고,
        마이페이지가 "관리자가 내린 후기는 고객센터로 문의해 주세요" 라고
        안내하기 시작하면서 그 문의를 받아도 처리할 자리가 없었습니다.
      */}
      <div data-panel="reviews" hidden>
        <form class="filters" data-rv-filters>
          <label class="sr-only" for="rv-status">상태</label>
          <select id="rv-status" name="status">
            <option value="" selected>전체</option>
            <option value="visible">보이는 중</option>
            <option value="hidden">숨김</option>
            <option value="removed">작성자가 내림</option>
          </select>
          <button type="submit">보기</button>
        </form>

        <p class="state" data-rv-state>불러오는 중…</p>

        <div class="tableWrap" data-rv-table-wrap hidden>
          <table>
            <thead>
              <tr>
                <th scope="col">후기번호</th>
                <th scope="col">별점</th>
                <th scope="col">내용</th>
                <th scope="col">쓴 때</th>
                <th scope="col">상태</th>
              </tr>
            </thead>
            <tbody data-rv-rows></tbody>
          </table>
        </div>

        <nav class="pager" data-rv-pager hidden aria-label="후기 페이지">
          <button type="button" data-rv-prev>이전</button>
          <span data-rv-page-info></span>
          <button type="button" data-rv-next>다음</button>
        </nav>
      </div>

      {/*
        출시 알림 명단.

        출시 전인 지금 이 화면이 보는 유일한 "사람 명단" 입니다. 유입 화면별
        집계를 표 위에 두는 이유는, 어디가 명단을 만드는지 모르면 다음에
        무엇을 고칠지 고를 수 없기 때문입니다.
      */}
      <div data-panel="signups" hidden>
        <dl class="summary" data-su-summary aria-label="명단 요약"></dl>

        <form class="filters" data-su-filters>
          <label class="sr-only" for="su-source">유입 화면</label>
          <select id="su-source" name="source">
            <option value="" selected>전체 화면</option>
            <option value="home-hero">홈 첫 화면</option>
            <option value="home-end">홈 끝</option>
            <option value="product">제품 페이지</option>
          </select>
          <label class="sr-only" for="su-state">상태</label>
          <select id="su-state" name="state">
            <option value="" selected>전체</option>
            <option value="active">수신 중</option>
            <option value="unsubscribed">수신 거부</option>
          </select>
          <button type="submit">보기</button>
        </form>

        <p class="state" data-su-state>불러오는 중…</p>

        <div class="tableWrap" data-su-table-wrap hidden>
          <table>
            <thead>
              <tr>
                <th scope="col">이메일</th>
                <th scope="col">언어</th>
                <th scope="col">유입 화면</th>
                <th scope="col">신청</th>
                <th scope="col">상태</th>
              </tr>
            </thead>
            <tbody data-su-rows></tbody>
          </table>
        </div>

        <nav class="pager" data-su-pager hidden aria-label="명단 페이지">
          <button type="button" data-su-prev>이전</button>
          <span data-su-page-info></span>
          <button type="button" data-su-next>다음</button>
        </nav>
      </div>

      {/*
        가입 회원.

        출시 전이라 지금은 거의 비어 있습니다. 출시 후에는 이쪽이 주 명단입니다.
      */}
      <div data-panel="users" hidden>
        <form class="filters" data-us-filters>
          <label class="filters__search">
            <span class="sr-only">이메일 또는 이름</span>
            <input type="search" name="q" placeholder="이메일 또는 이름" autocomplete="off" />
          </label>
          <button type="submit">찾기</button>
        </form>

        <p class="state" data-us-state>불러오는 중…</p>

        <div class="tableWrap" data-us-table-wrap hidden>
          <table>
            <thead>
              <tr>
                <th scope="col">이메일</th>
                <th scope="col">이름</th>
                <th scope="col">로그인 수단</th>
                <th scope="col">주문</th>
                <th scope="col">배송지</th>
                <th scope="col">가입</th>
              </tr>
            </thead>
            <tbody data-us-rows></tbody>
          </table>
        </div>

        <nav class="pager" data-us-pager hidden aria-label="회원 페이지">
          <button type="button" data-us-prev>이전</button>
          <span data-us-page-info></span>
          <button type="button" data-us-next>다음</button>
        </nav>
      </div>
    </main>

    {/* 후기 상세 — 행을 누르면 열립니다 */}
    <dialog class="detail" data-rv-detail aria-label="후기 상세">
      <div class="detail__head">
        <h2 data-rv-d-id></h2>
        <button type="button" data-rv-detail-close aria-label="닫기">✕</button>
      </div>

      <dl class="detail__facts">
        <div><dt>별점</dt><dd data-rv-d-rating></dd></div>
        <div><dt>내용</dt><dd data-rv-d-body></dd></div>
        <div><dt>작성자</dt><dd data-rv-d-author></dd></div>
        <div><dt>주문번호</dt><dd data-rv-d-order></dd></div>
        <div><dt>쓴 때</dt><dd data-rv-d-when></dd></div>
        <div><dt>상태</dt><dd data-rv-d-status></dd></div>
        <div data-rv-d-reason-row hidden><dt>숨긴 이유</dt><dd data-rv-d-reason></dd></div>
      </dl>

      {/*
        작성자가 내린 후기는 손댈 수 없습니다. 지운 사람의 뜻과 반대로 그 글을
        공개 화면에 되돌리는 일이 되기 때문입니다(서버도 409 로 막습니다).
      */}
      <div class="detail__notice" data-rv-removed hidden>
        <p>작성자가 내린 후기입니다. 다시 보이게 할 수 없습니다.</p>
      </div>

      <form class="detail__form" data-rv-form>
        <h3>상태 바꾸기</h3>
        <div class="row">
          <label for="rv-reason">숨기는 이유</label>
          <input type="text" id="rv-reason" name="reason" maxlength="200"
                 placeholder="개인정보 노출 · 광고 · 욕설 · 제품과 무관" />
        </div>
        {/*
          이유를 적는 칸이 먼저 있고 그 아래 버튼이 있습니다. 숨기는 이유가
          없으면 서버가 400 으로 막습니다 — 기준 없이 숨긴 기록이 없으면,
          부정적 후기만 골라 숨겼는지 나중에 아무도 증명할 수 없습니다.
        */}
        <div class="row">
          <button type="submit" data-rv-hide>숨기기</button>
          <button type="button" data-rv-show>다시 보이기</button>
        </div>
        <p class="detail__error" data-rv-error hidden></p>
      </form>
    </dialog>

    {/* 문의 상세 — 행을 누르면 열립니다 */}
    <dialog class="detail" data-inq-detail aria-label="문의 상세">
      <div class="detail__head">
        <h2 data-inq-d-id></h2>
        <button type="button" data-inq-detail-close aria-label="닫기">✕</button>
      </div>

      <dl class="detail__facts">
        <div><dt>제목</dt><dd data-inq-d-subject></dd></div>
        <div><dt>내용</dt><dd data-inq-d-body></dd></div>
        <div><dt>연락처</dt><dd data-inq-d-phone></dd></div>
        <div><dt>주문번호</dt><dd data-inq-d-order></dd></div>
        <div><dt>받은 때</dt><dd data-inq-d-when></dd></div>
      </dl>

      {/* 이미 답한 문의는 답을 보여주기만 합니다 — 덮어쓰면 손님이 읽던
          내용이 사라집니다(서버도 409 로 막습니다). */}
      <div class="detail__notice" data-inq-answered hidden>
        <p data-inq-d-answer></p>
      </div>

      <form class="detail__form" data-inq-form>
        <h3>답변</h3>
        <div class="row">
          <label for="inq-answer">답변 내용</label>
          <textarea id="inq-answer" name="answer" rows="6" required maxlength="2000"></textarea>
        </div>
        <p class="detail__error" data-inq-error hidden></p>
        <button type="submit" data-inq-save>답변 보내기</button>
      </form>
    </dialog>

    {/* 주문 상세 — 행을 누르면 열립니다 */}
    <dialog class="detail" data-detail aria-label="주문 상세">
      <header class="detail__head">
        <h2 data-d-id></h2>
        <button type="button" data-detail-close aria-label="닫기">✕</button>
      </header>

      <dl class="detail__facts">
        <div><dt>주문일시</dt><dd data-d-created></dd></div>
        <div><dt>결제</dt><dd data-d-status></dd></div>
        <div><dt>결제일시</dt><dd data-d-paid></dd></div>
        <div><dt>금액</dt><dd data-d-amount></dd></div>
        <div><dt>상품</dt><dd data-d-items></dd></div>
        <div><dt>수령인</dt><dd data-d-recipient></dd></div>
        <div><dt>연락처</dt><dd data-d-phone></dd></div>
        <div><dt>배송지</dt><dd data-d-address></dd></div>
        <div><dt>요청사항</dt><dd data-d-memo></dd></div>
        <div><dt>이메일</dt><dd data-d-email></dd></div>
      </dl>

      <form class="detail__form" data-detail-form>
        <h3>배송 처리</h3>
        <div class="row">
          <label>
            배송 상태
            <select name="fulfillment">
              {
                FULFILLMENTS.map((value) => (
                  <option value={value}>{FULFILLMENT_LABEL[value]}</option>
                ))
              }
            </select>
          </label>
          <label>
            택배사
            <input type="text" name="carrier" maxlength="40" placeholder="CJ대한통운" />
          </label>
        </div>
        <label>
          송장번호
          <input type="text" name="trackingNumber" inputmode="numeric" maxlength="40" />
        </label>
        <label>
          관리 메모
          <input type="text" name="adminMemo" maxlength="300" placeholder="내부용 (고객에게 보이지 않습니다)" />
        </label>

        <p class="detail__notice" data-detail-unpaid hidden>
          결제가 완료되지 않은 주문입니다. 발송 처리와 송장 등록을 할 수 없습니다.
        </p>
        <p class="detail__error" data-detail-error hidden></p>
        <button type="submit" data-save>저장</button>
      </form>
    </dialog>

    <style is:global>
      /*
       * 이 <style is:global> 의 모든 규칙은 .admin 아래로 한정되어 있습니다.
       *
       * Astro 는 사이트의 모든 is:global CSS 를 **한 파일로 묶어 모든 페이지에
       * 링크합니다.** 그래서 여기 있던 `body`, `table`, `th, td`, `tbody tr`
       * 같은 맨몸 선택자가 5개 언어의 공개 페이지까지 전부 따라갔습니다.
       * 실제 피해: 여기 있던 word-break:keep-all 이 태국어·중국어 페이지에
       * 걸려, 띄어쓰기가 없는 문장이 줄바꿈 지점을 잃고 화면 밖으로 잘렸습니다.
       *
       * body 자체의 여백·바탕·글꼴은 global.css 가 이미 같은 값으로 정합니다.
       */
      body.admin, .admin *, .admin *::before, .admin *::after { box-sizing: border-box; }
      .admin h1, .admin h2, .admin h3, .admin p, .admin dl, .admin dd { margin: 0; }
      .admin :focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }

      .admin .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip-path: inset(50%); white-space: nowrap;
      }

      .admin .bar {
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        /* 탭이 다섯입니다 — 좁은 화면에서는 줄을 바꿔야 헤더가 옆으로 밀지 않습니다. */
        flex-wrap: wrap;
        padding: 14px 20px;
        background: var(--brand-primary); color: var(--brand-surface-alt);
        position: sticky; top: 0; z-index: 5;
      }
      .admin .bar h1 { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
      .admin .bar__right { display: flex; align-items: center; gap: 12px; }
      /* 탭. 모든 규칙이 .admin 접두여야 합니다 — 이 <style is:global> 은
         사이트 전체 CSS 로 묶여 공개 페이지에도 링크됩니다. */
      .admin .tabs {
        display: flex;
        gap: 4px;
        margin-inline-start: 20px;
        /*
         * 탭이 다 안 들어가면 **탭 줄 안에서만** 옆으로 밉니다.
         * min-width:0 이 없으면 flex 항목이 내용만큼 벌어져서, 넘치는 쪽이
         * 여기가 아니라 문서 전체가 됩니다.
         */
        min-width: 0;
        overflow-x: auto;
      }
      .admin .tabs button { flex: 0 0 auto; white-space: nowrap; }

      /* 좁은 화면에서는 탭이 제 줄을 통째로 씁니다. */
      @media (max-width: 640px) {
        .admin .tabs { order: 3; flex-basis: 100%; margin-inline-start: 0; }
      }
      .admin .tabs button {
        padding: 8px 14px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--brand-muted);
        font: inherit;
        font-size: 13.5px;
        cursor: pointer;
        /* 탭도 손가락으로 눌립니다. */
        min-height: 40px;
      }
      .admin .tabs button:hover {
        color: var(--brand-primary);
      }
      .admin .tabs button[aria-current='true'] {
        background: var(--brand-surface-alt);
        color: var(--brand-primary);
        font-weight: 600;
      }
      .admin .tabs__count {
        display: inline-block;
        margin-inline-start: 6px;
        padding: 1px 7px;
        border-radius: 999px;
        background: var(--brand-primary);
        color: var(--brand-surface);
        font-family: var(--font-mono);
        font-size: 11px;
      }
      .admin .detail__form textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--color-line);
        border-radius: 8px;
        background: transparent;
        color: var(--color-ink);
        font: inherit;
        font-size: 14px;
        line-height: 1.7;
        resize: vertical;
      }
      /* 문의 본문은 줄바꿈을 그대로 살려야 읽힙니다. */
      .admin [data-inq-d-body] {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      .admin .who { font-family: var(--font-mono); font-size: 12px; color: var(--brand-muted-on-dark); }
      .admin .bar button {
        min-height: 40px; padding-inline: 14px; border-radius: 999px;
        border: 1px solid var(--color-line-inverse); background: transparent;
        color: inherit; font: inherit; font-size: 13px; cursor: pointer;
      }

      .admin main { padding: 20px; max-width: 1200px; margin: 0 auto; }

      .admin .summary {
        margin: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); margin-bottom: 22px; }
      .admin .summary div {
        border: 1px solid var(--color-line); border-radius: 10px; padding: 14px 16px;
      }
      .admin .summary dt { font-size: 12px; color: var(--brand-muted); }
      .admin .summary dd { font-family: var(--font-mono); font-size: 22px; font-variant-numeric: tabular-nums; }
      .admin .summary div[data-attention='true'] { border-color: var(--color-ink); border-width: 2px; }

      .admin .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
      .admin .filters__search { flex: 1 1 240px; }
      .admin .filters input, .admin .filters select {
        font: inherit; font-size: 16px; min-height: 44px; width: 100%;
        padding: 8px 12px; border: 1px solid var(--color-line); border-radius: 8px;
        background: var(--brand-surface); color: var(--color-ink);
      }
      .admin .filters button {
        min-height: 44px; padding-inline: 22px; border: 0; border-radius: 8px;
        background: var(--brand-primary); color: var(--brand-surface-alt);
        font: inherit; font-weight: 600; cursor: pointer;
      }

      .admin .state { color: var(--brand-muted); padding-block: 30px; font-size: 14px; }

      .admin .tableWrap { overflow-x: auto; border: 1px solid var(--color-line); border-radius: 10px; }
      .admin table { border-collapse: collapse; width: 100%; min-width: 760px; font-size: 14px; }
      .admin th, .admin td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--color-line); }
      .admin th {
        font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--brand-muted); font-weight: 500; white-space: nowrap;
      }
      .admin .num { text-align: right; }
      .admin td.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; text-align: right; }
      .admin tbody tr { cursor: pointer; }
      .admin tbody tr:hover { background: var(--brand-surface-alt); }
      .admin tbody tr:last-child td { border-bottom: 0; }
      .admin .oid { font-family: var(--font-mono); font-size: 12px; white-space: nowrap; }
      .admin .when { font-family: var(--font-mono); font-size: 12px; color: var(--brand-muted); white-space: nowrap; }

      .admin .pill {
        display: inline-block; padding: 3px 10px; border-radius: 999px;
        font-size: 12px; border: 1px solid var(--color-line); white-space: nowrap;
      }
      .admin .pill[data-tone='ok'] { background: var(--brand-primary); color: var(--brand-surface-alt); border-color: var(--brand-primary); }
      .admin .pill[data-tone='warn'] { border-color: var(--color-ink); font-weight: 600; }
      .admin .pill[data-tone='dim'] { color: var(--brand-muted); }
      .admin .detail__notice {
        margin: 0 0 12px;
        padding: 10px 12px;
        border: 1px solid var(--color-ink);
        border-radius: 6px;
        font-size: 13px;
        line-height: 1.6;
      }

      .admin .pager { display: flex; align-items: center; gap: 14px; justify-content: center; padding-block: 24px; }
      .admin .pager button {
        min-height: 44px; padding-inline: 18px; border: 1px solid var(--color-line);
        border-radius: 999px; background: transparent; font: inherit; cursor: pointer;
      }
      .admin .pager button:disabled { opacity: 0.4; cursor: default; }
      .admin .pager span { font-family: var(--font-mono); font-size: 13px; color: var(--brand-muted); }

      .admin .detail {
        border: 0; border-radius: 14px; padding: 0; width: min(680px, 94vw);
        max-height: 88svh; background: var(--brand-surface); color: var(--color-ink);
      }
      .admin .detail::backdrop { background: color-mix(in srgb, var(--color-ink) 40%, transparent); }
      .admin .detail__head {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 16px 20px; border-bottom: 1px solid var(--color-line);
        position: sticky; top: 0; background: var(--brand-surface);
      }
      .admin .detail__head h2 { font-family: var(--font-mono); font-size: 14px; }
      .admin .detail__head button {
        min-width: 44px; min-height: 44px; border: 0; background: transparent;
        font-size: 16px; cursor: pointer; color: var(--brand-muted);
      }
      .admin .detail__facts { padding: 6px 20px; }
      .admin .detail__facts > div {
        display: grid; grid-template-columns: 92px 1fr; gap: 16px;
        padding-block: 11px; border-bottom: 1px solid var(--color-line);
      }
      .admin .detail__facts dt { font-size: 13px; color: var(--brand-muted); }
      .admin .detail__facts dd { font-size: 14px; }
      .admin .detail__form { padding: 20px; display: grid; gap: 14px; }
      /* display 를 지정한 요소는 hidden 속성(display:none)을 이깁니다.
         감췄다고 생각한 것이 그대로 보이는, 눈으로만 봐서는 원인을
         짐작하기 어려운 종류의 버그입니다. */
      .admin [hidden] { display: none !important; }
      .admin .detail__form h3 { font-size: 14px; font-weight: 600; }
      .admin .detail__form .row { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }
      .admin .detail__form label { display: grid; gap: 6px; font-size: 13px; color: var(--brand-muted); }
      .admin .detail__form input, .admin .detail__form select {
        font: inherit; font-size: 16px; min-height: 44px; padding: 8px 12px;
        border: 1px solid var(--color-line); border-radius: 8px;
        background: var(--brand-surface); color: var(--color-ink); width: 100%;
      }
      .admin .detail__form button[type='submit'] {
        min-height: 48px; border: 0; border-radius: 999px; margin-top: 4px;
        background: var(--brand-primary); color: var(--brand-surface-alt);
        font: inherit; font-weight: 600; cursor: pointer;
      }
      .admin .detail__error {
        padding: 12px 14px; border: 1px solid var(--color-ink); border-radius: 8px; font-size: 13.5px;
      }

      @media (max-width: 560px) {
        .admin .detail__form .row { grid-template-columns: 1fr; }
      }
    </style>

    <script>
      const STATUS = {
        pending: { label: '결제 대기', tone: 'dim' },
        paid: { label: '결제 완료', tone: 'ok' },
        failed: { label: '결제 실패', tone: 'warn' },
        cancelled: { label: '취소됨', tone: 'dim' },
      } as const;

      const FULFILL = {
        unfulfilled: { label: '미발송', tone: 'warn' },
        preparing: { label: '준비중', tone: 'dim' },
        shipped: { label: '발송', tone: 'ok' },
        delivered: { label: '배송완료', tone: 'dim' },
        returned: { label: '반품', tone: 'warn' },
      } as const;

      const PAGE_SIZE = 25;

      const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
      const state = $('[data-state]');
      const tableWrap = $('[data-table-wrap]');
      const rowsBox = $('[data-rows]');
      const pager = $('[data-pager]');
      const detail = $<HTMLDialogElement>('[data-detail]');
      const detailForm = $<HTMLFormElement>('[data-detail-form]');
      const filters = $<HTMLFormElement>('[data-filters]');

      let page = 0;
      let total = 0;
      let openOrder: any = null;

      const money = (v: number, currency: string) =>
        new Intl.NumberFormat('ko-KR', { style: 'currency', currency, maximumFractionDigits: 0 }).format(v);

      const when = (iso: string | null) =>
        iso
          ? new Intl.DateTimeFormat('ko-KR', {
              year: '2-digit', month: '2-digit', day: '2-digit',
              hour: '2-digit', minute: '2-digit', hour12: false,
            }).format(new Date(iso))
          : '—';

      const phone = (raw: string) =>
        raw.length === 11 ? `${raw.slice(0, 3)}-${raw.slice(3, 7)}-${raw.slice(7)}`
        : raw.length === 10 ? `${raw.slice(0, 3)}-${raw.slice(3, 6)}-${raw.slice(6)}`
        : raw;

      /**
       * 표 칸 하나.
       *
       * 이 화면은 innerHTML 을 쓰지 않습니다. 여기 들어오는 값 중 수령인 이름은
       * 인증 없이 누구나 주문 API 로 넣을 수 있는 문자열이고, 이 화면은 Access 를
       * 통과한 관리자 세션 안입니다. 한 곳만 뚫려도 전 고객의 연락처와 주소가
       * 새 나갑니다. 그래서 예외 없이 textContent 로만 넣습니다.
       */
      function cell(text: string, className?: string, child?: Node) {
        const td = document.createElement('td');
        if (className) td.className = className;
        if (child) td.appendChild(child);
        else td.textContent = text;
        return td;
      }

      function pill(map: Record<string, { label: string; tone: string }>, key: string) {
        const entry = map[key] ?? { label: key, tone: 'dim' };
        const el = document.createElement('span');
        el.className = 'pill';
        el.dataset.tone = entry.tone;
        el.textContent = entry.label;
        return el;
      }

      /*
       * 인증이 막혔을 때 "로그인하세요" 하나로 뭉뚱그리면 안 됩니다.
       *
       * 특히 위험한 경우: Access 애플리케이션이 `/admin` 만 덮고 `/api/admin` 을
       * 빠뜨리면, **로그인은 되어 화면은 열리는데 데이터만 오지 않습니다.**
       * Worker 는 쿠키가 아니라 `Cf-Access-Jwt-Assertion` 헤더를 보는데,
       * Cloudflare 는 그 헤더를 Access 가 덮는 경로에만 붙이기 때문입니다.
       * 이때 "로그인이 필요합니다" 라고 하면 이미 로그인한 사람을 로그인
       * 화면으로 계속 돌려보내게 됩니다.
       */
      const ACCESS_HELP: Record<string, string> = {
        ACCESS_NOT_CONFIGURED:
          '관리 화면 인증이 아직 설정되지 않았습니다. Cloudflare Zero Trust 에서 Access 애플리케이션을 만들고, ACCESS_TEAM_DOMAIN 과 ACCESS_POLICY_AUD 를 설정한 뒤 다시 배포하세요.',
        ACCESS_TOKEN_MISSING:
          'Cloudflare Access 가 이 요청에 인증 토큰을 붙이지 않았습니다. Access 애플리케이션에 /api/admin 경로가 빠져 있을 가능성이 큽니다 — 이 화면만 보호하면 화면은 열리지만 데이터는 오지 않습니다.',
        ACCESS_TOKEN_INVALID:
          '인증 정보가 만료되었거나 다른 애플리케이션의 것입니다. 페이지를 새로고침해 다시 로그인해 주세요.',
      };

      async function api(path: string, init?: RequestInit) {
        const res = await fetch(path, {
          ...init,
          headers: { 'Content-Type': 'application/json', ...(init?.headers ?? {}) },
        });
        if (res.status === 401 || res.status === 403) {
          const reason = (await res.json().catch(() => ({}))) as { error?: string; message?: string };
          throw new Error(
            (reason.error && ACCESS_HELP[reason.error]) ||
              reason.message ||
              '접근 권한이 없습니다.',
          );
        }
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error((body as any).message || (body as any).error || '요청이 실패했습니다.');
        return body as any;
      }

      function query() {
        const data = new FormData(filters);
        const params = new URLSearchParams();
        for (const key of ['search', 'status', 'fulfillment']) {
          const value = String(data.get(key) ?? '').trim();
          if (value) params.set(key, value);
        }
        params.set('limit', String(PAGE_SIZE));
        params.set('offset', String(page * PAGE_SIZE));
        return params.toString();
      }

      async function load() {
        state.hidden = false;
        state.textContent = '불러오는 중…';
        tableWrap.hidden = true;
        pager.hidden = true;

        try {
          const data = await api(`/api/admin/orders?${query()}`);
          total = data.total;

          if (data.who) $('[data-who]').textContent = data.who;

          // 상태 요약
          const summary = $('[data-summary]');
          summary.replaceChildren(
            ...Object.entries(FULFILL).map(([key, meta]) => {
              const box = document.createElement('div');
              const n = data.counts?.[key] ?? 0;
              // 미발송이 쌓이면 눈에 띄어야 합니다 — 여기가 실무에서 가장 자주 보는 숫자입니다.
              box.dataset.attention = String(key === 'unfulfilled' && n > 0);
              const dt = document.createElement('dt');
              dt.textContent = meta.label;
              const dd = document.createElement('dd');
              dd.textContent = String(n);
              box.append(dt, dd);
              return box;
            }),
          );

          if (data.orders.length === 0) {
            state.textContent = total === 0 ? '아직 주문이 없습니다.' : '조건에 맞는 주문이 없습니다.';
            return;
          }

          rowsBox.replaceChildren(
            ...data.orders.map((order: any) => {
              const tr = document.createElement('tr');
              tr.tabIndex = 0;
              tr.append(
                cell(order.id, 'oid'),
                cell(when(order.createdAt), 'when'),
                // 수령인은 고객이 입력한 값입니다. textContent 로만 넣습니다 —
                // innerHTML 로 넣으면 이름칸에 담긴 태그가 이 화면에서 실행됩니다.
                // 여기는 Access 를 통과한 관리자 세션이라, 그 스크립트가 관리 API 를
                // 그대로 호출할 수 있습니다.
                cell(order.recipientName),
                cell(money(order.amount, order.currency), 'num'),
                cell('', undefined, pill(STATUS as any, order.status)),
                cell('', undefined, pill(FULFILL as any, order.fulfillment)),
              );
              const open = () => showDetail(order);
              tr.addEventListener('click', open);
              tr.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
              });
              return tr;
            }),
          );

          state.hidden = true;
          tableWrap.hidden = false;

          const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
          $('[data-page-info]').textContent = `${page + 1} / ${pages} · 전체 ${total}건`;
          $<HTMLButtonElement>('[data-prev]').disabled = page === 0;
          $<HTMLButtonElement>('[data-next]').disabled = page + 1 >= pages;
          pager.hidden = pages <= 1;
        } catch (error) {
          state.textContent = (error as Error).message;
        }
      }

      function showDetail(order: any) {
        openOrder = order;
        const set = (sel: string, value: string) => { $(sel).textContent = value; };
        set('[data-d-id]', order.id);
        set('[data-d-created]', when(order.createdAt));
        set('[data-d-paid]', when(order.paidAt));
        set('[data-d-amount]', money(order.amount, order.currency));
        set('[data-d-items]', order.items.map((i: any) => `${i.name} × ${i.qty}`).join(', '));
        set('[data-d-recipient]', order.recipientName);
        set('[data-d-phone]', phone(order.recipientPhone));
        set('[data-d-address]', `(${order.postalCode}) ${order.address1} ${order.address2 ?? ''}`.trim());
        set('[data-d-memo]', order.memo || '—');
        set('[data-d-email]', order.email || '—');

        $('[data-d-status]').replaceChildren(pill(STATUS as any, order.status));

        // 결제되지 않은 주문은 발송할 수 없습니다(서버도 막습니다). 화면에서도
        // 고를 수 없게 해서, 눌렀다가 오류를 보는 대신 애초에 눌리지 않게 합니다.
        const paid = order.status === 'paid';
        const fulfillmentSelect = detailForm.elements.namedItem('fulfillment') as HTMLSelectElement;
        fulfillmentSelect.value = order.fulfillment;
        for (const option of Array.from(fulfillmentSelect.options)) {
          option.disabled = !paid && option.value !== 'unfulfilled';
        }
        const unpaidNotice = $('[data-detail-unpaid]');
        unpaidNotice.hidden = paid;
        $<HTMLInputElement>('[name="trackingNumber"]').disabled = !paid;
        $<HTMLInputElement>('[name="carrier"]').disabled = !paid;
        (detailForm.elements.namedItem('carrier') as HTMLInputElement).value = order.carrier ?? '';
        (detailForm.elements.namedItem('trackingNumber') as HTMLInputElement).value = order.trackingNumber ?? '';
        (detailForm.elements.namedItem('adminMemo') as HTMLInputElement).value = order.adminMemo ?? '';
        $('[data-detail-error]').hidden = true;

        detail.showModal();
      }

      detailForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!openOrder) return;
        const errorBox = $('[data-detail-error]');
        errorBox.hidden = true;

        const data = new FormData(detailForm);
        const save = $<HTMLButtonElement>('[data-save]');
        save.disabled = true;
        save.textContent = '저장 중…';

        try {
          await api(`/api/admin/orders/${encodeURIComponent(openOrder.id)}`, {
            method: 'PATCH',
            body: JSON.stringify({
              fulfillment: data.get('fulfillment'),
              carrier: String(data.get('carrier') ?? '').trim() || null,
              trackingNumber: String(data.get('trackingNumber') ?? '').trim() || null,
              adminMemo: String(data.get('adminMemo') ?? '').trim() || null,
            }),
          });
          detail.close();
          await load();
        } catch (error) {
          errorBox.textContent = (error as Error).message;
          errorBox.hidden = false;
        } finally {
          save.disabled = false;
          save.textContent = '저장';
        }
      });

      $('[data-detail-close]').addEventListener('click', () => detail.close());
      $('[data-refresh]').addEventListener('click', () => {
        // 지금 보고 있는 탭을 다시 부릅니다. 늘 주문만 부르면 다른 탭에서
        // 새로고침이 아무 일도 안 하는 것처럼 보입니다.
        if (activeTab === 'inquiries') loadInquiries();
        else if (activeTab === 'reviews') loadReviews();
        else if (activeTab === 'signups') loadSignups();
        else if (activeTab === 'users') loadUsers();
        else load();
      });
      filters.addEventListener('submit', (event) => { event.preventDefault(); page = 0; load(); });
      $('[data-prev]').addEventListener('click', () => { if (page > 0) { page -= 1; load(); } });
      $('[data-next]').addEventListener('click', () => { page += 1; load(); });

      /* ── 문의 ───────────────────────────────────────────────
       *
       * 주문 패널과 DOM 을 공유하지 않습니다. 같은 [data-rows] 를 쓰면 탭을
       * 오갈 때 한쪽 데이터가 다른 쪽 표에 남고, 그 상태는 화면만 봐서는
       * 알아채기 어렵습니다. 상태 변수도 따로 둡니다.
       *
       * 클래스는 그대로 재사용합니다 — .filters·.tableWrap·.pill·.pager 가
       * 이미 이 화면의 언어입니다.
       */
      const inqState = $('[data-inq-state]');
      const inqTableWrap = $('[data-inq-table-wrap]');
      const inqRows = $('[data-inq-rows]');
      const inqPager = $('[data-inq-pager]');
      const inqSummary = $('[data-inq-summary]');
      const inqFilters = $<HTMLFormElement>('[data-inq-filters]');
      const inqDetail = $<HTMLDialogElement>('[data-inq-detail]');
      const inqForm = $<HTMLFormElement>('[data-inq-form]');
      const inqBadge = $('[data-inq-badge]');

      let inqPage = 0;
      let inqTotal = 0;
      let openInquiry: any = null;

      const INQ_STATUS = {
        open: { label: '미답변', tone: 'warn' },
        answered: { label: '답변 완료', tone: 'ok' },
      } as const;

      async function loadInquiries() {
        const status = new FormData(inqFilters).get('status') as string;
        const params = new URLSearchParams({
          limit: String(PAGE_SIZE),
          offset: String(inqPage * PAGE_SIZE),
        });
        if (status) params.set('status', status);

        inqState.textContent = '불러오는 중…';
        inqState.hidden = false;
        inqTableWrap.hidden = true;

        try {
          const data = await api(`/api/admin/inquiries?${params}`);
          inqTotal = data.total ?? 0;

          // 미답변 건수는 탭 배지로도 보여줍니다 — 다른 탭에 있어도
          // 기다리는 사람이 있다는 것을 알아야 합니다.
          const open = data.open ?? 0;
          inqBadge.textContent = open > 0 ? String(open) : '';
          inqBadge.hidden = open === 0;

          const summaryEntries: Array<[string, string]> = [
            ['전체', String(inqTotal)],
            ['미답변', String(open)],
          ];
          inqSummary.replaceChildren(
            ...summaryEntries.map(([label, value], index) => {
              const box = document.createElement('div');
              if (label === '미답변' && open > 0) box.dataset.attention = 'true';
              const dt = document.createElement('dt');
              dt.textContent = label;
              const dd = document.createElement('dd');
              dd.textContent = value;
              box.appendChild(dt);
              box.appendChild(dd);
              return box;
            }),
          );

          const list = data.inquiries ?? [];
          if (list.length === 0) {
            inqState.textContent = inqPage > 0 ? '이 페이지에는 문의가 없습니다.' : '문의가 없습니다.';
            inqPager.hidden = inqPage === 0;
            return;
          }

          inqRows.replaceChildren(
            ...list.map((inq: any) => {
              const tr = document.createElement('tr');
              tr.appendChild(cell(inq.id, 'oid'));
              tr.appendChild(cell(inq.subject));
              tr.appendChild(cell(inq.contactPhone ? phone(inq.contactPhone) : '—'));
              tr.appendChild(cell(when(inq.createdAt), 'when'));
              tr.appendChild(cell('', undefined, pill(INQ_STATUS, inq.status)));

              tr.tabIndex = 0;
              const open = () => showInquiry(inq);
              tr.addEventListener('click', open);
              tr.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                  event.preventDefault();
                  open();
                }
              });
              return tr;
            }),
          );

          inqState.hidden = true;
          inqTableWrap.hidden = false;
          inqPager.hidden = false;
          $('[data-inq-page-info]').textContent =
            `${inqPage * PAGE_SIZE + 1}–${inqPage * PAGE_SIZE + list.length} / ${inqTotal}`;
        } catch (error) {
          inqState.textContent = (error as Error).message;
          inqState.hidden = false;
        }
      }

      function showInquiry(inq: any) {
        openInquiry = inq;
        const set = (sel: string, value: string) => {
          // 문의 본문은 손님이 쓴 문자열입니다. innerHTML 로 넣으면 그대로
          // 실행됩니다 — 이 화면에서 이미 한 번 겪은 실수입니다.
          $(sel).textContent = value;
        };

        set('[data-inq-d-id]', inq.id);
        set('[data-inq-d-subject]', inq.subject);
        set('[data-inq-d-body]', inq.body);
        set('[data-inq-d-phone]', inq.contactPhone ? phone(inq.contactPhone) : '—');
        set('[data-inq-d-order]', inq.orderId ?? '구매 전 질문');
        set('[data-inq-d-when]', when(inq.createdAt));

        const answered = inq.status === 'answered';
        const answeredBox = $('[data-inq-answered]');
        answeredBox.hidden = !answered;
        if (answered) set('[data-inq-d-answer]', inq.answerBody ?? '');

        // 이미 답한 문의는 폼을 닫습니다. 서버도 409 로 막지만, 쓸 수 있게
        // 두었다가 거절하는 것은 답을 두 번 쓰게 만드는 일입니다.
        inqForm.hidden = answered;

        inqForm.reset();
        $('[data-inq-error]').hidden = true;
        inqDetail.showModal();
      }

      inqForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!openInquiry) return;

        const save = $<HTMLButtonElement>('[data-inq-save]');
        const errorBox = $('[data-inq-error]');
        errorBox.hidden = true;
        save.disabled = true;
        const label = save.textContent;
        save.textContent = '보내는 중…';

        try {
          const answer = String(new FormData(inqForm).get('answer') ?? '').trim();
          await api(`/api/admin/inquiries/${encodeURIComponent(openInquiry.id)}`, {
            method: 'PATCH',
            body: JSON.stringify({ answer }),
          });
          inqDetail.close();
          await loadInquiries();
        } catch (error) {
          errorBox.textContent = (error as Error).message;
          errorBox.hidden = false;
        } finally {
          save.disabled = false;
          save.textContent = label;
        }
      });

      $('[data-inq-detail-close]').addEventListener('click', () => inqDetail.close());
      inqFilters.addEventListener('submit', (event) => {
        event.preventDefault();
        inqPage = 0;
        loadInquiries();
      });
      $('[data-inq-prev]').addEventListener('click', () => {
        if (inqPage > 0) { inqPage -= 1; loadInquiries(); }
      });
      $('[data-inq-next]').addEventListener('click', () => { inqPage += 1; loadInquiries(); });

      /* ── 탭 ─────────────────────────────────────────────────
       * 새로고침 버튼이 지금 보고 있는 탭을 다시 불러야 합니다.
       */
      let activeTab: 'orders' | 'inquiries' | 'reviews' | 'signups' | 'users' = 'orders';

      /* ── 후기 ─────────────────────────────────────────────
         DOM 은 전부 createElement + textContent 로 만듭니다. 후기 본문은
         손님이 쓴 문자열이고, 이 화면은 Access 뒤에 있지만 innerHTML 로
         넣으면 그 사람의 <script> 가 관리자 세션에서 실행됩니다. */
      const rvState = $('[data-rv-state]');
      const rvWrap = $('[data-rv-table-wrap]');
      const rvRows = $('[data-rv-rows]');
      const rvPager = $('[data-rv-pager]');
      const rvPageInfo = $('[data-rv-page-info]');
      const rvDetail = document.querySelector<HTMLDialogElement>('[data-rv-detail]')!;
      const rvForm = document.querySelector<HTMLFormElement>('[data-rv-form]')!;
      const rvError = $('[data-rv-error]');
      const RV_PAGE = 20;
      let rvOffset = 0;
      let rvCurrent: any = null;

      const RV_STATUS: Record<string, string> = {
        visible: '보이는 중',
        hidden: '숨김',
        removed: '작성자가 내림',
      };

      async function loadReviews() {
        rvState.hidden = false;
        rvState.textContent = '불러오는 중…';
        rvWrap.hidden = true;
        try {
          const filters = document.querySelector<HTMLFormElement>('[data-rv-filters]')!;
          const status = new FormData(filters).get('status');
          const data = await api(`/api/admin/reviews?limit=${RV_PAGE}&offset=${rvOffset}`);
          // 서버에 상태 필터가 없어 여기서 좁힙니다. 목록이 길어지면
          // 서버로 옮겨야 합니다 — 지금은 후기 수가 적습니다.
          const all = (data.reviews ?? []) as any[];
          const rows = status ? all.filter((r) => r.status === status) : all;

          if (rows.length === 0) {
            rvState.textContent = status ? '해당 상태의 후기가 없습니다.' : '후기가 없습니다.';
            rvPager.hidden = true;
            return;
          }

          rvRows.replaceChildren(
            ...rows.map((review) => {
              const tr = document.createElement('tr');
              tr.tabIndex = 0;
              tr.dataset.rvRow = review.id;

              const cells = [
                review.id,
                '★'.repeat(review.rating),
                // 표에서는 줄여 보여주고 전체는 상세에서 봅니다.
                review.body.length > 40 ? `${review.body.slice(0, 40)}…` : review.body,
                String(review.createdAt).slice(0, 10),
                RV_STATUS[review.status] ?? review.status,
              ];
              for (const value of cells) {
                const td = document.createElement('td');
                td.textContent = value;
                tr.append(td);
              }
              tr.addEventListener('click', () => openReview(review));
              tr.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                  event.preventDefault();
                  openReview(review);
                }
              });
              return tr;
            }),
          );

          rvState.hidden = true;
          rvWrap.hidden = false;
          const total = data.total ?? rows.length;
          rvPageInfo.textContent = `${rvOffset + 1}–${rvOffset + rows.length} / ${total}`;
          rvPager.hidden = false;
        } catch (error) {
          rvState.textContent = error instanceof Error ? error.message : '불러오지 못했습니다.';
          rvPager.hidden = true;
        }
      }

      function openReview(review: any) {
        rvCurrent = review;
        $('[data-rv-d-id]').textContent = review.id;
        $('[data-rv-d-rating]').textContent = `${'★'.repeat(review.rating)} (${review.rating}/5)`;
        $('[data-rv-d-body]').textContent = review.body;
        $('[data-rv-d-author]').textContent = review.authorName ?? '';
        $('[data-rv-d-order]').textContent = review.orderId ?? '';
        $('[data-rv-d-when]').textContent = String(review.createdAt).slice(0, 16).replace('T', ' ');
        $('[data-rv-d-status]').textContent = RV_STATUS[review.status] ?? review.status;

        const reasonRow = $('[data-rv-d-reason-row]');
        $('[data-rv-d-reason]').textContent = review.hiddenReason ?? '';
        reasonRow.hidden = !review.hiddenReason;

        // 작성자가 내린 것은 손댈 수 없습니다 — 폼 자체를 감춥니다.
        const removed = review.status === 'removed';
        $('[data-rv-removed]').hidden = !removed;
        rvForm.hidden = removed;

        rvError.hidden = true;
        rvForm.reset();
        rvDetail.showModal();
      }

      async function setReviewStatus(status: 'visible' | 'hidden') {
        if (!rvCurrent) return;
        const reason = new FormData(rvForm).get('reason');
        rvError.hidden = true;
        try {
          await api(`/api/admin/reviews/${encodeURIComponent(rvCurrent.id)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status, reason: String(reason ?? '') }),
          });
          rvDetail.close();
          await loadReviews();
        } catch (error) {
          rvError.textContent = error instanceof Error ? error.message : '바꾸지 못했습니다.';
          rvError.hidden = false;
        }
      }

      rvForm.addEventListener('submit', (event) => {
        event.preventDefault();
        void setReviewStatus('hidden');
      });
      $('[data-rv-show]').addEventListener('click', () => void setReviewStatus('visible'));
      $('[data-rv-detail-close]').addEventListener('click', () => rvDetail.close());
      document.querySelector('[data-rv-filters]')!.addEventListener('submit', (event) => {
        event.preventDefault();
        rvOffset = 0;
        void loadReviews();
      });
      $('[data-rv-prev]').addEventListener('click', () => {
        rvOffset = Math.max(0, rvOffset - RV_PAGE);
        void loadReviews();
      });
      $('[data-rv-next]').addEventListener('click', () => {
        rvOffset += RV_PAGE;
        void loadReviews();
      });

      /* ── 출시 알림 명단 ─────────────────────────────────────────── */

      const SU_PAGE = 20;
      let suOffset = 0;

      const suState = $('[data-su-state]');
      const suWrap = $('[data-su-table-wrap]');
      const suRows = $('[data-su-rows]');
      const suPager = $('[data-su-pager]');
      const suBadge = $('[data-su-badge]');

      /** 화면 코드 → 사람이 읽는 이름. 모르는 코드는 그대로 보여줍니다. */
      const SU_SOURCE: Record<string, string> = {
        'home-hero': '홈 첫 화면',
        'home-end': '홈 끝',
        product: '제품 페이지',
      };

      async function loadSignups() {
        suState.hidden = false;
        suState.textContent = '불러오는 중…';
        suWrap.hidden = true;
        try {
          const filters = document.querySelector<HTMLFormElement>('[data-su-filters]')!;
          const form = new FormData(filters);
          const query = new URLSearchParams({ limit: String(SU_PAGE), offset: String(suOffset) });
          for (const key of ['source', 'state']) {
            const value = String(form.get(key) ?? '');
            if (value) query.set(key, value);
          }

          const data = await api(`/api/admin/launch-notify?${query}`);
          if (data.who) $('[data-who]').textContent = data.who;

          // 요약: 수신 중 / 전체 / 유입 화면별.
          const summary = $('[data-su-summary]');
          const facts: Array<[string, string]> = [
            ['수신 중', String(data.active ?? 0)],
            ['전체', String(data.total ?? 0)],
            ...((data.bySource ?? []) as Array<{ source: string | null; n: number }>).map(
              (entry) =>
                [SU_SOURCE[entry.source ?? ''] ?? entry.source ?? '알 수 없음', String(entry.n)] as [
                  string,
                  string,
                ],
            ),
          ];
          summary.replaceChildren(
            ...facts.flatMap(([label, value]) => {
              const wrap = document.createElement('div');
              const dt = document.createElement('dt');
              dt.textContent = label;
              const dd = document.createElement('dd');
              dd.textContent = value;
              wrap.append(dt, dd);
              return [wrap];
            }),
          );

          suBadge.textContent = String(data.active ?? 0);
          suBadge.hidden = !data.active;

          const rows = (data.rows ?? []) as any[];
          if (rows.length === 0) {
            /*
             * 필터가 걸려 있으면 "없다" 가 아니라 "이 조건에 없다" 입니다.
             * 예전에는 filtered 건수로 갈랐는데, 조건에 안 맞으면 그 값도 0 이라
             * 늘 "아직 신청자가 없습니다" 만 나왔습니다.
             */
            const filtered = Boolean(form.get('source') || form.get('state'));
            suState.textContent = filtered
              ? '조건에 맞는 신청자가 없습니다.'
              : '아직 신청자가 없습니다.';
            // ⑥ 마지막 쪽이 비면 앞쪽으로 돌아갑니다. 쪽 이동을 감추면
            //    stale offset 에 갇혀서 탭을 다시 열어도 계속 비어 보입니다.
            if (suOffset > 0) {
              suOffset = Math.max(0, suOffset - SU_PAGE);
              void loadSignups();
              return;
            }
            suPager.hidden = true;
            return;
          }

          suRows.replaceChildren(
            ...rows.map((row) => {
              const tr = document.createElement('tr');
              const cells = [
                row.email,
                row.locale,
                SU_SOURCE[row.source ?? ''] ?? row.source ?? '—',
                String(row.createdAt).slice(0, 10),
                row.unsubscribedAt ? '수신 거부' : '수신 중',
              ];
              for (const value of cells) {
                const td = document.createElement('td');
                td.textContent = value;
                tr.append(td);
              }
              return tr;
            }),
          );

          // 쪽 나누기는 "지금 조건에 맞는 수" 를 씁니다. 위 요약의 전체·수신 중과
          // 다른 숫자입니다 — 그래서 서버가 셋을 따로 줍니다.
          const matched = data.matched ?? 0;
          const pages = Math.max(1, Math.ceil(matched / SU_PAGE));
          const page = Math.floor(suOffset / SU_PAGE);
          $('[data-su-page-info]').textContent = `${page + 1} / ${pages} · ${matched}건`;
          $<HTMLButtonElement>('[data-su-prev]').disabled = page === 0;
          $<HTMLButtonElement>('[data-su-next]').disabled = page + 1 >= pages;

          suState.hidden = true;
          suWrap.hidden = false;
          suPager.hidden = false;
        } catch (error) {
          suState.textContent = (error as Error).message;
          suPager.hidden = true;
        }
      }

      document.querySelector<HTMLFormElement>('[data-su-filters]')!.addEventListener(
        'submit',
        (event) => {
          event.preventDefault();
          suOffset = 0;
          void loadSignups();
        },
      );
      $('[data-su-prev]').addEventListener('click', () => {
        suOffset = Math.max(0, suOffset - SU_PAGE);
        void loadSignups();
      });
      $('[data-su-next]').addEventListener('click', () => {
        suOffset += SU_PAGE;
        void loadSignups();
      });

      /* ── 가입 회원 ──────────────────────────────────────────────── */

      const US_PAGE = 20;
      let usOffset = 0;

      const usState = $('[data-us-state]');
      const usWrap = $('[data-us-table-wrap]');
      const usRows = $('[data-us-rows]');
      const usPager = $('[data-us-pager]');

      /** 제공자 코드 → 사람이 읽는 이름. */
      const US_PROVIDER: Record<string, string> = {
        google: '구글',
        kakao: '카카오',
        naver: '네이버',
        mock: '테스트',
      };

      async function loadUsers() {
        usState.hidden = false;
        usState.textContent = '불러오는 중…';
        usWrap.hidden = true;
        try {
          const filters = document.querySelector<HTMLFormElement>('[data-us-filters]')!;
          const q = String(new FormData(filters).get('q') ?? '').trim();
          const query = new URLSearchParams({ limit: String(US_PAGE), offset: String(usOffset) });
          if (q) query.set('q', q);

          const data = await api(`/api/admin/users?${query}`);
          if (data.who) $('[data-who]').textContent = data.who;

          const rows = (data.rows ?? []) as any[];
          if (rows.length === 0) {
            usState.textContent = q ? '찾는 회원이 없습니다.' : '아직 가입한 회원이 없습니다.';
            if (usOffset > 0) {
              usOffset = Math.max(0, usOffset - US_PAGE);
              void loadUsers();
              return;
            }
            usPager.hidden = true;
            return;
          }

          usRows.replaceChildren(
            ...rows.map((row) => {
              const tr = document.createElement('tr');
              const cells = [
                row.email ?? '—',
                row.name ?? '—',
                (row.providers as string[]).map((x) => US_PROVIDER[x] ?? x).join(', ') || '—',
                String(row.orders),
                row.hasAddress ? '있음' : '—',
                String(row.createdAt).slice(0, 10),
              ];
              for (const value of cells) {
                const td = document.createElement('td');
                td.textContent = value;
                tr.append(td);
              }
              return tr;
            }),
          );

          const total = data.total ?? 0;
          const pages = Math.max(1, Math.ceil(total / US_PAGE));
          const page = Math.floor(usOffset / US_PAGE);
          $('[data-us-page-info]').textContent = `${page + 1} / ${pages} · 전체 ${total}명`;
          $<HTMLButtonElement>('[data-us-prev]').disabled = page === 0;
          $<HTMLButtonElement>('[data-us-next]').disabled = page + 1 >= pages;

          usState.hidden = true;
          usWrap.hidden = false;
          usPager.hidden = false;
        } catch (error) {
          usState.textContent = (error as Error).message;
          usPager.hidden = true;
        }
      }

      document.querySelector<HTMLFormElement>('[data-us-filters]')!.addEventListener(
        'submit',
        (event) => {
          event.preventDefault();
          usOffset = 0;
          void loadUsers();
        },
      );
      $('[data-us-prev]').addEventListener('click', () => {
        usOffset = Math.max(0, usOffset - US_PAGE);
        void loadUsers();
      });
      $('[data-us-next]').addEventListener('click', () => {
        usOffset += US_PAGE;
        void loadUsers();
      });

      function showTab(name: 'orders' | 'inquiries' | 'reviews' | 'signups' | 'users') {
        activeTab = name;
        document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.panel !== name;
        });
        document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((tab) => {
          if (tab.dataset.tab === name) tab.setAttribute('aria-current', 'true');
          else tab.removeAttribute('aria-current');
        });
        if (name === 'inquiries') loadInquiries();
        if (name === 'reviews') loadReviews();
        if (name === 'signups') loadSignups();
        if (name === 'users') loadUsers();
      }

      document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((tab) => {
        tab.addEventListener('click', () =>
          showTab(tab.dataset.tab as 'orders' | 'inquiries' | 'reviews' | 'signups' | 'users'),
        );
      });

      /*
       * 명단 수도 어느 탭에 있든 보여야 합니다. loadSignups 안에서만 채우면
       * 이미 그 탭에 간 사람에게만 보이고, 배지가 하려던 일을 못 합니다.
       */
      api('/api/admin/launch-notify?limit=1')
        .then((data) => {
          const active = data.active ?? 0;
          suBadge.textContent = active > 0 ? String(active) : '';
          suBadge.hidden = active === 0;
        })
        .catch(() => {
          /* 인증이 막혔거나 DB 가 없는 경우입니다. 배지만 안 뜹니다. */
        });

      // 미답변 건수는 어느 탭에 있든 알아야 하므로 처음에 한 번 물어봅니다.
      api('/api/admin/inquiries?status=open&limit=1')
        .then((data) => {
          const open = data.open ?? 0;
          inqBadge.textContent = open > 0 ? String(open) : '';
          inqBadge.hidden = open === 0;
        })
        .catch(() => {
          /* 문의 기능이 꺼져 있거나 인증이 막힌 경우입니다. 배지만 안 뜹니다. */
        });

      load();

    </script>
