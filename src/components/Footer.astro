---
import { dict, localePath } from '../i18n';
import { MENU_DESTINATIONS } from '../config/nav-gates';
import { BUSINESS, SOCIAL, LOCALES, LOCALE_LABELS, LOCALE_TAGS, type Locale } from '../config/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale);

/** 값이 아직 없는 사업자 정보는 빈 줄을 남기지 않고 통째로 생략합니다. */
const businessRows = [
  { label: t.footer.business.legalName, value: BUSINESS.legalName },
  { label: t.footer.business.representative, value: BUSINESS.representative },
  { label: t.footer.business.address, value: BUSINESS.address },
  { label: t.footer.business.registrationNumber, value: BUSINESS.registrationNumber },
  { label: t.footer.business.mailOrderNumber, value: BUSINESS.mailOrderNumber },
].filter((row) => row.value);
---

<footer class="footer">
  <div class="wrap">
    {/* Nav 와 같은 이유로 글자입니다 — 거기 주석을 보세요. */}
    <p class="footer__wordmark">{BUSINESS.brandName}</p>
    <p class="footer__tagline">{t.footer.tagline}</p>

    <div class="footer__cols">
      {/*
        목적지 목록을 여기서 적지 않습니다 — `src/config/nav.ts` 하나가 정의하고
        헤더·시트·푸터 셋이 그것을 읽습니다. 예전에는 세 곳이 각자 적어 두어,
        홈 링크가 헤더만 `/{lang}/#story` 이고 나머지는 `/{lang}/` 였습니다.

        평면 목록이라 `flatLabel` 을 먼저 씁니다. 드롭다운 안에서는 부모가
        문맥을 주지만("고객센터 > 자주 묻는 질문") 푸터에는 부모가 없어서,
        그 주소의 `<title>`·`<h1>` 과 같은 말을 보여야 합니다.
      */}
      <div class="footer__col">
        <h2>{t.nav.menu}</h2>
        <ul data-footer-menu>
          {MENU_DESTINATIONS.map((item) => (
            <li>
              <a href={localePath(locale, item.path)}>{(item.flatLabel ?? item.label)(t)}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h2>{t.footer.legal.heading}</h2>
        <ul>
          <li><a href={localePath(locale, 'legal/terms')}>{t.footer.legal.terms}</a></li>
          <li><a href={localePath(locale, 'legal/privacy')}>{t.footer.legal.privacy}</a></li>
          <li><a href={localePath(locale, 'legal/shipping')}>{t.footer.legal.shipping}</a></li>
        </ul>
      </div>

      {/*
        계정이 아직 없으면 통째로 생략합니다 — 사업자 정보와 같은 규칙입니다.
        빈 피드로 보내는 링크는 없는 것보다 나쁩니다.
      */}
      {
        SOCIAL.instagramUrl && (
          <div class="footer__col">
            <h2>{t.footer.social.heading}</h2>
            <ul>
              <li>
                <a href={SOCIAL.instagramUrl} rel="me noopener" target="_blank">
                  Instagram <span class="footer__handle">{SOCIAL.instagramHandle}</span>
                </a>
              </li>
            </ul>
          </div>
        )
      }

      <div class="footer__col">
        <h2>{t.footer.language}</h2>
        <ul>
          {
            LOCALES.map((l) => (
              <li>
                <a
                  href={localePath(l)}
                  hreflang={LOCALE_TAGS[l]}
                  lang={LOCALE_TAGS[l]}
                  aria-current={l === locale ? 'true' : undefined}
                >
                  {LOCALE_LABELS[l]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/*
      사업자 정보를 접습니다.

      여섯 줄이 세로로 쌓이면 모바일에서 꼬리가 깁니다. 국내 이커머스가 흔히
      쓰는 방식이고, 법적으로는 **접근할 수 있으면** 됩니다 — `<details>` 는
      검색엔진도 스크린리더도 안을 읽습니다.

      저작권 표시는 밖에 둡니다. 접힘 안에 넣으면 화면에 아무것도 남지 않는
      순간이 생깁니다.
    */}
    <details class="footer__business">
      <summary>{t.footer.business.summary}</summary>
      <div class="footer__meta">
        {
          businessRows.map((row) => (
            <div>
              {row.label} {row.value}
            </div>
          ))
        }
        {
          BUSINESS.phone && (
            <div>
              {t.footer.business.phone}{' '}
              {/* 휴대폰에서 바로 걸 수 있어야 합니다. 숫자를 그냥 적어 두면
                  손님이 손으로 옮겨 적습니다. */}
              <a href={`tel:${BUSINESS.phone.replace(/[^0-9+]/g, '')}`}>{BUSINESS.phone}</a>
            </div>
          )
        }
        {
          BUSINESS.email && (
            <div>
              {t.footer.business.email}{' '}
              <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
            </div>
          )
        }
      </div>
    </details>

    <p class="footer__copyright">{t.footer.copyright}</p>
  </div>
</footer>
