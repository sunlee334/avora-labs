---
/**
 * 상단 공지 배너.
 *
 * ── 왜 지금 만드는가 ────────────────────────────────────────
 * 와디즈 오픈예정 페이지는 2026년 12월~2027년 1월에 열립니다. 그때가 되면
 * 배포 없이 URL 한 줄로 켤 수 있어야 합니다 — 그 시점에 개발자가 붙어 있을
 * 거라는 보장이 없습니다.
 *
 * ── 왜 이것이 중요한가 ──────────────────────────────────────
 * 기획안 13-1 은 "자사몰 알림 800명 → 펀딩 300개" 로 잡았는데 중간 단계가
 * 빠져 있습니다. **자사몰 명단은 와디즈 노출 알고리즘에 잡히지 않습니다.**
 * 와디즈 오픈예정 알림신청자가 200명을 넘으면 성공률이 크게 오른다는 것이
 * 플랫폼 쪽 분석이고, 그 200명을 여기서 보내야 합니다.
 *
 * "출시 알림 받기" 와는 **다른 행동** 입니다. 문구를 따로 두는 이유입니다.
 *
 * 켜는 법: `src/config/commerce.json` 의 notice.enabled 를 true 로 두고
 * url 을 채웁니다. 둘 중 하나라도 비면 아무것도 그리지 않습니다.
 */
import { dict } from '../i18n';
import type { Locale } from '../config/site';
import commerce from '../config/commerce.json';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const n = dict(locale).home.notice;

/*
 * 조건을 둘 다 봅니다. enabled 만 보면 URL 없이 켜졌을 때 아무 데도 가지
 * 않는 배너가 뜨고, url 만 보면 준비만 해 두고 아직 켜지 않으려는 상태를
 * 표현할 수 없습니다.
 */
const show = commerce.notice.enabled && commerce.notice.url !== '';
---

{
  show && (
    <a class="notice" href={commerce.notice.url} rel="noopener">
      <span class="notice__label">{n.label}</span>
      <span class="notice__body">{n.body}</span>
    </a>
  )
}
