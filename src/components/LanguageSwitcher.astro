---
/**
 * 언어 전환. 모바일에서는 바텀시트, 데스크톱에서는 우측 상단 패널로 열립니다.
 * 요구사항 7번의 "드롭다운 대신 바텀시트" 지침을 따릅니다.
 *
 * <dialog> 를 쓰는 이유:
 *   이 스위처는 .nav 안에 있는데, .nav 에는 backdrop-filter 가 걸려 있습니다.
 *   backdrop-filter 는 position: fixed 자손의 컨테이닝 블록을 만들기 때문에,
 *   일반 div 로 만들면 시트가 뷰포트가 아니라 nav 기준으로 배치돼 화면 위쪽에 튀어나옵니다.
 *   <dialog showModal()> 은 top layer 에 렌더되어 이 문제를 겪지 않고,
 *   백드롭·ESC 닫기·포커스 가둠을 브라우저가 대신 해 줍니다.
 *
 * JS 가 없으면 이 시트는 열리지 않습니다. 그 경우를 위해 푸터에 5개 언어 링크를
 * 항상 평문으로 두었습니다 — 언어 전환 자체는 JS 없이도 가능합니다.
 */
import { LOCALES, LOCALE_LABELS, LOCALE_TAGS, type Locale } from '../config/site';
import { dict, localePath } from '../i18n';

interface Props {
  locale: Locale;
  /**
   * 이 경로가 **실제로 존재하는** 언어와 그 주소. `Base.astro` 가 hreflang 을
   * 만들 때 쓴 것과 **같은 배열**을 그대로 받습니다.
   *
   * ── 왜 `LOCALES` 를 직접 돌면 안 되는가 ────────────────────
   * 글은 한국어·영어 두 벌뿐인데 5개 언어를 무조건 돌고 있었습니다. 그래서
   * 글 페이지의 전환기가 `/zh/support/posts/…` 처럼 **빌드되지 않은 주소**
   * 세 개를 가리켰고, 언어를 바꾼 사람이 404 를 봤습니다.
   *
   * hreflang 쪽은 이미 맞았습니다 — `[slug].astro` 가 `locales` 를 넘겨
   * 좁혀 두었으니까요. 틀린 것은 화면의 링크뿐이었습니다. 계산된 결과를
   * 통째로 받으면 그 둘이 **갈라질 자리가 없어집니다.**
   */
  langs: readonly { locale: Locale; path: string }[];
}
const { locale, langs } = Astro.props;
const t = dict(locale);

/*
 * ── 그런데 좁히기만 하면 이번엔 나갈 길이 없어집니다 ────────
 * 한 언어로만 쓴 글에서는 `langs` 가 **한 줄** 입니다. 그러면 이 버튼은
 * 지금 보고 있는 언어 하나만 담은 시트를 열고, 그 항목에는
 * `aria-current="true"` 가 붙습니다 — 누를 수는 있는데 아무 데도 가지
 * 않는 컨트롤입니다. 404 는 면했지만 이번엔 가둡니다.
 *
 * 그래서 **보여 주는 것은 언제나 다섯 언어** 이고, 이 글이 없는 언어는 그
 * 언어의 첫 화면으로 보냅니다. 푸터의 언어 목록이 이미 그렇게 동작하고
 * 있어서, 사용자가 배울 규칙이 늘지 않습니다.
 *
 * ⚠️ hreflang 은 **좁은 채로** 둡니다. 그건 "이 페이지의 다른 언어판" 을
 * 말하는 자리라, 없는 번역을 있다고 하면 안 됩니다. 화면의 링크와 기계에게
 * 하는 말은 여기서 갈라지는 것이 맞습니다.
 */
const destinations = LOCALES.map((l) => {
  const here = langs.find((entry) => entry.locale === l);
  return { locale: l, path: here?.path ?? localePath(l), translated: here !== undefined };
});
---

<div class="lang">
  <button
    class="lang__toggle"
    type="button"
    aria-haspopup="dialog"
    aria-label={t.a11y.selectLanguage}
    data-lang-open
  >
    <span aria-hidden="true">{locale.toUpperCase()}</span>
  </button>

  <dialog class="lang__sheet" aria-label={t.nav.language} data-lang-sheet>
    <div class="lang__head">
      <p class="lang__title">{t.nav.language}</p>
      <button class="lang__close" type="button" aria-label={t.nav.close} data-lang-close>
        <span aria-hidden="true">✕</span>
      </button>
    </div>
    <ul class="lang__list">
      {
        destinations.map(({ locale: l, path: href, translated }) => (
          <li>
            <a
              class="lang__item"
              href={href}
              hreflang={LOCALE_TAGS[l]}
              lang={LOCALE_TAGS[l]}
              aria-current={l === locale ? 'true' : undefined}
              data-translated={translated ? undefined : 'false'}
            >
              {LOCALE_LABELS[l]}
              <span aria-hidden="true">{l.toUpperCase()}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.lang').forEach((root) => {
    const open = root.querySelector<HTMLButtonElement>('[data-lang-open]');
    const close = root.querySelector<HTMLButtonElement>('[data-lang-close]');
    const sheet = root.querySelector<HTMLDialogElement>('[data-lang-sheet]');
    if (!open || !sheet || typeof sheet.showModal !== 'function') return;

    open.addEventListener('click', () => sheet.showModal());
    close?.addEventListener('click', () => sheet.close());

    // 백드롭(시트 바깥)을 누르면 닫습니다. dialog 자체가 백드롭 클릭도 받으므로
    // 클릭 지점이 시트 영역 밖인지 좌표로 판별합니다.
    sheet.addEventListener('click', (event) => {
      /*
       * 좌표를 보기 전에 **발신자를 먼저 가릅니다.**
       *
       * Space·Enter 로 활성화한 클릭은 `clientX = clientY = 0` 인 합성
       * 이벤트입니다. 바텀시트는 화면 아래에 붙어 `box.top` 이 항상 0보다
       * 크므로, 좌표만 보면 **키보드 입력이 전부 "바깥을 눌렀다"** 가 됩니다.
       * `<dialog>` 는 백드롭을 눌렀을 때만 자기 자신이 target 이라, 이 한
       * 줄이 키보드와 백드롭을 정확히 가릅니다.
       */
      if (event.target !== sheet) return;
      const box = sheet.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) sheet.close();
    });

    // 닫힌 뒤 포커스를 열었던 버튼으로 돌려줍니다.
    sheet.addEventListener('close', () => open.focus());
  });
</script>
