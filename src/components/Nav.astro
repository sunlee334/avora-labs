---
import LanguageSwitcher from './LanguageSwitcher.astro';
import MenuSheet from './MenuSheet.astro';
import { dict, localePath } from '../i18n';
import { TOP_VISIBLE, UTILITY_VISIBLE } from '../config/nav-gates';
import { BUSINESS, type Locale } from '../config/site';

interface Props {
  locale: Locale;
  path?: string;
  /** 언어 전환기로 그대로 넘깁니다 — 뜻은 `LanguageSwitcher.astro` 에 있습니다. */
  langs: readonly { locale: Locale; path: string }[];
}
const { locale, path = '', langs } = Astro.props;
const t = dict(locale);

// 장바구니는 배지가 붙는 거래 단축키라 유틸리티 줄이 아니라 .nav__right 에
// 남습니다. 나머지(주문조회·마이페이지)가 유틸리티 줄을 이룹니다.
const cartItem = UTILITY_VISIBLE.find((item) => item.badge === 'cart') ?? null;
const utility = UTILITY_VISIBLE.filter((item) => item.badge !== 'cart');
---

<nav class="nav" aria-label={t.nav.menu}>
  {/*
    워드마크를 이미지가 아니라 글자로 짭니다.

    브랜드가 PAROS 로 바뀌었는데 기존 워드마크 SVG 는 "AVORA" 글자
    자체입니다. 그 서체는 저장소에 없어(Noto Serif 가 아닙니다 — 글리프
    패스가 전혀 다릅니다) 같은 모양의 PAROS 를 만들 수 없습니다.

    지어낸 로고를 얹느니 사이트의 디스플레이 서체로 글자를 짭니다.
    임시입니다 — 제대로 그린 워드마크가 나오면 <img> 로 되돌립니다.
    AVORA LABS 워드마크 파일은 회사 마크로 그대로 남겨 두었습니다.
  */}
  {/*
    보증 표기 — 브랜드가 주인공이고 회사는 서명처럼 따라붙습니다.

    회사가 브랜드보다 커 보이면 안 됩니다. `BY AVORA LABS` 는 PAROS 의
    59%(17px → 10px)이고 색도 본문색이 아니라 보조색입니다.

    회사명이라 다섯 언어 모두 영문 그대로 둡니다. 홈의 `WHO WE ARE` 같은
    구역 라벨이 이미 전 언어 영문이라 조판도 어긋나지 않습니다.

    두 줄이지만 합쳐 33px 남짓이라 44px 탭 영역 안에 들어갑니다 —
    모바일 헤더 높이(68px)는 그대로입니다.
  */}
  <a class="nav__wordmark" href={localePath(locale)}>
    <span class="nav__wordmarkBrand">{BUSINESS.brandName}</span>
    <span class="nav__wordmarkBy">by {BUSINESS.companyName}</span>
  </a>

  {/*
    항목은 `src/config/nav.ts` 하나가 정합니다. 하위가 하나뿐인 그룹은
    resolveTop() 이 이미 링크로 접어 두었으므로, 여기서 개수를 다시 세거나
    화살표를 조건부로 그리지 않습니다 — 화살표 마크업은 kind:'group' 가지
    안에만 존재할 수 있습니다.

    패널은 right: 0 정박이고, 기준은 `.nav__group` 의 position: relative 입니다
    — 트리거 묶음의 오른쪽 끝에 붙습니다. 목록 정렬과는 무관합니다.
  */}
  <ul class="nav__links">
    {
      TOP_VISIBLE.map((top) =>
        top.kind === 'link' ? (
          <li>
            <a href={localePath(locale, top.path)}
               aria-current={top.match === path ? 'page' : undefined}>
              {top.label(t)}
            </a>
          </li>
        ) : (
          <li class="nav__group">
            {/*
              제목은 **링크**, 화살표는 **버튼** 입니다.

              전에는 제목이 통째로 `<button>` 이었습니다. 그러면 크롤러가
              고객센터로 가는 길을 못 찾고, 가운데 클릭·새 탭 열기도 안 됩니다.
              메뉴를 열지 않고 바로 가고 싶은 사람도 갈 방법이 없었습니다.

              그래서 둘로 나눕니다 — 글자를 누르면 그 화면으로 가고, 화살표를
              누르면 하위 목록이 열립니다. 자바스크립트가 없어도 링크는 그대로
              동작하고, 화살표만 아무 일도 하지 않습니다.
            */}
            <a
              class="nav__group-link"
              href={localePath(locale, top.path)}
              aria-current={top.match === path ? 'page' : undefined}
            >
              {top.label(t)}
            </a>
            <button
              type="button"
              class="nav__caret-btn"
              aria-expanded="false"
              aria-controls={`nav-${top.id}`}
              aria-label={t.a11y.openSubmenu.replace('{name}', top.label(t))}
              data-nav-drop
            >
              <span class="nav__caret" aria-hidden="true"></span>
            </button>
            <ul class="nav__dropdown" id={`nav-${top.id}`} hidden>
              {top.children.map((leaf) => (
                <li>
                  <a
                    href={localePath(locale, leaf.path)}
                    aria-current={(leaf.match ?? leaf.path) === path ? 'page' : undefined}
                  >
                    {leaf.label(t)}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ),
      )
    }
  </ul>

  <div class="nav__right">
    {/*
      자사 결제가 꺼져 있을 때는 장바구니 링크를 아예 내보내지 않습니다.
      담을 수 없는 장바구니로 가는 링크를 헤더에 두면 막다른 길이 됩니다.
    */}
    {
      cartItem && (
        <a
          class="nav__cart"
          href={localePath(locale, cartItem.path)}
          data-nav-cart
          data-count-template={t.cart.itemCount}
        >
          <span>{t.nav.cart}</span>
          {/*
            숫자 배지는 눈으로 보는 것이고, 그 옆의 sr-only 가 읽히는 것입니다.
            배지를 그대로 읽히게 두면 "장바구니 3" 이 되어 3 이 무엇의 3인지
            말하지 않습니다. `cart.itemCount`("{count}개")를 채워 넣어
            "장바구니 3개" 로 읽히게 합니다 — 문구는 언어마다 다릅니다.
          */}
          <span class="nav__cart-count" data-nav-cart-count aria-hidden="true">0</span>
          <span class="sr-only" data-nav-cart-sr></span>
        </a>
      )
    }
    {/*
      마이페이지는 **데스크톱에서만** 헤더에 나옵니다(`.nav__account`).
      360px 에서는 워드마크와 여백을 빼면 200px 밖에 남지 않아 장바구니·언어·
      메뉴와 함께 넷이 들어가지 않기 때문입니다. 좁은 화면에서는 메뉴 시트가
      같은 링크를 담습니다.

      한때 이 링크를 시트로 옮기면서 **데스크톱에서 완전히 사라졌습니다** —
      그 폭에서는 시트 자체가 숨겨지기 때문입니다. 로그인할 방법이 없는
      사이트가 되었고, 그래서 이 자리를 다시 만들었습니다.
    */}
    {/*
      유틸리티 — "둘러보는 길" 과 "내 것을 확인하는 길" 을 가릅니다.
      훅은 data-nav-{id} 로 일반화합니다. 리터럴 비교를 두면 축 2(컴포넌트에
      목적지 리터럴 0개)가 그 비교에 걸립니다.

      두 번째 <nav> 를 만들지 않습니다 — 같은 <nav> 안의 별도 행입니다.
      랜드마크가 늘면 스크린리더 사용자가 모든 페이지에서 지나쳐야 할
      정거장이 늘고, mobile-ux.spec.ts:132 가 개수 1 을 지킵니다.
    */}
    {
      utility.length > 0 && (
        <ul class="nav__utility">
          {utility.map((item) => (
            <li>
              <a
                class={`nav__${item.id}`}
                href={localePath(locale, item.path)}
                aria-current={(item.match ?? item.path) === path ? 'page' : undefined}
                {...{ [`data-nav-${item.id}`]: true }}
              >
                {item.label(t)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <LanguageSwitcher locale={locale} langs={langs} />
    <MenuSheet locale={locale} path={path} />
  </div>
</nav>

<script>
  /*
   * 드롭다운 — 클릭·키보드로 열고, 마우스가 있는 기기에서는 올려도 열립니다.
   *
   * hover 는 **보조** 입니다. 클릭과 키보드만으로 모든 동작이 가능해야 하고,
   * hover 는 그 위에 얹힙니다 — 없어도 아무것도 잃지 않습니다.
   *
   * 두 가지를 조심합니다.
   *
   * (1) `(hover: hover)` 하나만 보면 **터치 되는 윈도우 노트북에서 참** 입니다.
   *     그 기기에서 hover 는 손가락이 아니라 우연히 스치는 것이 되고, 메뉴가
   *     의도 없이 열립니다. `(pointer: fine)` 을 함께 봐야 걸러집니다.
   *
   * (2) 이벤트를 버튼에 걸면 패널로 마우스를 옮기는 순간 버튼을 벗어나
   *     닫힙니다. 패널이 <li> **안**에 있으므로 <li> 에 겁니다.
   *
   * <dialog> 를 쓰지 않는 이유: showModal() 은 top layer 라 뷰포트 기준
   * 배치가 되고 헤더 나머지를 inert 로 만듭니다. 여기 패널은 트리거에
   * 붙어야 하고 헤더를 죽이면 안 됩니다.
   */
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-nav-drop]');

  function closeAll(): void {
    for (const trigger of triggers) {
      const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    }
  }

  /*
   * 마우스가 있는 기기에서만. matchMedia 는 실시간이라 외장 마우스를 꽂았다
   * 뺐다 해도 그때그때 맞는 답을 냅니다.
   */
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  for (const trigger of triggers) {
    const group = trigger.closest('li');
    const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
    if (!group || !panel) continue;

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
    };

    group.addEventListener('mouseenter', () => {
      if (!finePointer.matches) return;
      closeAll();
      setOpen(true);
    });

    group.addEventListener('mouseleave', () => {
      if (!finePointer.matches) return;
      /*
       * 키보드로 연 것을 마우스가 스쳐 지나가며 닫지 않게 둡니다.
       *
       * activeElement 를 보면 안 됩니다 — **클릭도 버튼에 포커스를 줍니다.**
       * 그래서 올려서 열고 누른 뒤 마우스를 치우면 메뉴가 열린 채 남습니다.
       * :focus-visible 은 키보드로 옮긴 포커스에만 붙고 마우스 클릭에는
       * 붙지 않아, 원래 막으려던 경우만 정확히 걸러냅니다.
       */
      if (group.querySelector(':focus-visible')) return;
      setOpen(false);
    });
  }

  for (const trigger of triggers) {
    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const panel = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
      if (!panel) return;

      /*
       * 마우스로 누를 때는 **닫지 않습니다.**
       *
       * 마우스가 트리거에 닿는 순간 mouseenter 가 이미 열었으므로, 클릭이
       * 토글이면 "올려서 열린 것을 누르면 닫히는" 상태가 됩니다. 올려서
       * 보이길래 누른 사람에게는 메뉴가 사라진 것으로 보입니다.
       *
       * 키보드로 활성화한 click 은 `detail === 0` 입니다(포인터 클릭은 1 이상).
       * 그쪽은 Enter 로 열고 Enter 로 닫는 토글이 맞습니다.
       *
       * 마우스에서 닫는 길은 벗어나기·Esc·바깥 클릭 셋입니다.
       */
      const byPointer = event.detail > 0 && finePointer.matches;
      const willOpen = byPointer ? true : panel.hidden;

      closeAll();
      panel.hidden = !willOpen;
      trigger.setAttribute('aria-expanded', String(willOpen));
    });
  }

  if (triggers.length > 0) {
    document.addEventListener('click', closeAll);
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      // 열려 있던 트리거로 포커스를 돌려줍니다 — 없으면 키보드 사용자가
      // 닫을 때마다 자리를 잃습니다.
      const open = [...triggers].find((t) => t.getAttribute('aria-expanded') === 'true');
      closeAll();
      open?.focus();
    });
  }

  import { subscribe, itemCount } from '../lib/cart';

  const link = document.querySelector<HTMLElement>('[data-nav-cart]');
  const badge = document.querySelector<HTMLElement>('[data-nav-cart-count]');
  const sr = document.querySelector<HTMLElement>('[data-nav-cart-sr]');
  // 사전 문구는 서버가 data-* 로 내려줍니다 — 이 스크립트는 5개 언어를
  // 알지 못합니다. 리뷰 페이지·문의 섹션이 쓰는 것과 같은 방식입니다.
  const template = link?.dataset.countTemplate ?? '';

  if (badge) {
    subscribe((lines) => {
      const n = itemCount(lines);
      badge.textContent = String(n);
      badge.dataset.hasItems = String(n > 0);
      // 비었을 때는 아무 말도 하지 않습니다 — 링크 이름이 이미 "장바구니" 입니다.
      if (sr) sr.textContent = n > 0 ? template.replace('{count}', String(n)) : '';
    });
  }
</script>
