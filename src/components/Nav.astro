---
import LanguageSwitcher from './LanguageSwitcher.astro';
import MenuSheet from './MenuSheet.astro';
import { dict, localePath } from '../i18n';
import { SELLS_DIRECTLY, ACCOUNTS_ENABLED } from '../config/runtime';
import type { Locale } from '../config/site';

interface Props {
  locale: Locale;
  path?: string;
}
const { locale, path = '' } = Astro.props;
const t = dict(locale);
---

<nav class="nav" aria-label={t.nav.menu}>
  <a class="nav__wordmark" href={localePath(locale)} aria-label="AVORA">
    {/* 팔레트 A 확정에 따라 보유 자산을 그대로 씁니다 — 리컬러 불필요 */}
    <img src="/brand/avora-wordmark-forest.svg" alt="AVORA" width="120" height="21" />
  </a>

  <div class="nav__links">
    <a href={`${localePath(locale)}#story`}>{t.nav.story}</a>
    <a href={localePath(locale, 'product')}>{t.nav.product}</a>
    <a href={localePath(locale, 'support')}>{t.nav.support}</a>
  </div>

  <div class="nav__right">
    {/*
      자사 결제가 꺼져 있을 때는 장바구니 링크를 아예 내보내지 않습니다.
      담을 수 없는 장바구니로 가는 링크를 헤더에 두면 막다른 길이 됩니다.
    */}
    {
      SELLS_DIRECTLY && (
        <a
          class="nav__cart"
          href={localePath(locale, 'cart')}
          data-nav-cart
          data-count-template={t.cart.itemCount}
        >
          <span>{t.nav.cart}</span>
          {/*
            숫자 배지는 눈으로 보는 것이고, 그 옆의 sr-only 가 읽히는 것입니다.
            배지를 그대로 읽히게 두면 "장바구니 3" 이 되어 3 이 무엇의 3인지
            말하지 않습니다. `cart.itemCount`("{count}개")를 채워 넣어
            "장바구니 3개" 로 읽히게 합니다 — 문구는 언어마다 다릅니다.
          */}
          <span class="nav__cart-count" data-nav-cart-count aria-hidden="true">0</span>
          <span class="sr-only" data-nav-cart-sr></span>
        </a>
      )
    }
    {/*
      마이페이지는 **데스크톱에서만** 헤더에 나옵니다(`.nav__account`).
      360px 에서는 워드마크와 여백을 빼면 200px 밖에 남지 않아 장바구니·언어·
      메뉴와 함께 넷이 들어가지 않기 때문입니다. 좁은 화면에서는 메뉴 시트가
      같은 링크를 담습니다.

      한때 이 링크를 시트로 옮기면서 **데스크톱에서 완전히 사라졌습니다** —
      그 폭에서는 시트 자체가 숨겨지기 때문입니다. 로그인할 방법이 없는
      사이트가 되었고, 그래서 이 자리를 다시 만들었습니다.
    */}
    {
      ACCOUNTS_ENABLED && (
        <a class="nav__account" href={localePath(locale, 'account')} data-nav-account>
          {t.nav.account}
        </a>
      )
    }
    <LanguageSwitcher locale={locale} path={path} />
    <MenuSheet locale={locale} path={path} />
  </div>
</nav>

<script>
  import { subscribe, itemCount } from '../lib/cart';

  const link = document.querySelector<HTMLElement>('[data-nav-cart]');
  const badge = document.querySelector<HTMLElement>('[data-nav-cart-count]');
  const sr = document.querySelector<HTMLElement>('[data-nav-cart-sr]');
  // 사전 문구는 서버가 data-* 로 내려줍니다 — 이 스크립트는 5개 언어를
  // 알지 못합니다. 리뷰 페이지·문의 섹션이 쓰는 것과 같은 방식입니다.
  const template = link?.dataset.countTemplate ?? '';

  if (badge) {
    subscribe((lines) => {
      const n = itemCount(lines);
      badge.textContent = String(n);
      badge.dataset.hasItems = String(n > 0);
      // 비었을 때는 아무 말도 하지 않습니다 — 링크 이름이 이미 "장바구니" 입니다.
      if (sr) sr.textContent = n > 0 ? template.replace('{count}', String(n)) : '';
    });
  }
</script>
